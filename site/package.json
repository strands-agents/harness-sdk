{
  "name": "docs",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:all": "npm run sdk:generate && npm run build",
    "dev": "astro dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:snippets": "npm run typecheck --prefix test-snippets",
    "format": "prettier --write docs 'src/content/docs/**/*.ts'",
    "format:check": "prettier --check docs 'src/content/docs/**/*.ts'",
    "clean": "rm -rf .build && rm -rf .astro",
    "preview": "astro preview",
    "cms:build": "npm run build:all",
    "sdk:generate:py": "command -v uv >/dev/null 2>&1 && uv run scripts/api-generation-python.py || (pip install pydoc-markdown>=4.8.2 && python scripts/api-generation-python.py)",
    "sdk:generate:ts": "tsx scripts/api-generation-typescript.ts",
    "sdk:generate": "npm run sdk:generate:py && npm run sdk:generate:ts",
    "sdk:sync": "npm run sdk:generate && npm install",
    "routes:update": "tsx scripts/update-known-routes.ts",
    "changelog:sync": "tsx scripts/changelog/sync.ts",
    "catalog:stats": "tsx scripts/catalog/refresh-stats.ts",
    "astro": "astro"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@a2a-js/sdk": "^0.3.10",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/rss": "^4.0.19",
    "@aws-sdk/client-s3": "^3.943.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@strands-agents/sdk": "file:../strands-ts",
    "@types/express": "^5.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.6",
    "astro-og-canvas": "^0.13.0",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "markdown-it": "^15.0.1",
    "mdast-util-to-string": "^4.0.0",
    "node-fetch": "^3.3.2",
    "node-html-parser": "^9.0.2",
    "p-limit": "^7.3.2",
    "prettier": "^3.9.6",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.17.7",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/markdown-satteri": "^0.3.4",
    "@astrojs/starlight": "^0.41.9",
    "@octokit/rest": "^22.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "acorn": "^8.18.0",
    "astro": "^7.2.10",
    "js-yaml": "^4.3.1",
    "jsdom": "^30.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "satteri": "^0.10.5",
    "sitemapper": "^4.1.4",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "zod": "4.3.6"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "src/content/docs/**/*.ts",
        "options": {
          "printWidth": 90
        }
      }
    ]
  }
}
