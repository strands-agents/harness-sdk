---
/**
 * Blog Post Layout
 *
 * Wraps BlogLayout with article-specific chrome: author byline,
 * date, reading time, tags, JSON-LD structured data, and OG image.
 */
import BlogLayout from './BlogLayout.astro'
import type { HeadEntry } from './BlogLayout.astro'
import type { BlogPost, Author } from '../util/blog'
import { formatDate } from '../util/blog'
import { pathWithBase } from '../util/links'

interface Props {
  post: BlogPost
  authors: Author[]
  readingTime?: string
}

const { post, authors, readingTime } = Astro.props
const { title, date, description, tags, coverImage, canonicalUrl } = post.data

const ogImageUrl = new URL(pathWithBase(`/blog/og/${post.id}.png`), Astro.site).href
const pageUrl = new URL(Astro.url.pathname, Astro.site).href

// JSON-LD BlogPosting structured data. No dateModified: the blog schema has no
// updated-date field, and repeating datePublished would fake freshness signals.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: ogImageUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl || pageUrl,
  },
  datePublished: date.toISOString(),
  author: authors.map((a) => ({
    '@type': 'Person',
    name: a.data.name,
  })),
  publisher: {
    '@type': 'Organization',
    name: 'Strands Agents',
    url: 'https://strandsagents.com',
  },
}

const extraHead: HeadEntry[] = [
  // Starlight renders head-entry content with set:html (no escaping), so a
  // `</script>` inside any post field would break out of the JSON-LD tag.
  { tag: 'script', attrs: { type: 'application/ld+json' }, content: JSON.stringify(jsonLd).replace(/</g, '\\u003c') },
  { tag: 'meta', attrs: { property: 'article:published_time', content: date.toISOString() } },
  ...authors.map(
    (author): HeadEntry => ({
      tag: 'meta',
      attrs: { property: 'article:author', content: author.data.name },
    })
  ),
]
---

<BlogLayout
  title={title}
  description={description}
  ogImage={ogImageUrl}
  canonicalUrl={canonicalUrl}
  extraHead={extraHead}
>

  <div class="blog-wrapper">
    <article class="blog-post">
      <header class="blog-post-header">
        <a href={pathWithBase('/blog/')} class="blog-back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          All posts
        </a>
        <div class="blog-post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {readingTime && <span class="reading-time">{readingTime}</span>}
        </div>
        <h1>{title}</h1>
        <p class="blog-post-description">{description}</p>
        <div class="blog-post-authors">
          {authors.map((author, i) => (
            <Fragment>
              {i > 0 && <span class="author-sep">,{' '}</span>}
              <a href={pathWithBase(`/blog/authors/${author.id}/`)} class="blog-post-author">{author.data.name}</a>
            </Fragment>
          ))}
        </div>
      </header>

      {coverImage && (
        <img src={coverImage} alt="" class="blog-post-cover" />
      )}

      <div class="blog-post-content">
        <slot />
      </div>
    </article>
  </div>
</BlogLayout>

<style>
  .blog-wrapper {
    max-width: 820px;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  .blog-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
    font-family: var(--sl-font);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s;
  }

  .blog-back-link:hover {
    color: var(--sl-color-text-accent);
  }

  .blog-post {
    min-width: 0;
    margin-top: .5ch;
  }

  .blog-post-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding-bottom: 2rem;
  }

  .blog-post-header h1 {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0.5rem 0 1rem;
    color: var(--sl-color-white);
  }

  .blog-post-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font);
  }

  .blog-post-description {
    font-family: var(--sl-font);
    font-size: 1.125rem;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .blog-post-authors {
    font-family: var(--sl-font);
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }

  .blog-post-author {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .blog-post-author:hover {
    color: var(--sl-color-white);
  }

  .blog-post-cover {
    width: 100%;
    border-radius: 12px;
    margin-bottom: 2rem;
  }

  .blog-post-content {
    font-family: var(--sl-font);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--sl-color-white);
  }

  .blog-post-content :global(h2) {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--sl-color-white);
  }

  .blog-post-content :global(h3) {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--sl-color-white);
  }

  .blog-post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .blog-post-content :global(pre) {
    margin: 1.5rem 0;
    border-radius: 8px;
  }

  .blog-post-content :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .blog-post-content :global(a:not([role='tab'])) {
    /* --sl-color-accent is #02a435 in light mode (3.29:1 on white — fails AA).
       text-accent is the a11y-safe darker green. */
    color: var(--sl-color-text-accent);
  }

  .blog-post-content :global(a:not([role='tab']):hover) {
    color: var(--sl-color-accent-high);
  }

  /* Tab labels are anchors, so the link rule above would paint them all green.
     Keep unselected tabs muted; only the selected one is green and bold. */
  .blog-post-content :global(starlight-tabs [role='tab']) {
    color: var(--sl-color-gray-2);
    font-weight: 400;
  }

  .blog-post-content :global(starlight-tabs [role='tab'][aria-selected='true']) {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  /* Stretch the top-level provider tabs across the full content width, spread
     the labels evenly, and give them one continuous baseline. Each label fills
     its equal-width segment so the selected underline is a consistent width.
     Nested language sub-tabs keep their default left-aligned sizing. */
  .blog-post-content :global(> starlight-tabs > .tablist-wrapper ul[role='tablist']) {
    display: flex;
    width: 100%;
    /* Drop the tablist's own baseline; the per-tab box-shadow underlines meet
       edge to edge to form one continuous line, green under the active tab. */
    border-bottom: none;
  }

  .blog-post-content :global(> starlight-tabs > .tablist-wrapper ul[role='tablist'] > .tab) {
    flex: 1;
  }

  .blog-post-content :global(> starlight-tabs > .tablist-wrapper ul[role='tablist'] > .tab > [role='tab']) {
    display: block;
    width: 100%;
    text-align: center;
  }

  .blog-post-content :global(ul),
  .blog-post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .blog-post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .blog-post-content :global(blockquote) {
    border-left: 3px solid var(--sl-color-gray-4);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  .blog-post-content :global(code:not(pre code)) {
    background: var(--sl-color-gray-6);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  @media (max-width: 768px) {
    .blog-wrapper {
      padding: 1.5rem 1rem 3rem;
    }
  }
</style>
