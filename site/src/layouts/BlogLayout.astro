---
/**
 * Blog Layout
 *
 * Uses StarlightPage to get the full Starlight page shell (head, styles,
 * theme, header) for free, without sidebar or doc-page chrome.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { pathWithBase } from '../util/links'

type HeadTag = 'link' | 'meta' | 'script' | 'style' | 'title' | 'base' | 'noscript' | 'template'
export type HeadEntry = { tag: HeadTag; attrs?: Record<string, string | boolean | undefined>; content?: string }

interface Props {
  title: string
  description?: string
  ogImage?: string
  canonicalUrl?: string
  /** Thin archive pages (tag/author) set this to keep near-duplicate content out of the index */
  noindex?: boolean
  /**
   * Additional head tags (e.g. per-post JSON-LD, article OG metas). These must
   * flow through StarlightPage's `head` frontmatter — StarlightPage renders no
   * named head slot, so slotted tags would be silently dropped.
   */
  extraHead?: HeadEntry[]
}

const {
  title,
  description,
  ogImage,
  canonicalUrl: canonicalOverride,
  noindex = false,
  extraHead = [],
} = Astro.props

const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const canonicalUrl = canonicalOverride || pageUrl

const head: HeadEntry[] = [
  { tag: 'link', attrs: { rel: 'canonical', href: canonicalUrl } },
  { tag: 'meta', attrs: { property: 'og:title', content: title } },
  { tag: 'meta', attrs: { property: 'og:type', content: 'article' } },
  { tag: 'meta', attrs: { property: 'og:url', content: pageUrl } },
  { tag: 'meta', attrs: { name: 'twitter:card', content: 'summary_large_image' } },
  { tag: 'meta', attrs: { name: 'twitter:title', content: title } },
  { tag: 'link', attrs: { rel: 'alternate', type: 'application/rss+xml', title: 'Strands Agents Blog', href: pathWithBase('/blog/feed.xml') } },
]
if (noindex) {
  head.push({ tag: 'meta' as const, attrs: { name: 'robots', content: 'noindex, follow' } })
}
if (description) {
  head.push({ tag: 'meta' as const, attrs: { property: 'og:description', content: description } })
  head.push({ tag: 'meta' as const, attrs: { name: 'twitter:description', content: description } })
}
if (ogImage) {
  head.push({ tag: 'meta' as const, attrs: { property: 'og:image', content: ogImage } })
  head.push({ tag: 'meta' as const, attrs: { name: 'twitter:image', content: ogImage } })
}
head.push(...extraHead)
---

<StarlightPage
  frontmatter={{ title, description, template: 'splash', pagefind: false, head, hero: { actions: [] } }}
  hasSidebar={false}
>
  {/* Splash pages omit the `id="_top"` that Starlight puts on doc-page h1s,
      leaving the "Skip to content" link (href="#_top") with no target. Anchor
      it here so the skip link works on blog/changelog pages. */}
  <div id="_top" class="blog-layout-root">
    <slot />
  </div>
</StarlightPage>

<style is:global>
  /* Starlight's splash `.sl-container` has max-width but margin-inline: 0, so
     blog content hugged the left with dead space on the right. Center it (and
     its content panel) so the blog reads as a centered column like the rest of
     the site. Scoped to pages that render .blog-layout-root (blog only). */
  .content-panel:has(.blog-layout-root) .sl-container,
  .content-panel:has(.blog-layout-root) {
    margin-inline: auto;
  }
</style>
