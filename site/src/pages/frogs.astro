---
import { baseSchemas, serializeJsonLd } from '../util/structured-data'

const gameUrl = 'https://d3i1gpu82pqyr4.cloudfront.net/'
const base = import.meta.env.BASE_URL || '/'
const faviconHref = base.endsWith('/') ? `${base}favicon.svg` : `${base}/favicon.svg`
const siteUrl = Astro.site?.origin || 'https://strandsagents.com'
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': baseSchemas(siteUrl),
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Frogs</title>
    <meta name="description" content="Frogs." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #000;
        overflow: hidden;
      }
      iframe {
        border: 0;
        width: 100vw;
        height: 100vh;
        display: block;
      }
    </style>
  </head>
  <body>
    <iframe
      src={gameUrl}
      title="Frogs"
      sandbox="allow-scripts allow-same-origin allow-pointer-lock"
      allow="fullscreen; autoplay; gamepad; pointer-lock"
      referrerpolicy="no-referrer"
    ></iframe>
  </body>
</html>
