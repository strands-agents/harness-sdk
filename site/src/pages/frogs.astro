---
import { pathWithBase } from '../util/links'
import { baseSchemas, serializeJsonLd } from '../util/structured-data'

const title = 'Stranded in New York'
const description = 'Strands frogs hop, skip and drive around Midtown Manhattan. What will you discover?'
const gameUrl = 'https://d3i1gpu82pqyr4.cloudfront.net/'
const base = import.meta.env.BASE_URL || '/'
const faviconHref = base.endsWith('/') ? `${base}favicon.svg` : `${base}/favicon.svg`
const siteUrl = Astro.site?.origin || 'https://strandsagents.com'
const canonicalHref = new URL(pathWithBase('/frogs/'), siteUrl).href
const ogImageHref = new URL(pathWithBase('/frogs-preview.jpg'), siteUrl).href
const ogImageAlt = 'A Strands frog beside the ice rink, skating frogs and Christmas market stalls in Bryant Park.'
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': baseSchemas(siteUrl),
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #000;
        overflow: hidden;
      }
      iframe {
        border: 0;
        width: 100vw;
        height: 100vh;
        display: block;
      }
    </style>
  </head>
  <body>
    <iframe
      src={gameUrl}
      title={title}
      sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-downloads"
      allow="fullscreen; autoplay; gamepad; pointer-lock"
      referrerpolicy="no-referrer"
    ></iframe>
  </body>
</html>
