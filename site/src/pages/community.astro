---
import { getCollection } from 'astro:content'
import LandingLayout from '../layouts/LandingLayout.astro'
import Copyright from '../components/Copyright.astro'
import CommunityHero from '../components/community/CommunityHero.astro'
import CommunityBulletin, { type BulletinItem } from '../components/community/CommunityBulletin.astro'
import CoursesSection, { type EnrichedLesson } from '../components/community/CoursesSection.astro'
import DeepDivesSection from '../components/community/DeepDivesSection.astro'
import EventsPoster from '../components/community/EventsPoster.astro'
import BlogSection from '../components/community/BlogSection.astro'
import KeepGoingStrip from '../components/community/KeepGoingStrip.astro'
import { deepDives, suggestTopicHref } from '../config/learn'
import { getPublishedPosts } from '../util/blog'
import { featuredCourse, formatEventDate, posterEvent, shelfCourses, tickerEvents, toIsoDate, upcomingEvents } from '../util/learn'
import { pathWithBase } from '../util/links'
import curvePrimary from '../assets/curve-primary.svg'
import curveSecondary from '../assets/curve-secondary.svg'

const courses = (await getCollection('courses')).map((entry) => entry.data)
const events = (await getCollection('events')).map((entry) => entry.data)
const posts = (await getPublishedPosts()).slice(0, 3)

// YAML hrefs are site-relative — compare raw slug, not pathWithBase.
const docs = await getCollection('docs')
const titleByHref = new Map<string, string>()
for (const doc of docs) {
  if (doc.data.title) {
    titleByHref.set(`/${doc.id}/`, doc.data.title as string)
  }
}

function stripLessonPrefix(title: string): string {
  return title.replace(/^Lesson \d+:\s*/, '')
}

const today = new Date()
const featured = featuredCourse(courses)
const shelf = shelfCourses(courses, featured)

const enrichedFeatured = featured
  ? {
      ...featured,
      lessons: featured.lessons?.map((lesson, i): EnrichedLesson => ({
        number: i + 1,
        title: stripLessonPrefix(titleByHref.get(lesson.href) ?? lesson.href),
        href: lesson.href,
      })),
    }
  : undefined

const headliner = posterEvent(events, today)
const otherEvents = upcomingEvents(events, today).filter((e) => e !== headliner)

// Hero bulletin: one item per category — next event, freshest post, and a static
// pointer to the catalog's new-integrations view (featuring individual
// integrations is an editorial call; the catalog churns too fast to automate).
const nextEvent = tickerEvents(events, today, 1)[0]
const newestPost = posts[0]

const bulletin: BulletinItem[] = [
  {
    type: 'hackathon' as const,
    kicker: 'Strands Hackathon',
    title: 'Compete for $40,000 in cash prizes',
    href: 'https://agentsforhumans.devpost.com/',
    expires: '2026-09-14',
  },
  ...(nextEvent
    ? [
        {
          type: 'event' as const,
          kicker: `Meet us in person · ${formatEventDate(nextEvent)}`,
          title: nextEvent.title,
          href:
            nextEvent.href && nextEvent.href.startsWith('http')
              ? nextEvent.href
              : nextEvent.href && pathWithBase(nextEvent.href),
          expires: toIsoDate(nextEvent.endDate ?? nextEvent.startDate),
        },
      ]
    : []),
  ...(newestPost
    ? [
        {
          type: 'post' as const,
          kicker: 'Just dropped on the blog',
          title: newestPost.data.title,
          href: pathWithBase(`/blog/${newestPost.id}/`),
        },
      ]
    : []),
  {
    type: 'integration' as const,
    kicker: 'In the catalog',
    title: 'Check out the newest integrations',
    href: pathWithBase('/integrations/?badge=new'),
  },
]
---

<LandingLayout
  title="Community — Strands Agents"
  description="Courses, deep dives, and events from the team building the Strands Agents SDK."
>
  <div class="strands-curves-container" aria-hidden="true">
    <div class="strands-curve-secondary" style={`background-image: url(${curveSecondary.src})`}></div>
    <div class="strands-curve-primary" style={`background-image: url(${curvePrimary.src})`}></div>
  </div>

  <div class="community-page">
    <CommunityHero>
      <CommunityBulletin slot="bulletin" items={bulletin} />
    </CommunityHero>

    <div class="wrap">
      <CoursesSection featured={enrichedFeatured} shelf={shelf} />

      <section id="deep-dives" class="spread">
        <DeepDivesSection dives={deepDives} suggestTopicHref={suggestTopicHref} />
        <div id="events" class="events-col">
          <h2 class="events-heading">Events</h2>
          <p class="events-dek">Where to find the team.</p>
          <EventsPoster headliner={headliner} others={otherEvents.slice(0, 3)} />
        </div>
      </section>

      <BlogSection posts={posts} />

      <KeepGoingStrip />
    </div>
  </div>

  <footer class="community-footer">
    <div class="community-footer-inner">
      <Copyright />
    </div>
  </footer>

  <script>
    import { expireEvents } from '../util/expire-events'
    expireEvents(document, new Date().toISOString().slice(0, 10))
  </script>

  <script>
    const primary = document.querySelector<HTMLElement>('.strands-curve-primary')
    const secondary = document.querySelector<HTMLElement>('.strands-curve-secondary')

    if (primary && secondary && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let ticking = false

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              const scrollY = window.scrollY
              primary.style.setProperty('--scroll-offset', `${-(scrollY * 0.3) % 344}px`)
              secondary.style.setProperty('--scroll-offset', `${-(scrollY * 0.15) % 344}px`)
              ticking = false
            })
            ticking = true
          }
        },
        { passive: true },
      )
    }
  </script>
</LandingLayout>

<style is:global>
  /* Anchor targets clear the fixed site header when jumped to via hero links. */
  #courses,
  #deep-dives,
  #events,
  #blog {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }
</style>

<style>
  .strands-curves-container {
    position: fixed;
    top: var(--sl-nav-height);
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    filter: blur(28px);
    opacity: 0.1;
    overflow: hidden;
    /* fades in below hero gradient so curves don't appear at full strength immediately */
    mask-image: linear-gradient(to bottom, transparent 0%, black 45%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 45%);
  }

  :global([data-theme='light']) .strands-curves-container {
    filter: blur(20px);
    opacity: 0.2;
  }

  .strands-curve-secondary {
    background-repeat: repeat-y;
    height: 200vw;
    width: 291px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(110deg) scale(2);
    animation: community-scroll-secondary 90s linear infinite;
    z-index: -1;
  }

  .strands-curve-primary {
    background-repeat: repeat-y;
    height: 200vw;
    width: 290px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(110deg) scale(1.5);
    animation: community-scroll-primary 36s linear infinite;
  }

  .strands-curve-primary,
  .strands-curve-secondary {
    --scroll-offset: 0px;
  }

  @keyframes community-scroll-primary {
    0% {
      background-position: 0 calc(0px + var(--scroll-offset));
    }
    100% {
      background-position: 0 calc(-344px + var(--scroll-offset));
    }
  }

  @keyframes community-scroll-secondary {
    0% {
      background-position: 0 calc(0px + var(--scroll-offset));
    }
    100% {
      background-position: 0 calc(-344px + var(--scroll-offset));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strands-curve-primary,
    .strands-curve-secondary {
      animation: none;
    }
  }

  .community-page {
    width: 100%;
    background: transparent;
  }

  .community-page :global(:focus-visible) {
    outline: 2px solid var(--strands-green, #00cc5f);
    outline-offset: 2px;
  }

  :global([data-theme='light']) .community-page :global(:focus-visible) {
    outline-color: #008542;
  }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  .spread {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 4rem;
    align-items: start;
    padding: 4.25rem 0;
    border-top: 1px solid #262626;
  }

  :global([data-theme='light']) .spread {
    border-top-color: rgba(0, 0, 0, 0.1);
  }

  .community-footer {
    padding: 1.5rem 2rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
    background-color: var(--sl-color-bg-nav);
  }

  .community-footer-inner {
    max-width: 1200px;
    text-align: left;
    margin: 0 auto;
  }

  .events-col {
    display: flex;
    flex-direction: column;
  }

  .events-heading {
    font-family: 'Figtree', sans-serif;
    font-size: 2.625rem;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
  }

  .events-dek {
    font-family: 'Figtree', sans-serif;
    font-size: 0.9375rem;
    color: var(--sl-color-gray-3);
    margin: 0.375rem 0 1.5rem;
  }

  @media (max-width: 900px) {
    .wrap {
      padding: 0 1.5rem;
    }

    .spread {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .events-heading {
      font-size: 2rem;
    }
  }
</style>
