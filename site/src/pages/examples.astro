---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { getCollection } from 'astro:content'
import { pathWithBase } from '../util/links'
import {
  groupSampleGuideFamilies,
  sampleGuidePath,
  sortSampleGuides,
  type SampleGuideEntry,
  type SampleGuideFamily,
} from '../util/sample-guides'
import { languageLabel } from '../util/source-links'

const guides = sortSampleGuides(await getCollection('sampleGuides'))
const featuredGuides = guides.filter((guide) => guide.data.placement === 'featured')
const featuredFamilies = groupSampleGuideFamilies(featuredGuides)
const referenceGuides = guides.filter((guide) => guide.data.placement === 'reference')
const featuredHeading = featuredGuides[0]?.data.collections[0]?.label ?? 'End-to-end examples'
const featuredDescription = featuredGuides[0]?.data.collections[0]?.description

const collectionSections = new Map<
  string,
  { label: string; description?: string; guides: SampleGuideEntry[]; order: number }
>()
const ungroupedReferences: SampleGuideEntry[] = []
for (const guide of referenceGuides) {
  const collection = guide.data.collections[0]
  if (!collection) {
    ungroupedReferences.push(guide)
    continue
  }

  let section = collectionSections.get(collection.id)
  if (!section) {
    section = {
      label: collection.label,
      description: collection.description,
      guides: [],
      order: collection.order,
    }
    collectionSections.set(collection.id, section)
  }
  section.guides.push(guide)
}
const supplementalSections = [...collectionSections.values()]
  .sort((left, right) => left.order - right.order)
  .map((section) => ({ ...section, families: groupSampleGuideFamilies(section.guides) }))
const ungroupedReferenceFamilies = groupSampleGuideFamilies(ungroupedReferences)

const isAmplifying = (family: SampleGuideFamily) =>
  family.guides.some(
    (guide) =>
      guide.data.program === 'amplifying-ai' ||
      guide.data.collections.some((collection) => collection.id === 'amplifying-ai')
  )
---

<StarlightPage
  frontmatter={{
    title: 'Examples',
    description: 'Complete Strands applications, from setup through validation and deployment.',
    editUrl: false,
    pagefind: true,
  }}
  hasSidebar={false}
  sidebar={[]}
>
  {
    guides.length > 0 ? (
      <>
        <p class="sample-catalog__intro">
          Build from a complete application, then use the{' '}
          <a href={pathWithBase('/docs/user-guide/sdk/quickstart/overview/')}>documentation</a> for individual
          components and concepts.
        </p>

        {featuredFamilies.length > 0 && (
          <section class="sample-catalog__section" aria-labelledby="featured-examples">
            <h2 id="featured-examples">{featuredHeading}</h2>
            {featuredDescription && <p>{featuredDescription}</p>}
            <div class="sample-catalog__grid">
              {featuredFamilies.map((family) => (
                <article
                  class="sample-card"
                  data-sample-family={family.key}
                  data-sample-placement="featured"
                >
                  <div class="sample-card__badges">
                    <span>{family.primary.data.kind}</span>
                    {isAmplifying(family) && <span class="sample-card__program">Amplifying AI</span>}
                  </div>
                  <h3>{family.primary.data.title}</h3>
                  <p>{family.primary.data.description}</p>
                  {family.primary.data.capabilities.length > 0 && (
                    <p class="sample-card__capabilities">
                      {family.primary.data.capabilities.slice(0, 4).join(' · ')}
                    </p>
                  )}
                  <nav
                    class="sample-card__links"
                    aria-label={`${family.primary.data.title} languages`}
                  >
                    {family.guides.map((guide) => (
                      <a href={pathWithBase(sampleGuidePath(guide))}>
                        {languageLabel(guide.data.language)}
                      </a>
                    ))}
                  </nav>
                </article>
              ))}
            </div>
          </section>
        )}

        {supplementalSections.map((section, sectionIndex) => (
          <section
            class="sample-catalog__section"
            aria-labelledby={`sample-collection-${sectionIndex}`}
            data-pagefind-ignore
          >
            <h2 id={`sample-collection-${sectionIndex}`}>{section.label}</h2>
            {section.description && <p>{section.description}</p>}
            <div class="sample-catalog__grid sample-catalog__grid--secondary">
              {section.families.map((family) => (
                <article
                  class="sample-card"
                  data-sample-family={family.key}
                  data-sample-placement="reference"
                >
                  <div class="sample-card__badges">
                    <span>{family.primary.data.kind}</span>
                    {isAmplifying(family) && <span class="sample-card__program">Amplifying AI</span>}
                  </div>
                  <h3>{family.primary.data.title}</h3>
                  <p>{family.primary.data.description}</p>
                  <nav
                    class="sample-card__links"
                    aria-label={`${family.primary.data.title} languages`}
                  >
                    {family.guides.map((guide) => (
                      <a href={pathWithBase(sampleGuidePath(guide))}>
                        {languageLabel(guide.data.language)}
                      </a>
                    ))}
                  </nav>
                </article>
              ))}
            </div>
          </section>
        ))}

        {ungroupedReferenceFamilies.length > 0 && (
          <details class="sample-catalog__references" data-pagefind-ignore>
            <summary>Reference library ({ungroupedReferenceFamilies.length})</summary>
            <ul>
              {ungroupedReferenceFamilies.map((family) => (
                <li data-sample-family={family.key} data-sample-placement="reference">
                  <span>{family.primary.data.title}</span>
                  <nav aria-label={`${family.primary.data.title} languages`}>
                    {family.guides.map((guide) => (
                      <a href={pathWithBase(sampleGuidePath(guide))}>
                        {languageLabel(guide.data.language)}
                      </a>
                    ))}
                  </nav>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    ) : (
      <>
        <p>Sample guides are not available in this local build.</p>
        <p>
          Set <code>SAMPLES_SOURCE_DIR</code> to a checkout of the samples repository, then restart the site.
        </p>
      </>
    )
  }
</StarlightPage>

<style>
  .sample-catalog__intro {
    max-width: 50rem;
    font-size: var(--sl-text-lg);
  }

  .sample-catalog__section {
    margin-block: 2.5rem;
  }

  .sample-catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .sample-catalog__grid--secondary {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .sample-card {
    padding: 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    color: inherit;
    background: var(--sl-color-bg-nav);
  }

  .sample-card:hover,
  .sample-card:focus-within {
    border-color: var(--sl-color-accent);
  }

  .sample-card h3 {
    margin-block: 0.8rem 0.45rem;
    color: var(--sl-color-white);
  }

  .sample-card p {
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  .sample-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .sample-card__badges span {
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    text-transform: capitalize;
  }

  .sample-card__badges .sample-card__program {
    border-color: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .sample-card .sample-card__capabilities {
    margin-top: 0.8rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .sample-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .sample-card__links a {
    padding: 0.3rem 0.7rem;
    border-radius: 0.35rem;
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .sample-card__links a:hover {
    text-decoration: underline;
  }

  .sample-catalog__references {
    margin-block: 2.5rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .sample-catalog__references summary {
    cursor: pointer;
    font-weight: 600;
  }

  .sample-catalog__references li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-block: 0.5rem;
  }

  .sample-catalog__references li nav {
    display: flex;
    gap: 0.75rem;
    font-size: var(--sl-text-sm);
  }
</style>
