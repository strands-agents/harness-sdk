---
import type { GetStaticPaths } from 'astro'
import SamplePage from '../../components/samples/SamplePage.astro'
import { sampleDetails, type SampleDetail } from '../../util/sample-details'
import { defaultSample } from '../../util/sample-navigation'

export const getStaticPaths = (() =>
  sampleDetails
    .filter((sample) => sample.id !== defaultSample.id)
    .map((sample) => ({
      params: { sample: sample.slug },
      props: { sample },
    }))) satisfies GetStaticPaths

interface Props {
  sample: SampleDetail
}

const { sample } = Astro.props
---

<SamplePage sample={sample} />
