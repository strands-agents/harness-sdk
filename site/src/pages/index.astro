---
import Navigation from '../components/Navigation.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import Banner from '../components/Banner.astro';
import InteractiveToolkit from '../components/InteractiveToolkit.astro';
import LogoFarm from '../components/LogoFarm.astro';
import UseCases from '../components/UseCases.astro';
import ProveCases from '../components/ProveCases.astro';
import CommunityHub from '../components/CommunityHub.astro';
import NextSteps from '../components/NextSteps.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/fonts.css';

// Base-path-aware favicon href — matches the docs override in Head.astro so
// the homepage doesn't 404 under a prefixed deploy path.
const base = import.meta.env.BASE_URL || '/';
const faviconHref = base.endsWith('/') ? `${base}favicon.svg` : `${base}/favicon.svg`;
// Self-referencing canonical (param-free) so tracking params like ?utm_source=...
// don't get indexed as duplicate homepages. Docs/blog pages get theirs from Starlight.
const canonicalHref = new URL(base, Astro.site ?? 'https://strandsagents.com').href;
// Standalone pages don't inherit Starlight's head, so declare the shared
// /og-image.png share card here too (docs/blog get theirs from Starlight).
const ogImageHref = new URL('og-image.png', Astro.site ?? 'https://strandsagents.com').href;
const pageTitle = 'Strands Agents | Open source SDK for AI agents in Python and TypeScript';
const pageDescription =
  'Open-source SDK for building and running AI agents in Python and TypeScript: lifecycle controls, tools, MCP, multi-agent, memory, streaming, guardrails, and evals.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Strands Agents — open source AI agent SDK" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageHref} />
    <script is:inline>
      // Apply the theme before first paint to avoid a flash. With no saved
      // preference, follow the system color scheme (matches Starlight's docs
      // pages and the footer theme control) rather than defaulting to light.
      (function () {
        try {
          var saved = localStorage.getItem('starlight-theme');
          var theme = (saved === 'dark' || saved === 'light')
            ? saved
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (_) {}
      })();
    </script>
    <!-- Cookie consent + analytics, same stack as docs pages. -->
    <SiteScripts />
    <Analytics />
  </head>
  <body>
    <Navigation />
    {/* Mount Starlight's Pagefind search dialog (button hidden) so the nav's
        search trigger has a modal to open — the homepage isn't a Starlight
        page, so it wouldn't otherwise be present. */}
    <div class="site-search-host">
      <Search />
    </div>
    <main>
      <Banner />
      <InteractiveToolkit />
      <LogoFarm />
      <UseCases />
      <ProveCases />
      <CommunityHub />
      <NextSteps />
    </main>
    {/* NextSteps already provides the green curved transition on the homepage. */}
    <Footer topShape={false} />
  </body>
</html>

<style is:global>
  /* Keep the search dialog mounted but hide its default trigger button; the
     nav's own search control is the visible entry point (mirrors Header.astro). */
  .site-search-host {
    display: contents;
  }
  .site-search-host button[data-open-modal] {
    display: none;
  }

  /* Starlight's reset provides border-box on docs pages; this standalone
     page needs it too, or width:100% + padding sections overflow the
     viewport and everything sits off-center. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  /* Prevent horizontal scroll from off-canvas decorative shapes (like the
     NextSteps green corners) on narrow viewports. */
  body {
    overflow-x: hidden;
  }
</style>
