---
import Search from '@astrojs/starlight/components/Search.astro';
import Navigation from '../components/Navigation.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import Banner from '../components/Banner.astro';
import InteractiveToolkit from '../components/InteractiveToolkit.astro';
import LogoFarm from '../components/LogoFarm.astro';
import UseCases from '../components/UseCases.astro';
import ProveCases from '../components/ProveCases.astro';
import CommunityHub from '../components/CommunityHub.astro';
import HomeFaq from '../components/HomeFaq.astro';
import NextSteps from '../components/NextSteps.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';
import { products } from '../config/navbar';
import { productSchema } from '../util/structured-data';
import '../styles/fonts.css';

const pageTitle = 'Strands Agents | The open source toolkit for production AI agents';
const pageDescription =
  'Strands is the open source toolkit for building production AI agents in Python and TypeScript: an agent harness, policy-enforced sandboxing, and evals.';
const siteUrl = Astro.site?.origin || 'https://strandsagents.com';
const structuredData = products.map((product) => productSchema(product, siteUrl));
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={pageTitle}
      description={pageDescription}
      canonicalPath="/"
      markdownPath="/index.md"
      serviceDescriptionPath="/openapi.json"
      ogImageAlt="Strands Agents — the open source toolkit for production agents"
      {structuredData}
    />
  </head>
  <body>
    <AnnouncementBanner />
    <Navigation />
    {/* Mount Starlight's Pagefind search dialog (button hidden) so the nav's
        search trigger has a modal to open — the homepage isn't a Starlight
        page, so it wouldn't otherwise be present. */}
    <div class="site-search-host">
      <Search />
    </div>
    <main>
      <Banner />
      <InteractiveToolkit />
      <LogoFarm />
      <UseCases />
      <ProveCases />
      <CommunityHub />
      <HomeFaq />
      <NextSteps />
    </main>
    {/* NextSteps already provides the green curved transition on the homepage. */}
    <Footer topShape={false} />
  </body>
</html>

<style is:global>
  /* Keep the search dialog mounted but hide its default trigger button; the
     nav's own search control is the visible entry point (mirrors Header.astro). */
  .site-search-host {
    display: contents;
  }
  .site-search-host button[data-open-modal] {
    display: none;
  }

  /* Starlight's reset provides border-box on docs pages; this standalone
     page needs it too, or width:100% + padding sections overflow the
     viewport and everything sits off-center. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  /* Prevent horizontal scroll from off-canvas decorative shapes (like the
     NextSteps green corners) on narrow viewports. */
  body {
    overflow-x: hidden;
  }
</style>
