---
import { getCollection, render } from 'astro:content'

const entries = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order)

if (entries.length === 0) {
  throw new Error('Expected at least one testimonial')
}

const testimonials = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry)
    return { Content, testimonial: entry.data }
  })
)

const total = String(testimonials.length).padStart(2, '0')
---

<section
  class="prove"
  aria-labelledby="prove-title"
  data-testimonial-browser
  data-testimonial-interval="9000"
>
  <div class="prove__inner">
    <header class="prove__intro">
      <div class="prove__heading">
        <p class="prove__eyebrow">Used in production</p>
        <h2 id="prove-title">Teams run Strands in production.</h2>
      </div>

      <div class="prove__controls" data-testimonial-controls hidden>
        <p class="prove__counter" aria-live="off">
          <span data-testimonial-current>01</span>
          <span aria-hidden="true">/</span>
          <span>{total}</span>
          <span class="sr-only">stories</span>
        </p>
        <div class="prove__buttons">
          <button
            class="prove__button"
            type="button"
            aria-label="Pause automatic story rotation"
            aria-pressed="false"
            aria-controls="prove-stories"
            data-testimonial-toggle
          >
            <svg class="prove__icon prove__icon--pause" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5.5 3v10M10.5 3v10"></path>
            </svg>
            <svg class="prove__icon prove__icon--play" viewBox="0 0 16 16" aria-hidden="true">
              <path d="m5 3 7 5-7 5V3z"></path>
            </svg>
          </button>
          <button
            class="prove__button"
            type="button"
            aria-label="Previous story"
            aria-controls="prove-stories"
            data-testimonial-previous
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m10.5 3-5 5 5 5"></path>
            </svg>
          </button>
          <button
            class="prove__button"
            type="button"
            aria-label="Next story"
            aria-controls="prove-stories"
            data-testimonial-next
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m5.5 3 5 5-5 5"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div class="prove__stories" id="prove-stories" aria-live="off">
      {
        testimonials.map(({ Content, testimonial }, index) => (
          <article
            class="prove__story"
            role="group"
            aria-label={`${index + 1} of ${testimonials.length}: Story from ${testimonial.name}`}
            data-testimonial-story
          >
            <svg class="prove__mark" viewBox="0 0 31 25" fill="none" aria-hidden="true">
              <path
                d="M0 25V12.5C0 5.596 5.596 0 12.5 0V6.25c-3.452 0-6.25 2.798-6.25 6.25H12.5V25H0zm18.5 0V12.5C18.5 5.596 24.096 0 31 0v6.25c-3.452 0-6.25 2.798-6.25 6.25H31V25H18.5z"
                fill="currentColor"
              />
            </svg>

            <blockquote class="prove__quote">
              <Content />
            </blockquote>

            <footer class="prove__attribution">
              <div class="prove__person">
                {
                  testimonial.logo && (
                    <span class="prove__logos" aria-hidden="true">
                      <img
                        class="prove__logo prove__logo--light"
                        src={testimonial.logo.src}
                        alt=""
                        loading="lazy"
                      />
                      {testimonial.dark_logo && (
                        <img
                          class="prove__logo prove__logo--dark"
                          src={testimonial.dark_logo.src}
                          alt=""
                          loading="lazy"
                        />
                      )}
                    </span>
                  )
                }
                <div class="prove__attribution-text">
                  <p class="prove__name">{testimonial.name}</p>
                  {testimonial.title && <p class="prove__role">{testimonial.title}</p>}
                </div>
              </div>
              {
                testimonial.link && (
                  <a class="prove__source" href={testimonial.link} target="_blank" rel="noopener noreferrer">
                    Read the story
                    <span aria-hidden="true">↗</span>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                )
              }
            </footer>
          </article>
        ))
      }
    </div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-testimonial-status></p>
  </div>
</section>

<style>
  .prove {
    padding: var(--home-section-space-compact) var(--home-gutter);
    background: var(--bg);
  }

  .prove__inner {
    display: flex;
    flex-direction: column;
    max-width: var(--home-content-width);
    margin: 0 auto;
  }

  .prove__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 24px 40px;
    margin-bottom: clamp(22px, 3vw, 32px);
  }

  .prove__eyebrow {
    margin: 0 0 12px;
    font-family: var(--home-control-font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--home-label);
  }

  .prove__intro h2 {
    max-width: 820px;
    margin: 0;
    font-family: var(--home-display-font);
    font-size: var(--home-heading-size);
    font-weight: 500;
    letter-spacing: var(--home-heading-tracking);
    line-height: var(--home-heading-line-height);
    color: var(--fg);
    text-wrap: balance;
  }

  .prove__controls {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 5px;
    border: 1px solid var(--home-rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 3%, transparent);
  }

  .prove__controls[hidden] {
    display: none;
  }

  .prove__counter {
    display: flex;
    gap: 6px;
    margin: 0 3px 0 10px;
    font-family: var(--home-control-font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    color: color-mix(in srgb, var(--fg) 58%, transparent);
  }

  .prove__buttons {
    display: flex;
    gap: 4px;
  }

  .prove__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    color: var(--fg);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .prove__button:hover {
    background: color-mix(in srgb, var(--fg) 10%, transparent);
  }

  .prove__button:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 3px;
  }

  .prove__button svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .prove__icon--play {
    display: none;
  }

  .prove__button[data-paused='true'] .prove__icon--pause {
    display: none;
  }

  .prove__button[data-paused='true'] .prove__icon--play {
    display: block;
  }

  .prove__stories {
    position: relative;
    isolation: isolate;
    display: grid;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--home-radius-large);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent-green) 10%, var(--card-bg)) 0%,
      color-mix(in srgb, var(--accent-green) 3%, var(--bg)) 100%
    );
  }

  .prove__stories::before {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: clamp(72px, 9vw, 120px);
    height: 4px;
    border-radius: 0 0 4px;
    background: var(--accent-green);
    content: '';
  }

  .prove__story {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 360px;
    flex-direction: column;
    padding: clamp(38px, 5vw, 68px);
    border-bottom: 1px solid var(--home-rule);
    opacity: 1;
    visibility: visible;
    transition:
      opacity 180ms ease,
      visibility 0s linear;
  }

  .prove__story:last-child {
    border-bottom: 0;
  }

  .prove[data-initialized='true'] .prove__stories {
    min-height: 360px;
  }

  .prove[data-initialized='true'] .prove__story {
    grid-area: 1 / 1;
    min-height: 100%;
    border-bottom: 0;
  }

  .prove[data-initialized='true'] .prove__story[aria-hidden='true'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 180ms ease,
      visibility 0s linear 180ms;
  }

  .prove__mark {
    position: absolute;
    z-index: -1;
    top: clamp(28px, 4vw, 52px);
    right: clamp(28px, 5vw, 72px);
    width: clamp(70px, 9vw, 112px);
    height: auto;
    color: var(--accent-green);
    opacity: 0.12;
  }

  .prove__quote {
    max-width: 1020px;
    margin: 0 0 clamp(36px, 5vw, 58px);
  }

  .prove__quote :global(p) {
    margin: 0;
    font-family: var(--home-display-font);
    font-size: clamp(17px, 1.35vw, 19px);
    font-weight: 400;
    line-height: 1.55;
    color: var(--fg);
  }

  .prove__quote :global(a) {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  .prove__attribution {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: auto;
  }

  .prove__person {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 18px;
  }

  .prove__logos {
    display: inline-flex;
    flex: none;
    align-items: center;
  }

  .prove__logo {
    display: block;
    width: auto;
    height: 25px;
    max-width: 132px;
    object-fit: contain;
  }

  .prove__logo--dark {
    display: none;
  }

  :global([data-theme='dark']) .prove__logos:has(.prove__logo--dark) .prove__logo--light {
    display: none;
  }

  :global([data-theme='dark']) .prove__logo--dark {
    display: block;
  }

  .prove__attribution-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }

  .prove__name,
  .prove__role {
    margin: 0;
    font-family: var(--home-control-font);
    line-height: 1.4;
    color: var(--fg);
  }

  .prove__name {
    font-size: 13px;
    font-weight: 700;
  }

  .prove__role {
    font-size: 11px;
    opacity: 0.68;
  }

  .prove__source {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
    flex: none;
    min-height: 36px;
    margin-left: auto;
    padding: 8px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    font-family: var(--home-control-font);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
    color: var(--accent-green);
    text-decoration: none;
    text-transform: uppercase;
  }

  .prove__source:hover {
    background: color-mix(in srgb, var(--fg) 11%, transparent);
  }

  .prove__source:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    .prove__intro {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 18px;
      margin-bottom: 20px;
    }

    .prove__intro h2 {
      max-width: 520px;
    }

    .prove__controls {
      justify-self: start;
    }

    .prove__stories {
      min-height: 0;
      border-radius: var(--home-radius-medium);
    }

    .prove__story {
      padding: 30px 24px 26px;
    }

    .prove__quote {
      margin-bottom: 32px;
    }

    .prove__quote :global(p) {
      font-size: 15px;
      line-height: 1.5;
    }

    .prove__attribution {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .prove__person {
      gap: 14px;
    }

    .prove__logo {
      height: 22px;
      max-width: 110px;
    }

    .prove__source {
      min-height: 34px;
      margin-left: 0;
    }
  }

  @media (max-width: 420px) {
    .prove__controls {
      width: 100%;
      justify-content: space-between;
    }

    .prove__story {
      padding-inline: 20px;
    }

    .prove__mark {
      top: 22px;
      right: 20px;
      width: 62px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prove__button,
    .prove__story {
      transition: none;
    }
  }
</style>

<script>
  import { initializeTestimonialBrowsers } from '../util/homepage-testimonials'

  initializeTestimonialBrowsers()
  document.addEventListener('astro:page-load', () => initializeTestimonialBrowsers())
</script>
