---
import { Code } from 'astro:components'
import arrow from '../assets/banner/arrow.svg?raw'
import boxIcon from '../assets/use-cases/box.svg?raw'
import chatIcon from '../assets/use-cases/chat.svg?raw'
import hammerIcon from '../assets/use-cases/hammer.svg?raw'
import robotIcon from '../assets/use-cases/robot.svg?raw'
import LanguageToggle from './LanguageToggle.astro'

const useCases = [
  {
    id: 'workflows',
    icon: boxIcon,
    title: 'Automate workflows',
    description: 'Classify requests, route work, call tools, and complete multi-step tasks.',
    filenames: {
      TypeScript: 'route-ticket.ts',
      Python: 'route_ticket.py',
    },
    code: {
      TypeScript: `import { createHarness } from '@strands-agents/harness'
import { tool } from '@strands-agents/sdk'
import { z } from 'zod'

const routeTicket = tool({
  name: 'route_ticket',
  description: 'Route a support ticket by topic and priority.',
  inputSchema: z.object({ topic: z.string(), priority: z.string() }),
  callback: ({ topic, priority }) => {
    const queue = topic === 'billing' ? 'accounts' : 'support'
    return \`\${priority}: \${queue}\`
  },
})

const agent = await createHarness({ tools: [routeTicket] })
await agent.invoke('Route a high-priority billing ticket')`,
      Python: `from strands import tool
from strands_harness import create_harness

@tool
def route_ticket(topic: str, priority: str) -> str:
    """Route a support ticket by topic and priority."""
    queue = "accounts" if topic == "billing" else "support"
    return f"{priority}: {queue}"

agent = create_harness(tools=[route_ticket])
agent("Route a high-priority billing ticket")`,
    },
  },
  {
    id: 'assistants',
    icon: chatIcon,
    title: 'Build assistants',
    description: 'Connect models to your application, then preserve preferences with session management.',
    filenames: {
      TypeScript: 'support-agent.ts',
      Python: 'support_agent.py',
    },
    code: {
      TypeScript: `import { createHarness } from '@strands-agents/harness'

const agent = await createHarness({
  instructions: 'Answer customer questions and remember their preferences.',
  session: { id: 'customer-42' },
})

await agent.invoke('I prefer email updates.')
await agent.invoke('How should you send my order updates?')`,
      Python: `from strands_harness import create_harness

agent = create_harness(
    instructions="Answer customer questions and remember their preferences.",
    session={"id": "customer-42"},
)

agent("I prefer email updates.")
agent("How should you send my order updates?")`,
    },
  },
  {
    id: 'research',
    icon: hammerIcon,
    title: 'Research the web',
    description: 'Fetch sources, compare evidence, and return an answer with citations.',
    filenames: {
      TypeScript: 'research-agent.ts',
      Python: 'research_agent.py',
    },
    code: {
      TypeScript: `import { createHarness } from '@strands-agents/harness'

const agent = await createHarness({
  instructions: 'Compare sources and cite each URL.',
  builtinTools: { '*': false, web_fetch: true },
})

await agent.invoke(
  'Compare https://sqlite.org/whentouse.html with https://www.postgresql.org/about/'
)`,
      Python: `from strands_harness import create_harness

agent = create_harness(
    instructions="Compare sources and cite each URL.",
    builtin_tools={"*": False, "web_fetch": True},
)

agent(
    "Compare https://sqlite.org/whentouse.html "
    "with https://www.postgresql.org/about/"
)`,
    },
  },
  {
    id: 'multi-agent',
    icon: robotIcon,
    title: 'Coordinate agents',
    description: 'Turn specialist agents into tools and delegate focused work to them.',
    filenames: {
      TypeScript: 'review-team.ts',
      Python: 'review_team.py',
    },
    code: {
      TypeScript: `import { createHarness } from '@strands-agents/harness'
import { Agent } from '@strands-agents/sdk'

const reviewer = new Agent({
  name: 'reviewer',
  description: 'Reviews a proposal for risks and missing evidence.',
  systemPrompt: 'Return a short list of concrete issues.',
})

const agent = await createHarness({ tools: [reviewer.asTool()] })
await agent.invoke('Ask the reviewer to challenge our launch plan.')`,
      Python: `from strands import Agent
from strands_harness import create_harness

reviewer = Agent(
    name="reviewer",
    description="Reviews a proposal for risks and missing evidence.",
    system_prompt="Return a short list of concrete issues.",
)

agent = create_harness(tools=[reviewer.as_tool()])
agent("Ask the reviewer to challenge our launch plan.")`,
    },
  },
]
---

<section class="use-cases" aria-labelledby="use-cases-title" data-use-cases>
  <div class="use-cases__inner">
    <header class="use-cases__intro">
      <p class="use-cases__eyebrow">See it in code</p>
      <h2 id="use-cases-title">Build agents for real work.</h2>
    </header>

    <div class="use-cases__demo">
      {
        useCases.map((useCase, index) => {
          const isActive = index === 0
          const buttonId = `use-case-${useCase.id}`
          const panelId = `${buttonId}-panel`

          return (
            <article class="use-cases__case" data-use-case={useCase.id}>
              <button
                id={buttonId}
                class:list={['use-cases__button', isActive && 'is-active']}
                type="button"
                aria-expanded={isActive ? 'true' : 'false'}
                aria-controls={panelId}
                data-use-case-button
                style={`--case-row: ${index + 1}`}
              >
                <span class="use-cases__button-meta" aria-hidden="true">
                  <span class="use-cases__icon" set:html={useCase.icon}></span>
                </span>
                <span class="use-cases__button-copy">
                  <span class="use-cases__button-title">{useCase.title}</span>
                  <span class="use-cases__button-description">{useCase.description}</span>
                </span>
              </button>

              <div
                id={panelId}
                class="use-cases__panel"
                role="region"
                aria-labelledby={buttonId}
                aria-hidden={isActive ? 'false' : 'true'}
                data-use-case-panel
                hidden={!isActive}
              >
                <header class="use-cases__terminal-header">
                  <div class="use-cases__terminal-dots" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                  <p class="use-cases__filename">
                    <span data-code-filename="TypeScript">{useCase.filenames.TypeScript}</span>
                    <span data-code-filename="Python" hidden>{useCase.filenames.Python}</span>
                  </p>
                  <div class="use-cases__language">
                    <LanguageToggle />
                  </div>
                  <button
                    class="use-cases__copy"
                    type="button"
                    aria-label={`Copy ${useCase.title} code`}
                    data-code-copy
                  >
                    <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <rect x="6" y="2" width="9" height="11" rx="1.5" stroke="currentColor"></rect>
                      <rect x="3" y="5" width="9" height="11" rx="1.5" fill="#101312" stroke="currentColor"></rect>
                    </svg>
                    <span data-code-copy-label>copy</span>
                  </button>
                </header>

                <div class="use-cases__code-variant" data-code-variant="TypeScript">
                  <Code
                    code={useCase.code.TypeScript}
                    lang="typescript"
                    theme="github-dark"
                    class="use-cases__code"
                  />
                </div>
                <div class="use-cases__code-variant" data-code-variant="Python" hidden>
                  <Code code={useCase.code.Python} lang="python" theme="github-dark" class="use-cases__code" />
                </div>
              </div>
            </article>
          )
        })
      }
    </div>
    <div class="use-cases__footer">
      <a
        class="use-cases__link"
        href="https://github.com/strands-agents/samples"
        target="_blank"
        rel="noreferrer"
      >
        Browse all examples
        <span class="use-cases__arrow" set:html={arrow} aria-hidden="true"></span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .use-cases {
    padding: var(--home-section-space) var(--home-gutter);
    background: var(--bg);
    color: var(--fg);
  }

  .use-cases__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .use-cases__intro {
    margin-bottom: clamp(16px, 2vw, 22px);
  }

  .use-cases__eyebrow {
    margin: 0 0 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--home-label);
  }

  .use-cases h2 {
    max-width: 680px;
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(38px, 4.1vw, 56px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .use-cases__footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
  }

  .use-cases__link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    color: var(--accent-green);
  }

  .use-cases__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .use-cases__link:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 4px;
  }

  .use-cases__arrow {
    display: inline-flex;
    width: 11px;
  }

  .use-cases__demo {
    display: grid;
    grid-template-columns: minmax(290px, 0.72fr) minmax(0, 1.28fr);
    border-block: 1px solid var(--home-rule);
  }

  .use-cases__case {
    display: contents;
  }

  .use-cases__button {
    position: relative;
    grid-column: 1;
    grid-row: var(--case-row);
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: clamp(14px, 2vw, 22px);
    min-height: 108px;
    padding: 20px clamp(20px, 2.5vw, 30px) 20px 0;
    border: 0;
    border-right: 1px solid var(--home-rule);
    border-bottom: 1px solid var(--home-rule);
    background: transparent;
    color: color-mix(in srgb, var(--fg) 68%, transparent);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .use-cases__case:last-child .use-cases__button {
    border-bottom: 0;
  }

  .use-cases__button::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent-green);
    opacity: 0;
    content: '';
  }

  .use-cases__button:hover {
    background: color-mix(in srgb, var(--fg) 3%, transparent);
    color: var(--fg);
  }

  .use-cases__button.is-active {
    background: color-mix(in srgb, var(--accent-green) 6%, transparent);
    color: var(--fg);
  }

  .use-cases__button.is-active::before {
    opacity: 1;
  }

  .use-cases__button:focus-visible {
    z-index: 1;
    outline: 2px solid var(--accent-green);
    outline-offset: -2px;
  }

  .use-cases__button-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 58px;
    padding-left: 11px;
    color: var(--home-label);
  }

  .use-cases__button:not(.is-active) .use-cases__button-meta {
    justify-content: center;
  }

  .use-cases__icon {
    display: inline-flex;
    width: 27px;
    height: 27px;
    color: currentColor;
  }

  .use-cases__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .use-cases__icon :global(path) {
    fill: currentColor;
  }

  .use-cases__button.is-active .use-cases__button-meta {
    color: var(--accent-green);
  }

  .use-cases__button-copy {
    display: flex;
    flex-direction: column;
    align-self: center;
    gap: 7px;
  }

  .use-cases__button-title {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(19px, 1.8vw, 23px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .use-cases__button-description {
    max-width: 39ch;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.45;
    color: color-mix(in srgb, currentColor 76%, transparent);
  }

  .use-cases__panel {
    grid-column: 2;
    grid-row: 1 / span 4;
    min-width: 0;
    min-height: 432px;
    overflow: hidden;
    background: #101312;
    color: #f0f4f1;
  }

  .use-cases__panel[hidden] {
    display: none;
  }

  .use-cases__terminal-header {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 58px;
    padding: 8px 12px 8px 18px;
    border-bottom: 1px solid rgb(255 255 255 / 12%);
    background: #181c1a;
  }

  .use-cases__terminal-dots {
    display: flex;
    flex: none;
    gap: 6px;
  }

  .use-cases__terminal-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .use-cases__terminal-dots span:nth-child(1) {
    background: #eb5a61;
  }

  .use-cases__terminal-dots span:nth-child(2) {
    background: #eebd43;
  }

  .use-cases__terminal-dots span:nth-child(3) {
    background: #52cc72;
  }

  .use-cases__filename {
    min-width: 0;
    flex: 1;
    margin: 0;
    overflow: hidden;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    line-height: 1.3;
    color: rgb(240 244 241 / 72%);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .use-cases__language {
    display: flex;
    flex: none;
  }

  .use-cases__language :global(.language-toggle) {
    background: rgb(255 255 255 / 7%);
  }

  .use-cases__language :global(.lang-option) {
    min-width: 38px;
    min-height: 38px;
    padding: 7px 9px;
    border-color: rgb(255 255 255 / 12%);
    background: transparent;
    color: rgb(240 244 241 / 62%);
  }

  .use-cases__language :global(.lang-option[aria-checked='true']) {
    background: var(--strands-green);
    color: var(--strands-black);
  }

  .use-cases__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 66px;
    min-height: 40px;
    padding: 7px 10px;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 999px;
    background: transparent;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: rgb(240 244 241 / 78%);
    cursor: pointer;
  }

  .use-cases__copy:hover {
    border-color: rgb(255 255 255 / 36%);
    color: #fff;
  }

  .use-cases__copy:focus-visible {
    outline: 2px solid var(--strands-green);
    outline-offset: 2px;
  }

  .use-cases__copy.is-copied {
    border-color: var(--strands-green);
    color: var(--strands-green);
  }

  .use-cases__copy svg {
    width: 15px;
    height: 15px;
  }

  .use-cases__code-variant {
    height: 374px;
    overflow: auto;
    scrollbar-color: rgb(255 255 255 / 18%) transparent;
    scrollbar-width: thin;
  }

  .use-cases__code-variant[hidden] {
    display: none;
  }

  .use-cases__code-variant :global(.use-cases__code) {
    min-width: max-content;
    min-height: 100%;
    margin: 0;
    padding: clamp(18px, 2.4vw, 28px);
    border: 0;
    border-radius: 0;
    background: transparent !important;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.65;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .use-cases__demo {
      grid-template-columns: minmax(250px, 0.72fr) minmax(0, 1.28fr);
    }

    .use-cases__button {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 12px;
      padding-right: 18px;
    }

    .use-cases__button-meta {
      padding-left: 6px;
    }

    .use-cases__button-description {
      font-size: 12px;
    }

    .use-cases__terminal-dots {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .use-cases__intro {
      margin-bottom: 18px;
    }

    .use-cases h2 {
      font-size: clamp(34px, 10.5vw, 42px);
    }

    .use-cases__demo {
      display: block;
    }

    .use-cases__case {
      display: block;
    }

    .use-cases__button {
      display: grid;
      width: 100%;
      min-height: 80px;
      padding: 16px 12px 16px 0;
      border-right: 0;
      border-bottom: 1px solid var(--home-rule);
    }

    .use-cases__case:last-child .use-cases__button {
      border-bottom: 1px solid var(--home-rule);
    }

    .use-cases__button-meta {
      min-height: 48px;
    }

    .use-cases__button-title {
      font-size: 20px;
    }

    .use-cases__button-description {
      display: none;
    }

    .use-cases__button.is-active .use-cases__button-description {
      display: block;
    }

    .use-cases__panel {
      min-height: 0;
      border-bottom: 1px solid var(--home-rule);
    }

    .use-cases__terminal-header {
      min-height: 56px;
      padding-inline: 12px;
    }

    .use-cases__code-variant {
      height: min(330px, 68vh);
    }

    .use-cases__code-variant :global(.use-cases__code) {
      padding: 18px 16px;
      font-size: 11px;
      line-height: 1.65;
    }
  }

  @media (max-width: 430px) {
    .use-cases__filename {
      font-size: 10px;
    }

    .use-cases__language :global(.language-toggle) {
      gap: 0;
      padding: 2px;
    }

    .use-cases__language :global(.lang-option) {
      min-width: 34px;
      min-height: 34px;
      padding: 5px 7px;
    }

    .use-cases__language :global(.lang-icon svg) {
      width: 16px;
      height: 16px;
    }

    .use-cases__copy {
      min-width: 38px;
      min-height: 38px;
      padding: 7px;
    }

    .use-cases__copy span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .use-cases__button {
      transition: none;
    }
  }
</style>

<script>
  import { initializeUseCases } from '../util/homepage-use-cases'

  initializeUseCases()
  document.addEventListener('astro:page-load', () => initializeUseCases())
</script>
