---
import arrow from '../assets/banner/arrow.svg?raw'
import shape from '../assets/next-steps/shape.svg?raw'
import shapeMobile from '../assets/next-steps/shape-mobile.svg?raw'
import { products } from '../config/navbar'
import InstallCommand from './InstallCommand.astro'

const harness = products.find((product) => product.slug === '/harness')
const quickstart = harness?.pages?.find((page) => page.label === 'Quickstart')
if (!harness || !quickstart) throw new Error('Missing Harness navigation targets')
---

<section class="next-steps" aria-labelledby="next-steps-title">
  <div class="next-steps__shape next-steps__shape--desktop" aria-hidden="true" set:html={shape}></div>
  <div class="next-steps__shape next-steps__shape--mobile" aria-hidden="true" set:html={shapeMobile}></div>
  <div class="next-steps__content">
    <p class="next-steps__eyebrow">Start with Harness</p>
    <h2 id="next-steps-title" class="next-steps__title">Build your first agent.</h2>
    <p class="next-steps__lede">
      Install Harness and run the quickstart. Override individual defaults with Harness SDK components to customize the
      agent loop.
    </p>
    <div class="next-steps__install">
      <span class="next-steps__install-label">Install Harness</span>
      <InstallCommand pip="pip install strands-harness" npm="npm install @strands-agents/harness" />
    </div>
    <div class="next-steps__ctas">
      <a href={quickstart.href} class="next-steps__cta next-steps__cta--primary">
        Quickstart
        <span class="next-steps__cta-arrow" set:html={arrow} />
      </a>
      <a
        href={harness.repository}
        class="next-steps__cta next-steps__cta--secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
        <span class="next-steps__cta-arrow" set:html={arrow} />
      </a>
    </div>
  </div>
</section>

<style>
  .next-steps {
    position: relative;
    min-height: 410px;
    padding: var(--home-section-space) var(--home-gutter) clamp(58px, 6vw, 80px);
    overflow: hidden;
    background: var(--strands-black);
    color: var(--strands-white);
  }

  .next-steps__shape {
    position: absolute;
    z-index: 0;
    left: 50%;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .next-steps__shape :global([fill='#00CC60']) {
    fill: var(--surface-green);
  }

  .next-steps__shape :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .next-steps__shape--desktop {
    inset-block: 0;
  }

  .next-steps__shape--mobile {
    display: none;
  }

  .next-steps__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .next-steps__eyebrow {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--strands-green);
  }

  .next-steps__title {
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(38px, 4.2vw, 58px);
    font-weight: 600;
    letter-spacing: var(--home-heading-tracking);
    line-height: 1.02;
  }

  .next-steps__lede {
    max-width: 650px;
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: var(--home-body-size);
    line-height: 1.5;
    color: rgb(255 255 255 / 72%);
  }

  .next-steps__install {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }

  .next-steps__install-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
    color: rgb(255 255 255 / 56%);
  }

  .next-steps__install :global(.install) {
    background: rgb(255 255 255 / 8%);
    border-color: rgb(255 255 255 / 18%);
  }

  .next-steps__install :global(.install__cmd) {
    color: var(--strands-white);
  }

  .next-steps__install :global(.install__prompt) {
    color: var(--strands-green);
  }

  .next-steps__install :global(.install__copy) {
    background: rgb(255 255 255 / 9%);
    border-color: rgb(255 255 255 / 16%);
    color: var(--strands-white);
  }

  .next-steps__install :global(.install__copy:hover) {
    background: rgb(255 255 255 / 16%);
  }

  .next-steps__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 2px;
  }

  .next-steps__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid rgb(255 255 255 / 40%);
    border-radius: 999px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--strands-white);
    text-decoration: none;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease;
  }

  .next-steps__cta:hover {
    transform: translateY(-2px);
  }

  .next-steps__cta:focus-visible {
    outline: 2px solid var(--strands-green);
    outline-offset: 4px;
  }

  .next-steps__cta--primary {
    border-color: var(--strands-green);
    background: var(--strands-green);
    color: var(--strands-black);
  }

  .next-steps__cta--secondary {
    background: transparent;
  }

  .next-steps__cta-arrow {
    display: inline-flex;
    width: 12px;
    height: 10px;
  }

  .next-steps__cta-arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1023px) {
    .next-steps {
      min-height: 0;
    }

    .next-steps__shape--desktop {
      display: none;
    }

    .next-steps__shape--mobile {
      display: block;
      inset: auto 0 -1px;
      height: 112px;
    }
  }

  @media (max-width: 767px) {
    .next-steps {
      padding-block: var(--home-section-space) 78px;
    }

    .next-steps__content {
      align-items: stretch;
      gap: 12px;
      text-align: left;
    }

    .next-steps__install {
      align-items: stretch;
    }

    .next-steps__ctas {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .next-steps__cta {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .next-steps__install :global(.install) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      padding: 12px;
      border-radius: 18px;
    }

    .next-steps__install :global(.install__cmd) {
      width: 100%;
      padding-bottom: 3px;
      font-size: 12px;
      scrollbar-width: thin;
    }

    .next-steps__install :global(.install__cmd)::-webkit-scrollbar {
      display: block;
      height: 4px;
    }

    .next-steps__install :global(.install__cmd)::-webkit-scrollbar-thumb {
      background: var(--toggle-inactive-border);
      border-radius: 999px;
    }

    .next-steps__install :global(.install__copy) {
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next-steps__cta {
      transition: none;
    }

    .next-steps__cta:hover {
      transform: none;
    }
  }
</style>
