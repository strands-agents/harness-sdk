---
export interface BulletinItem {
  type: 'event' | 'post' | 'integration' | 'hackathon'
  kicker: string
  title: string
  href?: string
  // ISO date after which the client expiry script removes the row
  expires?: string
}

interface Props {
  items: BulletinItem[]
}

const { items } = Astro.props
---

{
  items.length > 0 && (
    <div class="bulletin">
      <div class="inner">
        <b class="lbl">What's new</b>
        {items.map((item) => {
          const label = (
            <>
              <span class={`icon icon--${item.type}`} aria-hidden="true">
                {item.type === 'event' ? (
                  <svg viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3">
                    <rect x="1.5" y="2.5" width="13" height="12" rx="2" />
                    <path d="M1.5 6.5h13M5 1v3M11 1v3" />
                    <circle cx="8" cy="10.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                ) : item.type === 'post' ? (
                  <svg viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3">
                    <path d="M2.5 13.5l.9-2.9 7.6-7.6a1.4 1.4 0 0 1 2 2l-7.6 7.6z" />
                    <path d="M9.8 4.2l2 2" />
                  </svg>
                ) : item.type === 'hackathon' ? (
                  <svg viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
                    <rect x="1.5" y="2.5" width="13" height="9" rx="1.5" />
                    <path d="M5.5 14.5h5M8 11.5v3" stroke-linecap="round" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3">
                    <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2" />
                    <rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2" />
                    <rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2" />
                    <rect x="9" y="9" width="5.5" height="5.5" rx="1.2" stroke-dasharray="2.5 1.8" />
                  </svg>
                )}
              </span>
              <span class="text">
                <span class="kicker">{item.kicker}</span>
                <span class="title">{item.title}</span>
              </span>
            </>
          )
          return item.href ? (
            <a class="row" href={item.href} data-expires={item.expires}>
              {label}
            </a>
          ) : (
            <span class="row" data-expires={item.expires}>
              {label}
            </span>
          )
        })}
      </div>
    </div>
  )
}

<style>
  /* News-bulletin card filling the hero's right column. */
  .bulletin {
    width: 100%;
    max-width: 24rem;
    background: rgba(12, 26, 17, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(44, 89, 64, 0.5);
    border-radius: 14px;
    padding: 1.375rem 1.5rem 1.125rem;
    font-family: 'Figtree', sans-serif;
    color: #a9c4b3;
  }

  :global([data-theme='light']) .bulletin {
    background: rgba(0, 204, 95, 0.04);
    border-color: rgba(0, 133, 66, 0.25);
    color: var(--sl-color-gray-2);
  }

  .inner {
    display: flex;
    flex-direction: column;
  }

  .lbl {
    color: #00cc5f;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.7rem;
    padding-bottom: 0.375rem;
  }

  :global([data-theme='light']) .lbl {
    color: #008542;
  }

  .row {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem 0;
    border-top: 1px solid rgba(157, 181, 167, 0.15);
    font-size: 0.9375rem;
    color: inherit;
    text-decoration: none;
  }

  :global([data-theme='light']) .row {
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  .icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    border: 1px solid;
  }

  .icon--event {
    color: #d8b25e;
    background: rgba(216, 178, 94, 0.08);
    border-color: rgba(216, 178, 94, 0.25);
  }

  .icon--post {
    color: #00cc5f;
    background: rgba(0, 204, 95, 0.08);
    border-color: rgba(0, 204, 95, 0.25);
  }

  .icon--integration {
    color: #7fb8d8;
    background: rgba(127, 184, 216, 0.08);
    border-color: rgba(127, 184, 216, 0.25);
  }

  .icon--hackathon {
    color: #b79ce0;
    background: rgba(183, 156, 224, 0.08);
    border-color: rgba(183, 156, 224, 0.25);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  :global([data-theme='light']) .icon--event {
    color: #8a6d1f;
    background: rgba(138, 109, 31, 0.07);
    border-color: rgba(138, 109, 31, 0.25);
  }

  :global([data-theme='light']) .icon--post {
    color: #008542;
    background: rgba(0, 133, 66, 0.06);
    border-color: rgba(0, 133, 66, 0.25);
  }

  :global([data-theme='light']) .icon--integration {
    color: #23648f;
    background: rgba(35, 100, 143, 0.06);
    border-color: rgba(35, 100, 143, 0.25);
  }

  :global([data-theme='light']) .icon--hackathon {
    color: #6b4ea0;
    background: rgba(107, 78, 160, 0.06);
    border-color: rgba(107, 78, 160, 0.25);
  }

  .kicker {
    color: #d8b25e;
    font-weight: 700;
    font-size: 0.71875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global([data-theme='light']) .kicker {
    color: #8a6d1f;
  }

  .title {
    color: #cfe0d6;
    line-height: 1.35;
  }

  :global([data-theme='light']) .title {
    color: var(--sl-color-gray-1);
  }

  a.row:hover .title {
    color: #00ff77;
  }

  :global([data-theme='light']) a.row:hover .title {
    color: #008542;
  }


  @media (max-width: 900px) {
    .bulletin {
      max-width: none;
    }
  }
</style>
