---
/**
 * PageFrame override — matches Starlight's default PageFrame. The homepage
 * carries the full site footer; docs pages omit it to keep the reading view
 * focused.
 *
 * Integrations: catalog pages carry the (empty) dialog that integration docs
 * open in. An integration docs page puts its main column in that dialog, with
 * its type's catalog in the main frame behind it.
 */
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle'
import IntegrationModal from '../IntegrationModal.astro'
import CatalogBackdrop from '../catalog/CatalogBackdrop.astro'
import { currentProduct } from '../../util/current-product'
import { catalogTypePath, integrationPageType, isCatalogPath } from '../../util/catalog-routes'
import { pathWithBase } from '../../util/links'

const { hasSidebar, id } = Astro.locals.starlightRoute
const integrationType = integrationPageType(id)
const isCatalog = isCatalogPath(Astro.url.pathname)

// Product accent for the docs chrome (styled in custom.css). Labs is not a
// product; the path check mirrors the /labs slug in Sidebar.astro.
const accent =
  currentProduct(Astro.url.pathname)?.accent ??
  (Astro.url.pathname.includes('/docs/labs') ? 'blue' : undefined)
---

<div class="page sl-flex" data-accent={accent}>
  {
    /* An integration docs page leads with its dialog, so the docs stream in and
       paint before the catalog behind them (which can be larger than the docs). */
    integrationType && (
      <IntegrationModal open closeHref={pathWithBase(catalogTypePath(integrationType))}>
        <slot />
      </IntegrationModal>
    )
  }
  <header class="header"><slot name="header" /></header>
  {hasSidebar && (
    <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
      <MobileMenuToggle />
      <div id="starlight__sidebar" class="sidebar-pane">
        <div class="sidebar-content sl-flex">
          <slot name="sidebar" />
        </div>
      </div>
    </nav>
  )}
  {
    integrationType ? (
      <div class="main-frame">
        <CatalogBackdrop type={integrationType} />
      </div>
    ) : (
      <div class="main-frame">
        <slot />
      </div>
    )
  }
  {isCatalog && <IntegrationModal closeHref={Astro.url.pathname} />}
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
    }

    :global([aria-expanded='true']) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 0;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
      flex: 1;
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }
</style>
