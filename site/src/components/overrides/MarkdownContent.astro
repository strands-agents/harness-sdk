---
import '@astrojs/starlight/style/markdown.css';
import CommunityContributionAside from '../CommunityContributionAside.astro';
import IntegrationsBackLink from '../IntegrationsBackLink.astro';
import LanguageSupportAside from '../LanguageSupportAside.astro';
import ExperimentalAside from '../ExperimentalAside.astro';
import PageTags from '../PageTags.astro';

const { starlightRoute } = Astro.locals;
const { languages, community, experimental } = starlightRoute.entry.data;
// Integration doc pages render without the docs sidebar (see route-middleware.ts);
// the back strip is their route to the /integrations catalog. get-featured is
// excepted — it renders inside the catalog rail, so the sidebar is its way back.
const isIntegrationsPage =
  starlightRoute.id !== 'docs/integrations/get-featured' &&
  (starlightRoute.id === 'docs/integrations' || starlightRoute.id.startsWith('docs/integrations/'));

const ALL_SDK_LANGUAGES = ['python', 'typescript']
const langArray = languages
  ? (Array.isArray(languages) ? languages : [languages]).map((l: string) => l.toLowerCase())
  : []
const coversAllLanguages = ALL_SDK_LANGUAGES.every((l) => langArray.includes(l))
---

<div class="sl-markdown-content">
  {isIntegrationsPage && <IntegrationsBackLink />}
  {experimental && <ExperimentalAside />}
  {community && <CommunityContributionAside />}
  {/* Language support aside is omitted for community pages — the CommunityContributionAside already
      contextualizes the page, and language support is listed in the community catalog table instead. */}
  {languages && !community && !coversAllLanguages && <LanguageSupportAside languages={languages} />}
  <slot />
  <PageTags />
</div>
