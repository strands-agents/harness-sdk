---
/**
 * Footer override — Starlight's default footer (edit link, last updated,
 * pagination) followed by the compact site footer. Docs pages skip the full
 * homepage footer, so this keeps the current release, a route to help, and the
 * legal links in reach without pulling the reader out of the docs. Integration
 * docs pages skip the site footer: they show in a dialog over a catalog that
 * has its own.
 */
import Default from '@astrojs/starlight/components/Footer.astro'
import SiteFooter from '../SiteFooter.astro'
import { integrationPageType } from '../../util/catalog-routes'

const inDialog = !!integrationPageType(Astro.locals.starlightRoute.id)
---

<Default />
{!inDialog && <SiteFooter pathname={Astro.url.pathname} />}
