---
/**
 * Custom Head override to add Mermaid diagram support, favicon, AWS Shortbread cookie consent,
 * and structured data (JSON-LD).
 * See SITE-ARCHITECTURE.md for details.
 */
import { getCollection } from 'astro:content'
import SiteScripts from '../SiteScripts.astro'
import Analytics from '../Analytics.astro'
import { baseSchemas } from '../../util/structured-data'
import { getDocsIds } from '../../util/docs-ids'
import { relatedUserGuideFor } from '../../util/related-docs'
import { resolveLanguage, sourceLinkUrl } from '../../util/source-links'
import type { SourceLink } from '../../content.config'

const { head } = Astro.locals.starlightRoute
const route = Astro.locals.starlightRoute

// Get base path for favicon
const base = import.meta.env.BASE_URL || '/'
const faviconHref = base.endsWith('/') ? `${base}favicon.svg` : `${base}/favicon.svg`

// Raw markdown twin served by src/pages/[...slug]/index.md.ts — one endpoint per docs
// collection entry, at `/{entry.id}/index.md`. Only advertise it for routes backed by a
// docs entry (blog/changelog pages flow through Starlight with synthetic entries).
const docIds = await getDocsIds()
const baseNoSlash = base.replace(/\/$/, '')
const markdownHref = docIds.has(route.entry.id) ? `${baseNoSlash}/${route.entry.id}/index.md` : null

// Build breadcrumb list from URL path
const siteUrl = Astro.site?.origin || 'https://strandsagents.com'
const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean)
const breadcrumbLabels: Record<string, string> = {
  'docs': 'Docs',
  'user-guide': 'User Guide',
  'concepts': 'Concepts',
  'agents': 'Agents',
  'tools': 'Tools',
  'multi-agent': 'Multi-Agent',
  'model-providers': 'Model Providers',
  'streaming': 'Streaming',
  'bidi': 'Voice',
  'deploy': 'Deploy',
  'safety-security': 'Safety & Security',
  'observability-evaluation': 'Observability',
  'evals-sdk': 'Evals SDK',
  'examples': 'Examples',
  'community': 'Community',
  'labs': 'Labs',
  'contribute': 'Contribute',
  'api': 'API Reference',
  'plugins': 'Plugins',
  'quickstart': 'Quickstart',
  'experimental': 'Experimental',
  'python': 'Python',
  'typescript': 'TypeScript',
  'integrations': 'Integrations',
  'session-managers': 'Session Managers',
  'contributing': 'Contributing',
}

const breadcrumbItems = pathSegments.map((segment, i) => {
  const path = '/' + pathSegments.slice(0, i + 1).join('/') + '/'
  const isLast = i === pathSegments.length - 1
  const name = isLast
    ? (route.entry.data.title || segment)
    : (breadcrumbLabels[segment] || segment.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()))
  return {
    "@type": "ListItem" as const,
    position: i + 1,
    name,
    ...(isLast ? {} : { item: siteUrl + path })
  }
})

// TechArticle node for docs pages with tags or sourceLinks. Reaches HTML-only
// crawlers that don't follow the llms.txt convention.
//
// Schema reference for the fields used below:
//   TechArticle:        https://schema.org/TechArticle
//   keywords:           https://schema.org/keywords
//   relatedLink:        https://schema.org/relatedLink
//   isBasedOn:          https://schema.org/isBasedOn
//   SoftwareSourceCode: https://schema.org/SoftwareSourceCode
//   programmingLanguage: https://schema.org/programmingLanguage
const entry = route.entry
// Non-docs routes (blog authors/tags pages, etc.) flow through Starlight too
// but their synthetic entry.data has no `tags` field — guard with ??.
const tags = entry.data.tags ?? []
const sourceLinks = entry.data.sourceLinks ?? []
let techArticle: Record<string, unknown> | null = null
if (tags.length > 0 || sourceLinks.length > 0) {
  const related = tags.length > 0
    ? relatedUserGuideFor(entry, await getCollection('docs'))
    : []
  techArticle = {
    "@type": "TechArticle",
    "headline": entry.data.title,
    "url": siteUrl + Astro.url.pathname,
    ...(tags.length > 0 ? { "keywords": tags.join(', ') } : {}),
    ...(entry.data.description ? { "description": entry.data.description } : {}),
    ...(related.length > 0
      ? { "relatedLink": related.map((r) => siteUrl + '/' + r.slug + '/') }
      : {}),
    ...(sourceLinks.length > 0
      ? {
          "isBasedOn": sourceLinks.map((s: SourceLink) => ({
            "@type": "SoftwareSourceCode",
            "programmingLanguage": resolveLanguage(s),
            "codeRepository": `https://github.com/strands-agents/${s.repo}`,
            "url": sourceLinkUrl(s),
          })),
        }
      : {}),
  }
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...baseSchemas(siteUrl),
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems
    },
    ...(techArticle ? [techArticle] : []),
  ]
}
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<!-- Favicon: green frog on a black tile so it stays legible on light backgrounds. -->
<link rel="icon" type="image/svg+xml" href={faviconHref} />

<!-- Raw markdown twin of this page, for LLMs and tooling -->
{markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}

<!-- AWS Shortbread cookie consent -->
<SiteScripts />

<!-- Analytics instrumentation (site sections, anchors, search, scroll, nav) -->
<Analytics />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Embed mode: with `?embed` in the URL the page renders chromeless (no site
     header/sidebar/TOC/footers) for the /integrations docs drawer iframe. The
     site is statically built, so the switch must run client-side: this inline
     script sets `data-embed` on <html> before first paint and CSS in
     custom.css hides the chrome. Without JS the page renders normally. -->
<script is:inline>
  if (new URLSearchParams(location.search).has('embed')) {
    document.documentElement.dataset.embed = ''
    // The full page URL is canonical; keep embed views out of search indexes.
    const meta = document.createElement('meta')
    meta.name = 'robots'
    meta.content = 'noindex'
    document.head.appendChild(meta)
    // In-article links navigate the embedding page, not the iframe (same-page
    // anchor links keep scrolling inside the embed).
    addEventListener('DOMContentLoaded', () => {
      for (const a of document.querySelectorAll('a[href]')) {
        const href = a.getAttribute('href') || ''
        if (!href.startsWith('#') && !a.target) a.target = '_parent'
      }
    })
  }
</script>

<script>
  const mermaidBlocks = [...document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]')]

  // Keep Mermaid in a lazy chunk so pages without diagrams do not download it.
  // The source blocks stay intact if the import fails.
  if (mermaidBlocks.length > 0) {
    const { default: mermaid } = await import('mermaid')
    type DiagramTheme = 'light' | 'dark'

    const root = document.documentElement
    const sources = new WeakMap<HTMLElement, string>()
    const labels = new WeakMap<HTMLElement, string>()
    const frames = new WeakMap<HTMLElement, HTMLElement>()
    const scrollers = new WeakMap<HTMLElement, HTMLElement>()
    const expandButtons = new WeakMap<HTMLElement, HTMLButtonElement>()
    const renderedThemes = new WeakMap<HTMLElement, DiagramTheme>()
    const pending = new Set<HTMLElement>()
    // Preserve at least a 12px visual label size from the 15px diagram type scale.
    const minimumScale = 0.8
    const expandedMaximumScale = 1.25
    let renderTask: Promise<void> | undefined
    let renderId = 0

    const dialog = document.createElement('dialog')
    const dialogSurface = document.createElement('div')
    const dialogHeader = document.createElement('header')
    const dialogTitle = document.createElement('h2')
    const dialogClose = document.createElement('button')
    const dialogViewport = document.createElement('div')

    dialog.id = 'mermaid-dialog'
    dialog.className = 'mermaid-dialog'
    dialog.setAttribute('aria-labelledby', 'mermaid-dialog-title')
    dialogSurface.className = 'mermaid-dialog__surface'
    dialogHeader.className = 'mermaid-dialog__header'
    dialogTitle.id = 'mermaid-dialog-title'
    dialogTitle.className = 'mermaid-dialog__title'
    dialogTitle.textContent = 'Diagram'
    dialogClose.className = 'mermaid-dialog__close'
    dialogClose.type = 'button'
    dialogClose.textContent = 'Close'
    dialogViewport.className = 'mermaid-dialog__viewport'
    dialogHeader.append(dialogTitle, dialogClose)
    dialogSurface.append(dialogHeader, dialogViewport)
    dialog.append(dialogSurface)
    document.body.append(dialog)

    let expandedDiagram: HTMLElement | undefined
    let expandedOpener: HTMLButtonElement | undefined
    let originalBlockSize = ''
    let originalScrollLeft = 0
    let originalScrollTop = 0
    let restoreFocusOnClose = true

    const diagramLabel = (block: HTMLElement) => {
      let heading = 'Documentation'
      for (const candidate of document.querySelectorAll<HTMLElement>('h1, h2, h3, h4, h5, h6')) {
        if (!(candidate.compareDocumentPosition(block) & Node.DOCUMENT_POSITION_FOLLOWING)) break
        heading = candidate.textContent?.trim() || heading
      }

      const panel = block.closest<HTMLElement>('[role="tabpanel"]')
      const tabId = panel?.getAttribute('aria-labelledby')
      const tab = tabId ? document.getElementById(tabId)?.textContent?.trim() : undefined
      return tab ? `${heading} diagram (${tab})` : `${heading} diagram`
    }

    const diagrams = mermaidBlocks.map((block, index) => {
      const lines = [...block.querySelectorAll<HTMLElement>('code > .ec-line')]
      const source = lines.length > 0 ? lines.map((line) => line.textContent ?? '').join('\n') : block.textContent ?? ''
      const label = diagramLabel(block)
      const frame = document.createElement('figure')
      const caption = document.createElement('figcaption')
      const actions = document.createElement('div')
      const expandButton = document.createElement('button')
      const expandIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
      const expandIconPath = document.createElementNS('http://www.w3.org/2000/svg', 'path')
      const scroller = document.createElement('div')
      const diagram = document.createElement('div')

      frame.className = 'mermaid-frame'
      caption.id = `mermaid-caption-${index + 1}`
      caption.className = 'mermaid-caption'
      caption.textContent = label
      actions.className = 'mermaid-actions'
      actions.hidden = true
      expandButton.className = 'mermaid-expand'
      expandButton.type = 'button'
      expandButton.title = 'View larger'
      expandButton.hidden = true
      expandButton.setAttribute('aria-haspopup', 'dialog')
      expandButton.setAttribute('aria-controls', dialog.id)
      expandButton.setAttribute('aria-label', `View ${label} in a larger dialog`)
      expandIcon.classList.add('mermaid-expand__icon')
      expandIcon.setAttribute('viewBox', '0 0 24 24')
      expandIcon.setAttribute('aria-hidden', 'true')
      expandIcon.setAttribute('focusable', 'false')
      expandIconPath.setAttribute(
        'd',
        'M8 3H4a1 1 0 0 0-1 1v4m13-5h4a1 1 0 0 1 1 1v4m0 8v4a1 1 0 0 1-1 1h-4M8 21H4a1 1 0 0 1-1-1v-4',
      )
      expandIconPath.setAttribute('fill', 'none')
      expandIconPath.setAttribute('stroke', 'currentColor')
      expandIconPath.setAttribute('stroke-linecap', 'round')
      expandIconPath.setAttribute('stroke-linejoin', 'round')
      expandIconPath.setAttribute('stroke-width', '1.75')
      scroller.className = 'mermaid-scroll'
      diagram.className = 'mermaid'
      diagram.dataset.mermaidDiagram = ''
      diagram.textContent = source
      frame.setAttribute('aria-labelledby', caption.id)
      expandIcon.append(expandIconPath)
      expandButton.append(expandIcon)
      actions.append(expandButton)
      scroller.append(diagram)
      frame.append(caption, scroller, actions)
      const renderedBlock = block.closest<HTMLElement>('.expressive-code') ?? block
      renderedBlock.replaceWith(frame)
      sources.set(diagram, source)
      labels.set(diagram, label)
      frames.set(diagram, frame)
      scrollers.set(diagram, scroller)
      expandButtons.set(diagram, expandButton)

      return diagram
    })

    const currentTheme = (): DiagramTheme => (root.dataset.theme === 'dark' ? 'dark' : 'light')
    const isVisible = (diagram: HTMLElement) => diagram.isConnected && diagram.closest('[hidden]') === null
    const visibleDiagrams = () => diagrams.filter(isVisible)
    const usesCompactFlowchartLayout = (source: string) => {
      if (!/^\s*(?:flowchart|graph)\b/m.test(source)) return false

      const edgeCount = source.match(/-->|<-->|-\.->|==>/g)?.length ?? 0
      const subgraphCount = source.match(/^\s*subgraph\b/gm)?.length ?? 0
      return edgeCount >= 8 || subgraphCount >= 3
    }

    const buildMermaidConfig = (theme: DiagramTheme, compact: boolean): import('mermaid').MermaidConfig => {
      const css = getComputedStyle(root)
      const token = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback
      const fontFamily = '"Space Grotesk", system-ui, sans-serif'
      const flowchartSpacing = compact
        ? { diagramPadding: 6, nodeSpacing: 16, rankSpacing: 20, padding: 6 }
        : { diagramPadding: 8, nodeSpacing: 24, rankSpacing: 28, padding: 10 }

      const canvas = token('--diagram-canvas', theme === 'dark' ? '#111212' : '#fbfcfb')
      const frameBorder = token('--diagram-frame-border', theme === 'dark' ? '#3d3c3c' : '#d9d9d9')
      const nodeBackground = token('--diagram-node-bg', theme === 'dark' ? '#28292a' : '#f4f4f4')
      const nodeBorder = token('--diagram-node-border', theme === 'dark' ? '#999696' : '#767373')
      const text = token('--diagram-text', theme === 'dark' ? '#f4f4f4' : '#28292a')
      const clusterBackground = token('--diagram-cluster-bg', theme === 'dark' ? '#07180d' : '#f2faf3')
      const clusterBorder = token('--diagram-cluster-border', theme === 'dark' ? '#487651' : '#62856a')
      const edge = token('--diagram-edge', theme === 'dark' ? '#b6b6b6' : '#666464')
      const labelBackground = token('--diagram-label-bg', canvas)
      const accentBackground = token('--diagram-accent-bg', theme === 'dark' ? '#0d3010' : '#e6f6e7')
      const accentBorder = token('--diagram-accent-border', theme === 'dark' ? '#00cc60' : '#007a3d')
      const noteBackground = token('--diagram-note-bg', theme === 'dark' ? '#342600' : '#fff7d6')
      const noteBorder = token('--diagram-note-border', theme === 'dark' ? '#f6bc00' : '#946e00')
      const noteText = token('--diagram-note-text', theme === 'dark' ? '#fff3c4' : '#3d2f00')

      return {
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        look: 'classic',
        htmlLabels: true,
        fontFamily,
        themeVariables: {
          background: canvas,
          fontFamily,
          fontSize: '15px',
          primaryColor: nodeBackground,
          primaryTextColor: text,
          primaryBorderColor: nodeBorder,
          secondaryColor: clusterBackground,
          secondaryTextColor: text,
          secondaryBorderColor: clusterBorder,
          tertiaryColor: canvas,
          tertiaryTextColor: text,
          tertiaryBorderColor: frameBorder,
          textColor: text,
          titleColor: text,
          lineColor: edge,
          arrowheadColor: edge,
          mainBkg: nodeBackground,
          nodeBkg: nodeBackground,
          nodeBorder,
          nodeTextColor: text,
          defaultLinkColor: edge,
          clusterBkg: clusterBackground,
          clusterBorder,
          edgeLabelBackground: labelBackground,
          actorBkg: nodeBackground,
          actorBorder: nodeBorder,
          actorTextColor: text,
          actorLineColor: edge,
          signalColor: edge,
          signalTextColor: text,
          labelBoxBkgColor: clusterBackground,
          labelBoxBorderColor: clusterBorder,
          labelTextColor: text,
          loopTextColor: text,
          noteBkgColor: noteBackground,
          noteBorderColor: noteBorder,
          noteTextColor: noteText,
          activationBkgColor: accentBackground,
          activationBorderColor: accentBorder,
          sequenceNumberColor: text,
          strokeWidth: 1.25,
          useGradient: false,
          dropShadow: 'none',
        },
        themeCSS: `
          .node .label, .nodeLabel { font-weight: 500; line-height: 1.25; }
          .node rect[rx='0'] { rx: 6px; ry: 6px; }
          .cluster rect { rx: 10px; ry: 10px; stroke-width: 1.25px; }
          .cluster-label { font-size: 15px; font-weight: 600; }
          .flowchart-link { stroke-width: 1.5px; }
          .edgeLabel { font-size: 15px; }
          .edgeLabel p { margin: 0; padding: 1px 4px; border-radius: 4px; line-height: 1.2; }
          .flowchartTitleText { font-size: 15px; font-weight: 600; }
          .actor { rx: 6px; ry: 6px; }
          .actor-line { stroke-width: 1px; stroke-dasharray: 4 4; }
          .messageText { font-size: 15px; }
          .note { rx: 6px; ry: 6px; stroke-width: 1px; }
        `,
        flowchart: {
          useMaxWidth: false,
          ...flowchartSpacing,
          curve: 'linear',
          wrappingWidth: 140,
        },
        sequence: {
          useMaxWidth: false,
          diagramMarginX: 24,
          diagramMarginY: 16,
          actorMargin: 40,
          width: 140,
          height: 52,
          boxMargin: 10,
          boxTextMargin: 6,
          noteMargin: 12,
          messageMargin: 32,
          mirrorActors: false,
          actorFontSize: 15,
          actorFontFamily: fontFamily,
          actorFontWeight: 500,
          noteFontSize: 15,
          noteFontFamily: fontFamily,
          messageFontSize: 15,
          messageFontFamily: fontFamily,
          wrap: true,
          wrapPadding: 10,
        },
      }
    }

    const updateScrollable = (scroller: HTMLElement) => {
      const overflows =
        scroller.scrollWidth > scroller.clientWidth + 1 || scroller.scrollHeight > scroller.clientHeight + 1
      scroller.classList.toggle('is-scrollable', overflows)

      if (overflows) {
        const diagram = scroller.querySelector<HTMLElement>('[data-mermaid-diagram]')
        scroller.tabIndex = 0
        scroller.setAttribute('role', 'region')
        const label = (diagram && labels.get(diagram)) || 'Diagram'
        scroller.setAttribute('aria-label', scroller === dialogViewport ? `Expanded ${label}` : label)
      } else {
        scroller.removeAttribute('tabindex')
        scroller.removeAttribute('role')
        scroller.removeAttribute('aria-label')
      }
    }

    const svgDimensions = (svg: SVGSVGElement) => {
      const positiveNumber = (value: string | null) => {
        if (!value || value.trim().endsWith('%')) return undefined
        const parsed = Number.parseFloat(value)
        return Number.isFinite(parsed) && parsed > 0 ? parsed : undefined
      }
      const viewBox = svg
        .getAttribute('viewBox')
        ?.trim()
        .split(/[\s,]+/)
        .map(Number)
      const viewBoxWidth = viewBox?.length === 4 && viewBox[2] > 0 ? viewBox[2] : undefined
      const viewBoxHeight = viewBox?.length === 4 && viewBox[3] > 0 ? viewBox[3] : undefined
      const width = positiveNumber(svg.getAttribute('width')) ?? viewBoxWidth
      const height = positiveNumber(svg.getAttribute('height')) ?? viewBoxHeight
      return width && height ? { width, height } : undefined
    }

    const fitDiagram = (diagram: HTMLElement) => {
      const scroller = diagram.parentElement
      const svg = diagram.querySelector<SVGSVGElement>('svg')
      if (!scroller || !svg) return

      const dimensions = svgDimensions(svg)
      if (!dimensions) {
        updateScrollable(scroller)
        return
      }

      const css = getComputedStyle(scroller)
      const horizontalPadding = Number.parseFloat(css.paddingLeft) + Number.parseFloat(css.paddingRight)
      const verticalPadding = Number.parseFloat(css.paddingTop) + Number.parseFloat(css.paddingBottom)
      const availableWidth = Math.max(scroller.clientWidth - horizontalPadding, 0)
      if (availableWidth === 0) return

      const widthScale = availableWidth / dimensions.width
      const maximumHeight = Number.parseFloat(css.maxBlockSize)
      const heightScale = Number.isFinite(maximumHeight)
        ? Math.max(maximumHeight - verticalPadding, 0) / dimensions.height
        : 1
      const availableScale =
        scroller === dialogViewport ? widthScale : Math.min(widthScale, heightScale)
      const maximumScale = scroller === dialogViewport ? expandedMaximumScale : 1
      const scale = Math.min(maximumScale, Math.max(minimumScale, availableScale))
      svg.style.width = `${Math.round(dimensions.width * scale * 100) / 100}px`
      svg.style.height = 'auto'
      updateScrollable(scroller)
    }

    const restoreExpandedDiagram = () => {
      const diagram = expandedDiagram
      const opener = expandedOpener
      const scrollLeft = originalScrollLeft
      const scrollTop = originalScrollTop
      if (!diagram) return

      const scroller = scrollers.get(diagram)
      if (scroller) {
        scroller.append(diagram)
        scroller.style.blockSize = originalBlockSize
        requestAnimationFrame(() => {
          if (isVisible(diagram) && scroller.clientWidth > 0) {
            fitDiagram(diagram)
            scroller.scrollLeft = scrollLeft
            scroller.scrollTop = scrollTop
          }
        })
      }

      delete root.dataset.mermaidDialogOpen
      expandedDiagram = undefined
      expandedOpener = undefined
      originalBlockSize = ''
      originalScrollLeft = 0
      originalScrollTop = 0
      dialogTitle.textContent = 'Diagram'
      updateScrollable(dialogViewport)

      if (restoreFocusOnClose && opener?.isConnected) opener.focus()
      restoreFocusOnClose = true
    }

    const closeExpandedDiagram = (restoreFocus = true) => {
      restoreFocusOnClose = restoreFocus
      if (dialog.open) dialog.close()
      restoreExpandedDiagram()
    }

    const openExpandedDiagram = (diagram: HTMLElement, opener: HTMLButtonElement) => {
      const scroller = scrollers.get(diagram)
      if (!scroller || dialog.open) return

      expandedDiagram = diagram
      expandedOpener = opener
      restoreFocusOnClose = true
      originalBlockSize = scroller.style.blockSize
      originalScrollLeft = scroller.scrollLeft
      originalScrollTop = scroller.scrollTop
      scroller.style.blockSize = `${scroller.getBoundingClientRect().height}px`
      dialogTitle.textContent = labels.get(diagram) || 'Diagram'
      dialogViewport.append(diagram)
      try {
        dialog.showModal()
      } catch (error) {
        restoreExpandedDiagram()
        console.error('Failed to open Mermaid diagram dialog', error)
        return
      }
      root.dataset.mermaidDialogOpen = ''
      dialogClose.focus()
      requestAnimationFrame(() => fitDiagram(diagram))
    }

    diagrams.forEach((diagram) => {
      expandButtons.get(diagram)?.addEventListener('click', (event) => {
        openExpandedDiagram(diagram, event.currentTarget as HTMLButtonElement)
      })
    })
    dialogClose.addEventListener('click', () => closeExpandedDiagram())
    dialog.addEventListener('close', restoreExpandedDiagram)
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeExpandedDiagram()
    })
    addEventListener('beforeprint', () => closeExpandedDiagram(false))

    const resizeObserver = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const scroller = entry.target as HTMLElement
        const diagram = scroller.querySelector<HTMLElement>('[data-mermaid-diagram]')
        if (diagram) fitDiagram(diagram)
      }
    })
    diagrams.forEach((diagram) => resizeObserver.observe(diagram.parentElement as HTMLElement))
    resizeObserver.observe(dialogViewport)

    const fontReady = document.fonts.load('500 15px "Space Grotesk"').catch(() => [])

    const flush = async () => {
      await fontReady
      const batch = [...pending]
      pending.clear()
      const theme = currentTheme()
      const renderable = batch.filter(
        (diagram) => isVisible(diagram) && renderedThemes.get(diagram) !== theme
      )
      if (renderable.length === 0) return

      for (const diagram of renderable) {
        if (!isVisible(diagram) || currentTheme() !== theme) continue
        const source = sources.get(diagram)
        if (source === undefined) continue

        try {
          mermaid.initialize(buildMermaidConfig(theme, usesCompactFlowchartLayout(source)))
          const { svg, bindFunctions } = await mermaid.render(`mermaid-diagram-${++renderId}`, source)
          if (!isVisible(diagram) || currentTheme() !== theme) continue

          diagram.innerHTML = svg
          bindFunctions?.(diagram)
          renderedThemes.set(diagram, theme)
          frames.get(diagram)?.classList.remove('has-error')
          const expandButton = expandButtons.get(diagram)
          if (expandButton) {
            expandButton.hidden = false
            expandButton.parentElement?.removeAttribute('hidden')
          }
          const renderedSvg = diagram.querySelector('svg')
          const label = labels.get(diagram)
          if (renderedSvg && label) {
            renderedSvg.setAttribute('role', 'img')
            renderedSvg.setAttribute('aria-label', label)
          }
          fitDiagram(diagram)
        } catch (error) {
          if (!diagram.querySelector('svg')) {
            diagram.textContent = source
            frames.get(diagram)?.classList.add('has-error')
            const expandButton = expandButtons.get(diagram)
            if (expandButton) {
              expandButton.hidden = true
              expandButton.parentElement?.setAttribute('hidden', '')
            }
          }
          console.error('Failed to render Mermaid diagram', error)
        }
      }

      if (currentTheme() !== theme) {
        visibleDiagrams().forEach((diagram) => pending.add(diagram))
      }
    }

    const startRender = () => {
      if (renderTask || pending.size === 0) return
      renderTask = flush()
        .catch((error) => console.error('Failed to update Mermaid diagrams', error))
        .finally(() => {
          renderTask = undefined
          startRender()
        })
    }

    const schedule = (items: Iterable<HTMLElement>) => {
      for (const diagram of items) pending.add(diagram)
      startRender()
    }

    const tabObserver = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        const panel = mutation.target as HTMLElement
        if (panel.hidden) continue
        schedule(panel.querySelectorAll<HTMLElement>('[data-mermaid-diagram]'))
      }
    })
    document.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((panel) => {
      tabObserver.observe(panel, { attributes: true, attributeFilter: ['hidden'] })
    })

    const themeObserver = new MutationObserver(() => schedule(visibleDiagrams()))
    themeObserver.observe(root, { attributes: true, attributeFilter: ['data-theme'] })

    schedule(visibleDiagrams())
  }
</script>

<script>
  // Horizontally-scrollable regions (wide code blocks, API tables, the landing
  // terminal) must be keyboard-focusable so keyboard-only users can scroll them
  // (WCAG 2.1.1 — axe rule "scrollable-region-focusable"). Mark the ones that
  // actually overflow as focusable, and label them for screen readers.
  const markScrollable = () => {
    const candidates = document.querySelectorAll(
      'pre, .sl-markdown-content table, [class*="terminal__code"], .expressive-code figure > pre'
    )
    for (const el of candidates) {
      if (el.hasAttribute('tabindex')) continue
      // Overflows (either axis) and isn't already reachable via a focusable child.
      const scrolls =
        el.scrollWidth > el.clientWidth + 1 || el.scrollHeight > el.clientHeight + 1
      const hasFocusableChild = el.querySelector('a, button, input, textarea, select, [tabindex]')
      if (scrolls && !hasFocusableChild) {
        el.setAttribute('tabindex', '0')
        if (!el.hasAttribute('role')) el.setAttribute('role', 'region')
        if (!el.hasAttribute('aria-label')) el.setAttribute('aria-label', 'Scrollable content')
      }
    }
  }
  // Run after layout settles, and again if tab panels reveal hidden content.
  if (document.readyState === 'complete') markScrollable()
  else window.addEventListener('load', markScrollable)
</script>
