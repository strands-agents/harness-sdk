---
import arrow from '../assets/banner/arrow.svg?raw'
import { featuredFaqItems } from '../config/faq'
import { pathWithBase } from '../util/links'

const faqHref = pathWithBase('/faq/')
---

<section class="home-faq" aria-labelledby="home-faq-title">
  <div class="home-faq__inner">
    <header class="home-faq__header">
      <h2 id="home-faq-title" class="home-faq__eyebrow">FAQ</h2>
      <p class="home-faq__lede">
        Start with five common questions about choosing, building, and deploying an agent.
      </p>
      <a class="home-faq__cta cta-button" href={faqHref}>
        View all FAQs
        <span class="home-faq__cta-arrow" set:html={arrow} />
      </a>
    </header>

    <div class="home-faq__list">
      {
        featuredFaqItems.map((faq, index) => (
          <details class="home-faq__item" open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <span class="home-faq__toggle" aria-hidden="true" />
            </summary>
            <p>{faq.featuredSummary}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .home-faq {
    background: var(--bg);
    padding: 44px 80px 56px;
  }

  .home-faq__inner {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(0, 3fr);
    align-items: start;
    gap: 48px;
    max-width: 1282px;
    margin: 0 auto;
  }

  .home-faq__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .home-faq__eyebrow {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(42px, 4vw, 56px);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
    color: var(--accent-green);
  }

  .home-faq__lede {
    margin: 14px 0 0;
    max-width: 19rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 16px;
    letter-spacing: 0.5px;
    line-height: 1.45;
    color: var(--fg);
  }

  .home-faq__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 12px 18px;
    border: 1px solid var(--accent-green);
    border-radius: 8px;
    background: var(--accent-green);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--bg);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .home-faq__cta:hover {
    background: transparent;
    color: var(--accent-green);
  }

  .home-faq__cta:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 3px;
  }

  .home-faq__cta-arrow {
    display: inline-flex;
    width: 12px;
    height: 11px;
  }

  .home-faq__cta-arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .home-faq__list {
    min-width: 0;
    border-top: 1px solid var(--card-border);
  }

  .home-faq__item {
    border-bottom: 1px solid var(--card-border);
  }

  .home-faq__item summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24px;
    gap: 24px;
    align-items: center;
    min-height: 64px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg);
  }

  .home-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .home-faq__item summary:hover {
    color: var(--accent-green);
  }

  .home-faq__item summary:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 4px;
  }

  .home-faq__toggle {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .home-faq__toggle::before,
  .home-faq__toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 2px;
    background: currentColor;
    content: '';
    transform: translate(-50%, -50%);
  }

  .home-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.15s ease;
  }

  .home-faq__item[open] .home-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .home-faq__item p {
    margin: -2px 48px 18px 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--fg);
  }

  @media (max-width: 1023px) {
    .home-faq {
      padding: 40px 40px 48px;
    }

    .home-faq__inner {
      grid-template-columns: minmax(170px, 1fr) minmax(0, 3fr);
      gap: 32px;
    }

    .home-faq__eyebrow {
      font-size: 40px;
      letter-spacing: -1.5px;
    }

    .home-faq__lede {
      font-size: 15px;
    }

    .home-faq__item summary {
      min-height: 60px;
      padding: 12px 0;
      font-size: 17px;
    }
  }

  @media (max-width: 767px) {
    .home-faq {
      padding: 34px 19px 48px;
    }

    .home-faq__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .home-faq__eyebrow {
      font-size: 34px;
      letter-spacing: -1px;
      line-height: 1.05;
    }

    .home-faq__lede {
      max-width: none;
      margin-top: 12px;
      font-size: 16px;
    }

    .home-faq__cta {
      margin-top: 20px;
      font-size: 15px;
    }

    .home-faq__item summary {
      min-height: 60px;
      gap: 16px;
      padding: 13px 0;
      font-size: 16px;
    }

    .home-faq__item p {
      margin: -1px 32px 16px 0;
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq__cta,
    .home-faq__toggle::after {
      transition: none;
    }
  }
</style>
