---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { render } from 'astro:content'
import { buildSampleGuideSidebar, type SampleGuideEntry } from '../../util/sample-guides'
import { languageLabel } from '../../util/source-links'
import { articleSchema } from '../../util/structured-data'

interface Props {
  guide: SampleGuideEntry
  guides: SampleGuideEntry[]
}

const { guide, guides } = Astro.props
const sidebar = buildSampleGuideSidebar(guides, guide)
const { Content, headings } = await render(guide)

const siteUrl = Astro.site?.origin || 'https://strandsagents.com'
const pageUrl = siteUrl + Astro.url.pathname
Astro.locals.structuredData = [
  articleSchema(
    {
      type: 'TechArticle',
      title: guide.data.title,
      description: guide.data.description,
      url: pageUrl,
      sources: [
        {
          programmingLanguage: languageLabel(guide.data.language),
          codeRepository: guide.data.sourceUrl.split('/').slice(0, 5).join('/'),
          url: guide.data.sourceUrl,
        },
      ],
    },
    siteUrl
  ),
]
---

<StarlightPage
  frontmatter={{
    title: guide.data.title,
    description: guide.data.description,
    editUrl: false,
  }}
  headings={headings}
  sidebar={sidebar}
>
  <p class="sample-guide__source">
    <a href={guide.data.sourceUrl} target="_blank" rel="noopener">View the complete sample on GitHub</a>
  </p>
  {
    guide.data.docs.length > 0 && (
      <p class="sample-guide__docs">
        Related documentation:{' '}
        {guide.data.docs.map((doc, index) => (
          <>
            {index > 0 && ', '}
            <a href={doc.url}>{doc.label}</a>
          </>
        ))}
      </p>
    )
  }
  <Content />
</StarlightPage>

<style>
  .sample-guide__source,
  .sample-guide__docs {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
