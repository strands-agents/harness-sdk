---
/**
 * Facet controls (SDK, language, verified, type chips) for the search dialog.
 * Static markup with data-cat-* hooks; the page script binds every instance
 * document-wide, so these stay in sync with the filter bar's language/SDK
 * segments and the left rail's type/badge chips.
 */
import CatalogSegments from './CatalogSegments.astro'
import { AWS_MARK_VIEWBOX, MAINTAINED_BY_ICONS, VERIFIED_ICON, type FacetOption } from './types'

// Type filtering now lives in the left sidebar (one link per type), so the
// dialog carries only the remaining facets.
interface Props {
  maintainedBy: FacetOption[]
  showSdkFacet: boolean
  hasVerified: boolean
  hasFeatured: boolean
  hasNew: boolean
}

const { maintainedBy, showSdkFacet, hasVerified, hasFeatured, hasNew } = Astro.props
---

<div class="cat-facet-row">
  {/* Language is a catalog control here (All / Python / TypeScript), independent
      of the header's site-wide language toggle. The page script binds it. */}
  <div class="cat-seg" role="radiogroup" aria-label="Language">
    <button class="cat-seg-btn" type="button" role="radio" aria-checked="true" data-cat-lang="">
      All
    </button>
    <button class="cat-seg-btn" type="button" role="radio" aria-checked="false" data-cat-lang="python">
      Python
    </button>
    <button class="cat-seg-btn" type="button" role="radio" aria-checked="false" data-cat-lang="typescript">
      TypeScript
    </button>
  </div>
  <CatalogSegments showSdkFacet={showSdkFacet} />
  {/* Maintainer and status filters share the one row with the language / SDK
      segments, split into groups by a divider so each set of controls still
      reads as its own filter. */}
  <span class="cat-facet-sep" aria-hidden="true"></span>
  <div class="cat-type-rail" role="group" aria-label="Maintained by">
    {
      maintainedBy.map((t) => (
        <button class="cat-chip" type="button" data-cat-maintained={t.value} aria-label={t.label} aria-pressed="false">
          {MAINTAINED_BY_ICONS[t.value] ? (
            <svg width="29" height="18" viewBox={AWS_MARK_VIEWBOX} aria-hidden="true">
              <path fill="currentColor" d={MAINTAINED_BY_ICONS[t.value]} />
            </svg>
          ) : (
            t.label
          )}
          <span class="cat-count">{t.count}</span>
        </button>
      ))
    }
  </div>
  {
    (hasFeatured || hasNew || hasVerified) && (
      <>
        <span class="cat-facet-sep" aria-hidden="true" />
        <div class="cat-type-rail" role="group" aria-label="Status">
          {hasFeatured && (
            <button class="cat-chip" type="button" data-cat-badge="featured" aria-pressed="false">
              Featured
            </button>
          )}
          {hasNew && (
            <button class="cat-chip" type="button" data-cat-badge="new" aria-pressed="false">
              New
            </button>
          )}
          {hasVerified && (
            <button class="cat-chip" type="button" data-cat-badge="verified" aria-pressed="false">
              <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={VERIFIED_ICON} />
              </svg>
              Verified
            </button>
          )}
        </div>
      </>
    )
  }
</div>
