---
import arrow from '../assets/banner/arrow.svg?raw'
import { homepageStartProjects } from '../config/homepage'
import InstallCommand from './InstallCommand.astro'

const [harness] = homepageStartProjects
if (!harness) throw new Error('Missing Harness homepage project')
---

<section class="banner" aria-labelledby="hero-title">
  <div class="banner__inner">
    <div class="banner__content">
      <h1 id="hero-title" class="banner__headline">
        <span>The open source</span>
        <span>toolkit for</span>
        <span>production agents.</span>
      </h1>

      <div class="banner__conversion">
        <div class="banner__actions">
          <a href={harness.href} class="banner__cta banner__cta--primary">
            Build an agent
            <span class="banner__arrow" set:html={arrow} />
          </a>
          <a
            href={harness.product.repository}
            class="banner__cta banner__cta--secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
            <span class="banner__arrow" set:html={arrow} />
          </a>
        </div>
        <div class="banner__install">
          <InstallCommand pip="pip install strands-harness" npm="npm install @strands-agents/harness" />
        </div>
      </div>
    </div>

    <div class="banner__dots" aria-hidden="true"></div>
  </div>
</section>

<style>
  .banner {
    width: 100%;
    padding: 18px var(--home-gutter) 0;
    background: var(--bg);
    color: var(--fg);
  }

  .banner__inner {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: var(--home-content-width);
    margin: 0 auto;
    padding: clamp(42px, 5vw, 64px) 0;
    overflow: hidden;
  }

  .banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    text-align: center;
  }

  .banner__headline {
    display: flex;
    flex-direction: column;
    max-width: 1120px;
    margin: 0;
    text-wrap: balance;
  }

  .banner__conversion {
    position: relative;
    z-index: 1;
    display: inline-grid;
    justify-items: stretch;
    gap: 14px;
    max-width: 100%;
    margin-top: 30px;
  }

  .banner__install {
    width: 100%;
    max-width: 100%;
  }

  .banner__install :global(.install) {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
  }

  .banner__actions {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0;
  }

  .banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    min-height: 50px;
    border-radius: 999px;
    font-family: var(--home-control-font);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .banner__cta:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 4px;
  }

  .banner__arrow {
    display: inline-flex;
    width: 12px;
    height: 10px;
  }

  .banner__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .banner__dots {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 82%) 38%, transparent 100%);
  }

  :global(:root[data-theme='dark']) .banner__dots {
    opacity: 0.3;
  }

  @media (max-width: 767px) {
    .banner {
      padding: 14px var(--home-gutter) 0;
    }

    .banner__inner {
      padding: 46px 0 42px;
    }

    .banner__content {
      width: 100%;
    }

    .banner__headline {
      line-height: var(--home-hero-line-height);
    }

    .banner__conversion {
      gap: 12px;
      width: 100%;
      max-width: 405px;
      margin-top: 24px;
    }

    .banner__actions {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }

    .banner__dots {
      top: 0;
      right: 0;
      left: 0;
      width: 100%;
      height: 220px;
      background-size: 14px 14px;
      -webkit-mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 78%) 40%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 78%) 40%, transparent 100%);
    }

    :global(:root[data-theme='dark']) .banner__dots {
      opacity: 0.28;
    }
  }

  @media (max-width: 360px) {
    .banner__inner {
      padding: 30px 0 28px;
    }

    .banner__cta {
      padding-inline: 10px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner__cta {
      transition: none;
    }

    .banner__cta:hover {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .banner__dots {
      display: none;
    }
  }
  .banner__inner {
    min-height: 360px;
    padding-block: 60px 42px;
  }

  .banner__headline {
    font-family: var(--home-display-font);
    font-size: clamp(30px, 3.25vw, 52px);
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.2;
    color: var(--banner-headline);
  }

  .banner__conversion {
    grid-template-columns: minmax(0, 1fr);
    width: min(100%, 430px);
    min-width: 0;
  }

  .banner__install {
    min-width: 0;
  }

  .banner__cta {
    background: var(--toggle-bg);
    border: 1px solid var(--toggle-inactive-border);
    color: var(--fg);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    padding: 10px 15px;
  }

  .banner__cta:hover {
    opacity: 0.75;
    transform: none;
  }

  .banner__dots {
    inset: 20px 0 auto;
    height: 280px;
    border-radius: 40px;
    opacity: 0.35;
    background: none;
    mask-image: linear-gradient(#000, transparent);
  }

  .banner__dots::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--halftone-dot);
    mask: url('../assets/banner/halftone.svg') center / 1332px 750px no-repeat;
    transform: rotate(180deg);
  }

  @media (min-width: 1024px) {
    .banner__inner {
      min-height: 324px;
      padding: 48px clamp(0px, 2vw, 32px);
    }

    .banner__content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 430px);
      grid-template-areas: 'headline actions';
      gap: 20px clamp(32px, 4vw, 64px);
      align-items: center;
      text-align: left;
    }

    .banner__headline {
      grid-area: headline;
      align-items: flex-start;
    }

    .banner__conversion {
      grid-area: actions;
      justify-self: end;
      margin-top: 0;
    }

    .banner__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .banner__inner {
      min-height: 0;
      padding-block: 36px 24px;
    }

    .banner__headline {
      max-width: 100%;
      font-size: clamp(21px, 4.8vw, 26px);
      font-weight: 600;
      letter-spacing: 0.1em;
    }

    .banner__cta {
      font-size: 14px;
      padding-inline: 10px;
    }

    .banner__install :global(.install__cmd) {
      font-size: 11px;
    }

    .banner__install :global(.install__copy) {
      padding-inline: 10px;
    }

    .banner__dots {
      opacity: 0.25;
      border-radius: 14px;
    }
  }
</style>
