---
import arrow from '../assets/banner/arrow.svg?raw'
---

<section class="banner" aria-labelledby="hero-title">
  <div class="banner__inner">
    <div class="banner__content">
      <h1 id="hero-title" class="banner__headline">
        <span>Build agents.</span>
        <span class="banner__headline-accent">Own every layer.</span>
      </h1>

      <div class="banner__summary">
        <p class="banner__intro">
          Strands is an open-source toolkit for building, running, and improving AI agents.
        </p>

        <div class="banner__actions">
          <a href="#framework" class="banner__cta banner__cta--primary">
            Build an agent
            <span class="banner__arrow" set:html={arrow} />
          </a>
          <a
            href="https://github.com/strands-agents"
            class="banner__cta banner__cta--secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            View on GitHub
            <span class="banner__arrow" set:html={arrow} />
          </a>
        </div>
      </div>
    </div>

    <div class="banner__dots" aria-hidden="true"></div>
  </div>
</section>

<style>
  .banner {
    width: 100%;
    padding: 18px var(--home-gutter) 0;
    background: var(--bg);
    color: var(--fg);
  }

  .banner__inner {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(380px, 46vh, 470px);
    max-width: var(--home-content-width);
    margin: 0 auto;
    padding: clamp(42px, 5vw, 64px) 0;
    overflow: hidden;
  }

  .banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .banner__headline {
    display: flex;
    flex-direction: column;
    max-width: 1120px;
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(54px, 5.8vw, 82px);
    font-weight: 620;
    letter-spacing: -0.064em;
    line-height: 0.94;
    color: var(--fg);
    text-wrap: balance;
  }

  .banner__summary {
    display: grid;
    grid-template-columns: minmax(0, 720px) max-content;
    align-items: end;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 64px);
    width: 100%;
    margin-top: 22px;
  }

  .banner__headline-accent {
    color: var(--accent-green);
  }

  .banner__intro {
    max-width: 720px;
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    color: color-mix(in srgb, var(--fg) 74%, transparent);
  }

  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
    margin: 0;
  }

  .banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    padding: 10px 17px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .banner__cta:hover {
    transform: translateY(-2px);
  }

  .banner__cta:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 4px;
  }

  .banner__cta--primary {
    background: var(--strands-green);
    color: var(--strands-black);
  }

  .banner__cta--primary:hover {
    background: color-mix(in srgb, var(--strands-green) 84%, white);
  }

  .banner__cta--secondary {
    background: transparent;
    border-color: transparent;
    color: var(--fg);
  }

  .banner__cta--secondary:hover {
    border-color: transparent;
    color: var(--accent-green);
  }

  .banner__arrow {
    display: inline-flex;
    width: 12px;
    height: 10px;
  }

  .banner__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .banner__dots {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: clamp(-48px, -2vw, -12px);
    width: min(31vw, 430px);
    height: 76%;
    background: radial-gradient(circle, var(--halftone-dot) 0 2.2px, transparent 2.7px) 0 0 / 18px 18px;
    opacity: 0.5;
    pointer-events: none;
    transform: translateY(-50%);
    -webkit-mask-image: radial-gradient(ellipse at 72% 50%, #000 0 18%, rgb(0 0 0 / 78%) 38%, transparent 76%);
    mask-image: radial-gradient(ellipse at 72% 50%, #000 0 18%, rgb(0 0 0 / 78%) 38%, transparent 76%);
  }

  :global(:root[data-theme='dark']) .banner__dots {
    opacity: 0.28;
  }

  @media (max-width: 980px) {
    .banner__headline {
      font-size: clamp(56px, 8vw, 76px);
    }

    .banner__summary {
      grid-template-columns: minmax(0, 1fr) max-content;
      gap: 24px;
    }

    .banner__actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .banner__dots {
      right: -72px;
      width: 34vw;
      opacity: 0.34;
    }
  }

  @media (max-width: 767px) {
    .banner {
      padding: 14px var(--home-gutter) 0;
    }

    .banner__inner {
      align-items: flex-start;
      min-height: 0;
      padding: 34px 0 32px;
    }

    .banner__content {
      width: 100%;
    }

    .banner__headline {
      font-size: clamp(42px, 12vw, 56px);
      letter-spacing: -0.058em;
      line-height: 0.94;
    }

    .banner__summary {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-top: 18px;
    }

    .banner__intro {
      max-width: 36rem;
      font-size: 16px;
    }

    .banner__actions {
      align-items: center;
      flex-direction: row;
      display: flex;
    }

    .banner__cta {
      width: auto;
    }

    .banner__dots {
      top: 46px;
      right: -48px;
      width: 150px;
      height: 105px;
      background-size: 14px 14px;
      opacity: 0.38;
      transform: none;
      -webkit-mask-image: radial-gradient(ellipse at 76% 24%, #000 0 18%, rgb(0 0 0 / 70%) 38%, transparent 78%);
      mask-image: radial-gradient(ellipse at 76% 24%, #000 0 18%, rgb(0 0 0 / 70%) 38%, transparent 78%);
    }

    :global(:root[data-theme='dark']) .banner__dots {
      opacity: 0.24;
    }
  }

  @media (max-width: 360px) {
    .banner__inner {
      padding: 30px 0 28px;
    }

    .banner__headline {
      font-size: 39px;
    }

    .banner__summary {
      gap: 18px;
      margin-top: 16px;
    }

    .banner__intro {
      font-size: 15px;
      line-height: 1.45;
    }

    .banner__actions {
      gap: 10px;
    }

    .banner__cta {
      padding-inline: 12px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner__cta {
      transition: none;
    }

    .banner__cta:hover {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .banner__dots {
      display: none;
    }
  }
</style>
