---
import { createShikiHighlighter } from '@astrojs/markdown-remark/shiki';

import arrow from '../assets/banner/arrow.svg?raw';
import plus from '../assets/toolkit/plus.svg?raw';
import InstallCommand from './InstallCommand.astro';
import { products } from '../config/navbar';
import { DEFAULT_LANGUAGE_LABEL } from '../util/language-preference';
import { pathWithBase } from '../util/links';

const harnessProduct = products.find((product) => product.label === 'Harness');
if (!harnessProduct) throw new Error('Missing homepage product: Harness');

const highlighter = await createShikiHighlighter({
  themes: {
    light: 'github-light-high-contrast',
    dark: 'github-dark-high-contrast',
  },
});

const harnessExamples = await Promise.all([
  {
    language: 'Python',
    syntax: 'python',
    code: `from strands_harness import create_harness
agent = create_harness()
agent("Summarize this repository")`,
  },
  {
    language: 'TypeScript',
    syntax: 'typescript',
    code: `import { createHarness } from '@strands-agents/harness'
const agent = await createHarness()
await agent.invoke('Summarize this repository')`,
  },
].map(async (example) => ({
  ...example,
  highlightedCode: await highlighter.codeToHtml(example.code, example.syntax, {
    defaultColor: false,
    attributes: { class: 'banner__highlighted-code' },
  }),
})));
---

<section class="banner" aria-labelledby="homepage-hero-title">
  <div class="banner__inner">
    <div class="banner__content">
      <p class="banner__eyebrow">Open source</p>
      <h1 id="homepage-hero-title" class="banner__headline">Build AI agents.</h1>
      <p class="banner__summary">An open source framework for building production agents.</p>

      <div
        class="banner__start"
        style={`--accent: var(--card-accent-${harnessProduct.accent});`}
        data-product-name={harnessProduct.name}
        data-example-closed-label="View code example"
        data-example-card
      >
        <div class="banner__start-heading">
          <h2 class="banner__start-title">
            <span class="banner__harness">/harness</span>
          </h2>
          <p class="banner__start-summary">
            A ready-to-use agent with tools, memory, sessions, and context management assembled.
          </p>
        </div>

        <div class="banner__start-row">
          <div class="banner__install">
            <InstallCommand
              pip="pip install strands-harness"
              npm="npm i @strands-agents/harness"
              copyLabel="Copy Strands harness install command"
            />
          </div>
          <a
            href={pathWithBase('/docs/user-guide/harness/quickstart/')}
            class="banner__action banner__action--primary"
          >
            Quickstart
            <span class="banner__arrow" set:html={arrow} />
          </a>
        </div>

        <button
          type="button"
          class="banner__example-toggle"
          aria-expanded="false"
          aria-controls="harness-code-example"
          aria-label="View code example for Strands harness"
          data-example-toggle
        >
          <span data-example-toggle-label>View code example</span>
          <span class="banner__example-icon" aria-hidden="true" set:html={plus} />
        </button>

        <div id="harness-code-example" class="banner__code-drawer" data-example-panel hidden>
          <div class="banner__terminal" data-code-terminal data-switchable-code>
            <header class="banner__terminal-header">
              <span class="banner__terminal-language" data-terminal-language>
                {DEFAULT_LANGUAGE_LABEL}
              </span>
              <button
                type="button"
                class="banner__terminal-copy"
                aria-label="Copy Strands harness code example"
                data-code-copy
              >
                <span role="status" aria-live="polite" data-code-copy-label>copy</span>
              </button>
            </header>
            {
              harnessExamples.map((example) => (
                <div
                  class="banner__terminal-code"
                  data-example-language={example.language}
                  data-code-value={example.code}
                  hidden={example.language !== DEFAULT_LANGUAGE_LABEL}
                >
                  <Fragment set:html={example.highlightedCode} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .banner {
    width: 100%;
    background: var(--bg);
  }

  .banner__inner {
    max-width: 1442px;
    margin: 0 auto;
  }

  .banner__content {
    display: flex;
    width: calc(100% - 110px);
    max-width: 840px;
    margin: 0 auto;
    padding: 88px 0 112px;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .banner__eyebrow {
    margin: 0 0 18px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .banner__headline {
    max-width: 760px;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(42px, 4.6vw, 64px);
    font-weight: 600;
    line-height: 1.06;
    color: var(--banner-headline);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .banner__summary {
    margin: 24px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.5;
    color: var(--fg);
    white-space: nowrap;
  }

  .banner__harness {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
    color: var(--card-accent-orange);
  }

  .banner__start {
    width: 100%;
    max-width: 620px;
    margin-top: 36px;
  }

  .banner__start-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .banner__start-title {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
  }

  .banner__start-summary {
    max-width: 560px;
    margin: 9px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.45;
    color: var(--toggle-inactive-fg);
    text-wrap: balance;
  }

  .banner__start-row {
    display: flex;
    margin-top: 18px;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .banner__install {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    text-align: left;
  }

  .banner__install :global(.install) {
    width: auto;
  }

  .banner__install :global(.install__cmd) {
    font-size: 14px;
  }

  .banner__action,
  .banner__example-toggle {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .banner__action {
    display: inline-flex;
    min-height: 44px;
    padding: 10px 17px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .banner__action:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  .banner__action:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 3px;
  }

  .banner__action--primary {
    flex: none;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .banner__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .banner__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .banner__example-toggle {
    display: inline-flex;
    min-height: 38px;
    margin-top: 9px;
    padding: 7px 0;
    align-items: center;
    gap: 9px;
    background: transparent;
    border: 0;
    color: var(--fg);
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .banner__example-toggle:hover {
    opacity: 0.76;
  }

  .banner__example-toggle:focus-visible,
  .banner__terminal-copy:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .banner__example-icon {
    position: relative;
    display: inline-flex;
    width: 13px;
    height: 13px;
    color: var(--accent);
  }

  .banner__example-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .banner__start.is-open .banner__example-icon :global(svg) {
    display: none;
  }

  .banner__start.is-open .banner__example-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 13px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transform: translateY(-50%);
  }

  .banner__code-drawer {
    width: 100%;
    max-width: 480px;
    margin: 14px auto 0;
    animation: reveal-banner-code 0.2s ease both;
  }

  .banner__code-drawer[hidden] {
    display: none;
  }

  @keyframes reveal-banner-code {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .banner__terminal {
    min-width: 0;
    overflow: hidden;
    text-align: left;
    background: var(--terminal-bg);
    border: 1px solid var(--toggle-inactive-border);
    border-radius: 8px;
  }

  .banner__terminal-header {
    display: flex;
    min-height: 30px;
    padding: 6px 8px 6px 12px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--toggle-inactive-border);
  }

  .banner__terminal-language,
  .banner__terminal-copy {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }

  .banner__terminal-language {
    color: var(--toggle-inactive-fg);
    text-transform: uppercase;
  }

  .banner__terminal-copy {
    margin-left: auto;
    padding: 4px 7px;
    background: transparent;
    border: 0;
    color: var(--toggle-inactive-fg);
    cursor: pointer;
  }

  .banner__terminal-copy.is-copied {
    color: var(--strands-green);
  }

  .banner__terminal-code {
    margin: 0;
    background: transparent;
  }

  .banner__terminal-code :global(.astro-code) {
    margin: 0;
    padding: 12px 14px 14px;
    overflow-x: auto;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    line-height: 1.5;
    background: transparent;
    color: var(--shiki-light);
  }

  .banner__terminal-code :global(.astro-code span) {
    color: var(--shiki-light);
  }

  :global([data-theme='dark']) .banner__terminal-code :global(.astro-code),
  :global([data-theme='dark']) .banner__terminal-code :global(.astro-code span) {
    color: var(--shiki-dark);
  }

  @media (max-width: 767px) {
    .banner__content {
      width: calc(100% - 38px);
      padding: 58px 0 76px;
    }

    .banner__eyebrow {
      margin-bottom: 14px;
      font-size: 12px;
    }

    .banner__headline {
      font-size: clamp(36px, 11vw, 48px);
      letter-spacing: -0.045em;
    }

    .banner__summary {
      margin-top: 18px;
      font-size: 16px;
      line-height: 1.45;
      white-space: normal;
    }

    .banner__start {
      margin-top: 30px;
    }

    .banner__start-title {
      font-size: 28px;
    }

    .banner__start-summary {
      margin-top: 8px;
      font-size: 16px;
    }

    .banner__start-row {
      display: grid;
      width: 100%;
      margin-top: 16px;
      grid-template-columns: minmax(0, 1fr);
      gap: 9px;
    }

    .banner__install {
      width: 100%;
      min-width: 0;
      margin-top: 0;
    }

    .banner__install :global(.install) {
      width: 100%;
      gap: 6px;
      padding: 8px 7px 8px 11px;
    }

    .banner__install :global(.install__cmd) {
      gap: 7px;
      font-size: 12px;
    }

    .banner__install :global(.install__copy) {
      padding: 6px 9px;
      font-size: 12px;
    }

    .banner__action {
      width: 100%;
      font-size: 13px;
    }

    .banner__example-toggle {
      width: fit-content;
      margin-top: 5px;
      font-size: 11px;
    }

    .banner__terminal-code :global(.astro-code) {
      padding: 11px 12px 13px;
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner__action,
    .banner__example-toggle {
      transition: none;
    }

    .banner__action:hover {
      transform: none;
    }

    .banner__code-drawer {
      animation: none;
    }
  }
</style>

<script>
  import { attachCopyButton } from '../util/clipboard'
  import { DEFAULT_LANGUAGE_LABEL, LANGUAGE_STORAGE_KEY } from '../util/language-preference'

  const banner = document.querySelector<HTMLElement>('.banner')
  const harnessCard = banner?.querySelector<HTMLElement>('[data-example-card]')

  function setExampleOpen(card: HTMLElement, willOpen: boolean) {
    card.classList.toggle('is-open', willOpen)

    const toggle = card.querySelector<HTMLButtonElement>('[data-example-toggle]')
    const panel = card.querySelector<HTMLElement>('[data-example-panel]')
    const label = toggle?.querySelector<HTMLElement>('[data-example-toggle-label]')
    const productName = card.dataset.productName ?? 'this product'

    toggle?.setAttribute('aria-expanded', willOpen ? 'true' : 'false')
    toggle?.setAttribute(
      'aria-label',
      `${willOpen ? 'Hide' : 'View'} code example for ${productName}`,
    )
    if (panel) panel.hidden = !willOpen
    if (label) {
      label.textContent = willOpen
        ? 'Hide code'
        : (card.dataset.exampleClosedLabel ?? 'View code example')
    }
  }

  harnessCard
    ?.querySelector<HTMLButtonElement>('[data-example-toggle]')
    ?.addEventListener('click', () => {
      setExampleOpen(harnessCard, !harnessCard.classList.contains('is-open'))
    })

  const terminal = banner?.querySelector<HTMLElement>('[data-code-terminal]')
  const copyButton = terminal?.querySelector<HTMLButtonElement>('[data-code-copy]')
  if (terminal && copyButton) {
    attachCopyButton(copyButton, {
      label: copyButton.querySelector<HTMLElement>('[data-code-copy-label]'),
      getText: () =>
        terminal.querySelector<HTMLElement>('.banner__terminal-code:not([hidden])')?.dataset
          .codeValue ?? '',
      track: {
        surface: 'code:homepage',
        detail: () =>
          terminal.querySelector<HTMLElement>('[data-terminal-language]')?.textContent?.trim(),
      },
    })
  }

  function currentLanguage() {
    try {
      return localStorage.getItem(LANGUAGE_STORAGE_KEY) === 'Python'
        ? 'Python'
        : DEFAULT_LANGUAGE_LABEL
    } catch {
      return DEFAULT_LANGUAGE_LABEL
    }
  }

  function applyHarnessLanguage(language: string) {
    const activeLanguage = language === 'Python' ? 'Python' : 'TypeScript'

    banner?.querySelectorAll<HTMLElement>('[data-switchable-code]').forEach((codeBlock) => {
      codeBlock.querySelectorAll<HTMLElement>('[data-example-language]').forEach((example) => {
        example.hidden = example.dataset.exampleLanguage !== activeLanguage
      })
      const label = codeBlock.querySelector<HTMLElement>('[data-terminal-language]')
      if (label) label.textContent = activeLanguage
    })
  }

  applyHarnessLanguage(currentLanguage())
  window.addEventListener('lang-change', (event: Event) => {
    applyHarnessLanguage((event as CustomEvent<string>).detail)
  })
</script>
