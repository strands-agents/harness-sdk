---
import arrow from '../assets/banner/arrow.svg?raw';
import InstallCommand from './InstallCommand.astro';
import { pathWithBase } from '../util/links';
---

<section class="banner" aria-labelledby="homepage-hero-title">
  <div class="banner__inner">
    <div class="banner__content">
      <p class="banner__eyebrow">Open source · Python + TypeScript</p>
      <h1 id="homepage-hero-title" class="banner__headline">
        Build agents you can put to work.
      </h1>
      <p class="banner__summary">
        Strands is an open source framework for production agents. Start with Strands harness, then
        add focused tools as your agent grows.
      </p>

      <div class="banner__actions">
        <a
          href={pathWithBase('/docs/user-guide/harness/quickstart/')}
          class="banner__action banner__action--primary"
        >
          Build your first agent
          <span class="banner__arrow" set:html={arrow} />
        </a>
        <a href="#tools" class="banner__action banner__action--secondary">
          Explore the tools
          <span class="banner__down-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="banner__install">
        <span class="banner__install-label">Install Strands harness</span>
        <InstallCommand
          pip="pip install strands-harness"
          npm="npm i @strands-agents/harness"
          copyLabel="Copy Strands harness install command"
        />
      </div>

      <a
        class="banner__sdk-link"
        href={pathWithBase('/docs/user-guide/sdk/quickstart/overview/')}
      >
        Building from primitives? Explore the Strands Harness SDK
        <span class="banner__arrow" set:html={arrow} />
      </a>
    </div>
  </div>
</section>

<style>
  .banner {
    width: 100%;
    background: var(--bg);
  }

  .banner__inner {
    max-width: 1442px;
    margin: 0 auto;
  }

  .banner__content {
    display: flex;
    width: calc(100% - 110px);
    max-width: 880px;
    margin: 0 auto;
    padding: 94px 0 58px;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .banner__eyebrow {
    margin: 0 0 18px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .banner__headline {
    max-width: 820px;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(42px, 5vw, 70px);
    font-weight: 600;
    line-height: 1.06;
    color: var(--banner-headline);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .banner__summary {
    max-width: 680px;
    margin: 24px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.5;
    color: var(--fg);
    text-wrap: balance;
  }

  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .banner__action {
    display: inline-flex;
    min-height: 46px;
    padding: 11px 18px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .banner__action:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  .banner__action:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 3px;
  }

  .banner__action--primary {
    background: var(--strands-green);
    border-color: var(--strands-green);
    color: var(--strands-black);
  }

  .banner__action--secondary {
    padding-inline: 14px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .banner__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .banner__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .banner__down-arrow {
    color: var(--accent-green);
    font-size: 17px;
    line-height: 1;
  }

  .banner__install {
    display: flex;
    width: 100%;
    max-width: 590px;
    margin-top: 28px;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    text-align: left;
  }

  .banner__install-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--toggle-inactive-fg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .banner__install :global(.install__cmd) {
    font-size: 13px;
  }

  .banner__sdk-link {
    display: inline-flex;
    min-height: 24px;
    margin-top: 17px;
    padding: 3px 0;
    align-items: center;
    gap: 7px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 4px;
    opacity: 0.68;
    transition: opacity 0.15s ease;
  }

  .banner__sdk-link:hover {
    opacity: 1;
  }

  .banner__sdk-link:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 4px;
    border-radius: 4px;
    opacity: 1;
  }

  @media (max-width: 767px) {
    .banner__content {
      width: calc(100% - 38px);
      padding: 62px 0 42px;
    }

    .banner__eyebrow {
      margin-bottom: 14px;
      font-size: 10px;
    }

    .banner__headline {
      font-size: clamp(36px, 11vw, 48px);
      letter-spacing: -0.045em;
    }

    .banner__summary {
      margin-top: 18px;
      font-size: 16px;
      line-height: 1.45;
    }

    .banner__actions {
      display: grid;
      width: 100%;
      margin-top: 24px;
      grid-template-columns: 1fr;
    }

    .banner__action {
      width: 100%;
      font-size: 13px;
    }

    .banner__install {
      margin-top: 24px;
    }

    .banner__install :global(.install) {
      gap: 6px;
      padding: 8px 7px 8px 11px;
    }

    .banner__install :global(.install__cmd) {
      gap: 7px;
      font-size: 11px;
    }

    .banner__install :global(.install__copy) {
      padding: 6px 9px;
      font-size: 12px;
    }

    .banner__sdk-link {
      max-width: 320px;
      justify-content: center;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner__action,
    .banner__sdk-link {
      transition: none;
    }

    .banner__action:hover {
      transform: none;
    }
  }
</style>
