---
import halftone from '../assets/banner/halftone.svg?url';
import arrow from '../assets/banner/arrow.svg?raw';
import InstallCommand from './InstallCommand.astro';
import { pathWithBase } from '../util/links';
---

<section class="banner" aria-labelledby="homepage-hero-title">
  <div class="banner__inner">
    <div class="banner__halftone" aria-hidden="true">
      <div class="banner__halftone-mask" style={`--halftone-mask: url("${halftone}")`} />
    </div>
    <div class="banner__gradient" aria-hidden="true" />

    <div class="banner__content">
      <div class="banner__copy">
        <p class="banner__eyebrow">Open source · Python + TypeScript</p>
        <h1 id="homepage-hero-title" class="banner__headline">
          Build production AI agents with open source tools.
        </h1>
        <p class="banner__summary">
          Strands is an open source framework for production agents. Start with a complete
          harness or compose the agent loop from SDK primitives.
        </p>

        <div class="banner__actions">
          <a
            href={pathWithBase('/docs/user-guide/harness/quickstart/')}
            class="banner__action banner__action--primary"
          >
            Build your first agent
            <span class="banner__arrow" set:html={arrow} />
          </a>
          <a
            href={pathWithBase('/docs/user-guide/sdk/quickstart/overview/')}
            class="banner__action banner__action--secondary"
          >
            Start from SDK primitives
            <span class="banner__arrow" set:html={arrow} />
          </a>
        </div>

        <a href="#toolkit" class="banner__explore">
          Explore every Strands tool
          <span class="banner__explore-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <aside class="banner__starter" aria-label="Fastest way to start">
        <div class="banner__starter-kicker">
          <span class="banner__starter-dot" aria-hidden="true"></span>
          <span>Fastest path</span>
          <span class="banner__starter-slug">/harness</span>
        </div>
        <p class="banner__starter-title">Start with Strands harness.</p>
        <p class="banner__starter-description">
          Get benchmarked defaults for tools, memory, session management, and context management.
          Override any default when needed.
        </p>
        <div class="banner__install">
          <span class="banner__install-label">Install Strands harness</span>
          <InstallCommand
            pip="pip install strands-harness"
            npm="npm i @strands-agents/harness"
            copyLabel="Copy Strands harness install command"
          />
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .banner {
    width: 100%;
    background: var(--bg);
  }

  .banner__inner {
    position: relative;
    max-width: 1442px;
    min-height: 520px;
    margin: 0 auto;
    overflow: hidden;
  }

  .banner__halftone {
    position: absolute;
    inset: 36px 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 40px;
    opacity: 0.48;
    pointer-events: none;
  }

  .banner__halftone-mask {
    display: block;
    width: 1332px;
    height: 750px;
    flex: none;
    background-color: var(--halftone-dot);
    transform: rotate(180deg);
    -webkit-mask-image: var(--halftone-mask);
    mask-image: var(--halftone-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    mask-mode: alpha;
  }

  .banner__gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        var(--bg) 0%,
        var(--bg) 44%,
        color-mix(in srgb, var(--bg) 94%, transparent) 61%,
        color-mix(in srgb, var(--bg) 42%, transparent) 80%,
        var(--bg) 100%
      ),
      linear-gradient(to bottom, transparent 34%, var(--bg) 100%);
    pointer-events: none;
  }

  .banner__content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(420px, 1fr);
    align-items: center;
    gap: 24px;
    width: calc(100% - 110px);
    max-width: 1332px;
    min-height: 520px;
    margin: 0 auto;
    padding: 76px 0 68px;
  }

  .banner__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .banner__eyebrow {
    margin: 0 0 18px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .banner__headline {
    max-width: 830px;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(38px, 4.15vw, 62px);
    font-weight: 600;
    line-height: 1.08;
    color: var(--banner-headline);
    letter-spacing: 0.025em;
    text-wrap: balance;
  }

  .banner__summary {
    max-width: 720px;
    margin: 24px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.5;
    color: var(--fg);
  }

  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .banner__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 11px 18px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    border: 1px solid var(--fg);
    border-radius: 999px;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .banner__action:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  .banner__action:focus-visible,
  .banner__explore:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 3px;
  }

  .banner__action--primary {
    background: var(--strands-green);
    border-color: var(--strands-green);
    color: var(--strands-black);
  }

  .banner__action--secondary {
    background: var(--toggle-bg);
    border-color: var(--toggle-inactive-border);
    color: var(--fg);
  }

  .banner__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .banner__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .banner__explore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 4px 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
    text-underline-offset: 4px;
  }

  .banner__explore-arrow {
    color: var(--accent-green);
    font-size: 17px;
    line-height: 1;
  }

  .banner__starter {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(24px, 3vw, 34px);
    background: color-mix(in srgb, var(--card-bg) 90%, transparent);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--accent-green) 30%, transparent);
    backdrop-filter: blur(8px);
  }

  .banner__starter-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--fg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .banner__starter-dot {
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--strands-green);
    border-radius: 50%;
  }

  .banner__starter-slug {
    margin-left: auto;
    color: var(--card-accent-orange);
    text-transform: none;
  }

  .banner__starter-title {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(23px, 2.2vw, 30px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
    text-wrap: balance;
  }

  .banner__starter-description {
    margin: 14px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg);
  }

  .banner__install {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
    margin-top: 24px;
  }

  .banner__install-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--toggle-inactive-fg);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .banner__install :global(.install) {
    width: 100%;
    gap: 6px;
    padding: 8px 7px 8px 12px;
  }

  .banner__install :global(.install__cmd) {
    gap: 7px;
    font-size: 12px;
  }

  .banner__install :global(.install__copy) {
    padding: 6px 10px;
    font-size: 12px;
  }

  @media (max-width: 1100px) {
    .banner__content {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .banner__starter {
      width: 100%;
      max-width: 720px;
    }
  }

  @media (max-width: 767px) {
    .banner__inner,
    .banner__content {
      min-height: 0;
    }

    .banner__halftone {
      inset: 22px 19px auto;
      height: 360px;
      border-radius: 18px;
      opacity: 0.18;
    }

    .banner__gradient {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 48%, transparent) 0%,
        var(--bg) 68%
      );
    }

    .banner__content {
      gap: 32px;
      width: calc(100% - 38px);
      padding: 54px 0 52px;
    }

    .banner__eyebrow {
      margin-bottom: 14px;
      font-size: 11px;
    }

    .banner__headline {
      max-width: 560px;
      font-size: clamp(32px, 10vw, 44px);
      letter-spacing: 0;
    }

    .banner__summary {
      margin-top: 18px;
      font-size: 16px;
      line-height: 1.45;
    }

    .banner__actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      margin-top: 24px;
    }

    .banner__action {
      width: 100%;
      font-size: 13px;
    }

    .banner__starter {
      padding: 22px;
      border-radius: 14px;
      box-shadow: 6px 6px 0 color-mix(in srgb, var(--accent-green) 30%, transparent);
    }

    .banner__starter-title {
      font-size: 22px;
    }

    .banner__starter-description {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner__action {
      transition: none;
    }

    .banner__action:hover {
      transform: none;
    }
  }
</style>
