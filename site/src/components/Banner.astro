---
import arrow from '../assets/banner/arrow.svg?raw'
import { homepageStartProjects } from '../config/homepage'
import InstallCommand from './InstallCommand.astro'

const [harness] = homepageStartProjects
if (!harness) throw new Error('Missing Harness homepage project')
---

<section class="banner" aria-labelledby="hero-title">
  <div class="banner__inner">
    <div class="banner__content">
      <h1 id="hero-title" class="banner__headline">
        <span>Build agents.</span>
        <span class="banner__headline-accent">Control every layer.</span>
      </h1>

      <p class="banner__intro">An open-source toolkit for building, running, and improving AI agents.</p>

      <div class="banner__conversion">
        <div class="banner__actions">
          <a href={harness.href} class="banner__cta banner__cta--primary">
            Build an agent
            <span class="banner__arrow" set:html={arrow} />
          </a>
          <a
            href={harness.product.repository}
            class="banner__cta banner__cta--secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
            <span class="banner__arrow" set:html={arrow} />
          </a>
        </div>
        <div class="banner__install">
          <InstallCommand pip="pip install strands-harness" npm="npm install @strands-agents/harness" />
        </div>
      </div>
    </div>

    <div class="banner__dots" aria-hidden="true"></div>
  </div>
</section>

<style>
  .banner {
    width: 100%;
    padding: 18px var(--home-gutter) 0;
    background: var(--bg);
    color: var(--fg);
  }

  .banner__inner {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: clamp(470px, 58vh, 600px);
    max-width: var(--home-content-width);
    margin: 0 auto;
    padding: clamp(42px, 5vw, 64px) 0;
    overflow: hidden;
  }

  .banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    text-align: center;
  }

  .banner__headline {
    display: flex;
    flex-direction: column;
    max-width: 1120px;
    margin: 0;
    font-family: var(--home-display-font);
    font-size: var(--home-hero-size);
    font-weight: 500;
    letter-spacing: var(--home-hero-tracking);
    line-height: var(--home-hero-line-height);
    color: var(--fg);
    text-wrap: balance;
  }

  .banner__headline-accent {
    color: var(--accent-green);
  }

  .banner__intro {
    max-width: 720px;
    margin: 22px 0 0;
    font-family: var(--home-body-font);
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    color: color-mix(in srgb, var(--fg) 74%, transparent);
  }

  .banner__conversion {
    position: relative;
    z-index: 1;
    display: inline-grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
    gap: 14px;
    width: fit-content;
    max-width: 100%;
    margin-top: 30px;
  }

  .banner__install {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .banner__install :global(.install) {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
  }

  .banner__actions {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0;
  }

  .banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    min-height: 50px;
    padding: 12px 22px;
    border: 1px solid color-mix(in srgb, var(--fg) 32%, transparent);
    border-radius: 999px;
    font-family: var(--home-control-font);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .banner__cta:hover {
    transform: translateY(-2px);
  }

  .banner__cta:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 4px;
  }

  .banner__cta--primary {
    border-color: var(--accent-green);
    background: var(--accent-green);
    color: var(--bg);
  }

  .banner__cta--primary:hover {
    background: color-mix(in srgb, var(--accent-green) 84%, var(--fg));
  }

  .banner__cta--secondary {
    background: transparent;
    color: var(--fg);
  }

  .banner__cta--secondary:hover {
    border-color: var(--accent-green);
    color: var(--accent-green);
  }

  .banner__arrow {
    display: inline-flex;
    width: 12px;
    height: 10px;
  }

  .banner__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .banner__dots {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    left: 0;
    width: 100%;
    height: 72%;
    background: radial-gradient(circle, var(--halftone-dot) 0 2.4px, transparent 2.9px) 0 0 / 18px 18px;
    opacity: 0.58;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 82%) 38%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 82%) 38%, transparent 100%);
  }

  :global(:root[data-theme='dark']) .banner__dots {
    opacity: 0.3;
  }

  @media (max-width: 767px) {
    .banner {
      padding: 14px var(--home-gutter) 0;
    }

    .banner__inner {
      min-height: 0;
      padding: 46px 0 42px;
    }

    .banner__content {
      width: 100%;
    }

    .banner__headline {
      font-size: var(--home-hero-size);
      letter-spacing: var(--home-hero-tracking);
      line-height: var(--home-hero-line-height);
    }

    .banner__intro {
      max-width: 36rem;
      margin-top: 18px;
      font-size: 16px;
    }

    .banner__conversion {
      gap: 12px;
      width: 100%;
      max-width: 405px;
      margin-top: 24px;
    }

    .banner__actions {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }

    .banner__dots {
      top: 0;
      right: 0;
      left: 0;
      width: 100%;
      height: 220px;
      background-size: 14px 14px;
      opacity: 0.5;
      -webkit-mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 78%) 40%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 78%) 40%, transparent 100%);
    }

    :global(:root[data-theme='dark']) .banner__dots {
      opacity: 0.28;
    }
  }

  @media (max-width: 360px) {
    .banner__inner {
      padding: 30px 0 28px;
    }

    .banner__intro {
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.45;
    }

    .banner__cta {
      padding-inline: 10px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner__cta {
      transition: none;
    }

    .banner__cta:hover {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .banner__dots {
      display: none;
    }
  }
</style>
