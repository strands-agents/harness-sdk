---
import arrow from '../assets/banner/arrow.svg?raw';
import halftone from '../assets/banner/halftone.svg?url';
import CodeExample from './CodeExample.astro';
import InstallCommand from './InstallCommand.astro';
import { homepageProductGroups } from '../config/navbar';
import { highlightHomepageCode } from '../util/homepage-highlighter';
import { pathWithBase } from '../util/links';

const harnessProduct = homepageProductGroups.foundation.harness;

const harnessExamples = await Promise.all([
  {
    language: 'Python',
    syntax: 'python',
    code: `from strands_harness import create_harness
agent = create_harness()
agent("Summarize this repository")`,
  },
  {
    language: 'TypeScript',
    syntax: 'typescript',
    code: `import { createHarness } from '@strands-agents/harness'
const agent = await createHarness()
await agent.invoke('Summarize this repository')`,
  },
].map(async (example) => ({
  ...example,
  highlightedCode: await highlightHomepageCode(example.code, example.syntax),
})));
---

<section class="banner" aria-labelledby="homepage-hero-title">
  <div class="banner__inner">
    <div class="banner__halftone" aria-hidden="true">
      <div class="banner__halftone-mask" style={`--halftone-mask: url("${halftone}")`} />
    </div>
    <div class="banner__gradient" aria-hidden="true" />

    <div class="banner__content">
      <h1 id="homepage-hero-title" class="banner__headline">Build AI agents.</h1>
      <p class="banner__summary">An open source framework for building production agents.</p>

      <div
        class="banner__start"
        style={`--accent: var(--card-accent-${harnessProduct.accent});`}
        data-example-container
      >
        <p class="banner__harness">{harnessProduct.slug}</p>

        <CodeExample
          id="harness-code-example"
          productName={harnessProduct.name}
          panes={harnessExamples}
          terminalLabel="TypeScript"
          copyLabel="Copy Strands harness code example"
          closedLabel="Code example"
          variant="hero"
          syncLanguage
        >
          <div slot="lead" class="banner__install">
            <InstallCommand
              pip="pip install strands-harness"
              npm="npm i @strands-agents/harness"
              copyLabel="Copy Strands harness install command"
            />
          </div>
          <a
            slot="action"
            href={pathWithBase('/docs/user-guide/harness/quickstart/')}
            class="banner__action banner__action--primary"
          >
            Quickstart
            <span class="banner__arrow" set:html={arrow} />
          </a>
        </CodeExample>
      </div>
    </div>
  </div>
</section>

<style>
  .banner {
    width: 100%;
    background: var(--bg);
  }

  .banner__inner {
    position: relative;
    max-width: 1442px;
    margin: 0 auto;
    overflow: hidden;
  }

  .banner__halftone {
    position: absolute;
    inset: 18px 34px 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    opacity: 0.42;
    pointer-events: none;
  }

  .banner__halftone-mask {
    display: block;
    width: 1332px;
    height: 750px;
    flex: none;
    background-color: var(--halftone-dot);
    transform: rotate(180deg);
    -webkit-mask-image: var(--halftone-mask);
    mask-image: var(--halftone-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    mask-mode: alpha;
  }

  .banner__gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 58% 54% at 50% 50%,
      var(--bg) 0%,
      var(--bg) 34%,
      color-mix(in srgb, var(--bg) 94%, transparent) 48%,
      color-mix(in srgb, var(--bg) 55%, transparent) 64%,
      transparent 82%
    );
    pointer-events: none;
  }

  .banner__content {
    position: relative;
    display: flex;
    width: calc(100% - 110px);
    max-width: 840px;
    margin: 0 auto;
    padding: 88px 0 112px;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .banner__headline {
    max-width: 760px;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(42px, 4.6vw, 64px);
    font-weight: 600;
    line-height: 1.06;
    color: var(--banner-headline);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .banner__summary {
    max-width: 820px;
    margin: 18px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.5;
    color: var(--fg);
    text-wrap: balance;
    white-space: nowrap;
  }

  .banner__harness {
    margin: 0 0 10px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(22px, 2.1vw, 28px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--accent);
  }

  .banner__start {
    width: 100%;
    max-width: 620px;
    margin-top: 20px;
  }

  .banner__install {
    width: 100%;
    max-width: 100%;
    margin: 0;
    text-align: left;
  }

  .banner__install :global(.install) {
    width: 100%;
  }

  .banner__install :global(.install__cmd) {
    font-size: 14px;
  }

  .banner__action {
    display: inline-flex;
    min-height: 44px;
    padding: 10px 17px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--fg);
    text-decoration: none;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .banner__action:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  .banner__action:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 3px;
  }

  .banner__action--primary {
    flex: none;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .banner__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .banner__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 767px) {
    .banner__halftone {
      inset: 12px 0 0;
      opacity: 0.3;
    }

    .banner__gradient {
      background: radial-gradient(
        ellipse 80% 54% at 50% 50%,
        var(--bg) 0%,
        var(--bg) 36%,
        color-mix(in srgb, var(--bg) 94%, transparent) 52%,
        color-mix(in srgb, var(--bg) 55%, transparent) 70%,
        transparent 94%
      );
    }

    .banner__content {
      width: calc(100% - 38px);
      padding: 58px 0 76px;
    }

    .banner__headline {
      font-size: clamp(36px, 11vw, 48px);
      letter-spacing: -0.045em;
    }

    .banner__summary {
      margin-top: 14px;
      font-size: 16px;
      line-height: 1.45;
      white-space: normal;
    }

    .banner__start {
      margin-top: 22px;
    }

    .banner__install {
      width: 100%;
      min-width: 0;
      margin-top: 0;
    }

    .banner__install :global(.install) {
      width: 100%;
      gap: 6px;
      padding: 8px 7px 8px 11px;
    }

    .banner__install :global(.install__cmd) {
      gap: 7px;
      font-size: 12px;
    }

    .banner__install :global(.install__copy) {
      padding: 6px 9px;
      font-size: 12px;
    }

    .banner__action {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner__action {
      transition: none;
    }

    .banner__action:hover {
      transform: none;
    }
  }
</style>
