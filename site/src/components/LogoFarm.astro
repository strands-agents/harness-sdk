---
import aws from '../assets/footer/aws.svg?raw';
import databricks from '../assets/logos/databricks.svg?raw';
import datadog from '../assets/logos/datadog.svg?raw';
import jefferies from '../assets/logos/jefferies.svg?raw';
import mrhTrowe from '../assets/logos/mrh-trowe.svg?raw';
import neo4j from '../assets/logos/neo4j.svg?raw';
import nttDocomo from '../assets/logos/ntt-docomo.svg?raw';
import thrad from '../assets/logos/thrad.svg?raw';

const logos = [
  {
    name: 'AWS',
    svg: aws,
    href: 'https://aws.amazon.com/',
  },
  {
    name: 'Jefferies',
    svg: jefferies,
    href: 'https://aws.amazon.com/blogs/machine-learning/building-trade-assistant-how-jefferies-optimized-front-office-trading-operations-with-ai/',
  },
  {
    name: 'Databricks',
    svg: databricks,
    href: 'https://docs.databricks.com/aws/en/mlflow3/genai/tracing/integrations/strands',
  },
  { name: 'Datadog', svg: datadog, href: 'https://www.datadoghq.com/blog/ai-guard-aws-strands-agents/' },
  { name: 'Neo4j', svg: neo4j, href: 'https://neo4j.com/labs/genai-ecosystem/strands-agents-neo4j/' },
  {
    name: 'Thrad',
    svg: thrad,
    href: 'https://aws.amazon.com/blogs/machine-learning/multi-agent-social-intelligence-with-strands-agents-and-amazon-bedrock/',
  },
  {
    name: 'NTT Docomo',
    svg: nttDocomo,
    href: 'https://press.aboutamazon.com/aws/2026/3/ntt-docomo-launches-commercial-5g-core-network-on-aws',
  },
  {
    name: 'MRH Trowe',
    svg: mrhTrowe,
    href: 'https://aws.amazon.com/blogs/machine-learning/how-mrh-trowe-enabled-secure-self-service-ai-agents-in-financial-services/',
  },
];
---

<section class="logo-farm" aria-label="Companies using Strands">
  <div class="logo-farm__inner">
    <p class="logo-farm__label">Build with</p>
    <div class="logo-farm__row">
      {logos.map((logo) => (
        <a
          class="logo-farm__cell"
          href={logo.href}
          target="_blank"
          rel="noopener noreferrer"
          data-logo={logo.name}
          aria-label={`${logo.name} (opens in a new tab)`}
        >
          <span class="logo-farm__logo" aria-hidden="true" set:html={logo.svg} />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .logo-farm {
    background: var(--bg);
    color: var(--fg);
    width: 100%;
    padding: var(--home-section-space-compact) var(--home-gutter) 0;
  }

  .logo-farm__inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: var(--home-content-width);
    padding-bottom: var(--home-section-space-compact);
    border-bottom: 1px solid var(--home-rule);
    margin: 0 auto;
  }

  .logo-farm__label {
    display: grid;
    grid-template-columns: minmax(24px, 1fr) auto minmax(24px, 1fr);
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    width: 100%;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 56%, transparent);
    text-align: center;
  }

  .logo-farm__label::before,
  .logo-farm__label::after {
    height: 1px;
    background: var(--home-rule);
    content: '';
  }

  .logo-farm__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px clamp(20px, 2.4vw, 36px);
  }

  .logo-farm__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 4px;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
  }

  .logo-farm__cell:hover .logo-farm__logo,
  .logo-farm__cell:focus-visible .logo-farm__logo {
    opacity: 1;
    transform: translateY(-1px);
  }

  .logo-farm__cell:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-farm__logo {
      transition: none;
    }

    .logo-farm__cell:hover .logo-farm__logo,
    .logo-farm__cell:focus-visible .logo-farm__logo {
      transform: none;
    }
  }

  .logo-farm__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    opacity: 0.72;
    transition:
      opacity 0.2s ease,
      transform 0.25s ease;
  }

  .logo-farm__logo :global(svg) {
    display: block;
    width: auto;
    height: 25px;
    max-width: 100%;
  }

  .logo-farm__cell[data-logo='AWS'] .logo-farm__logo :global(svg) {
    height: 30px;
  }

  .logo-farm__cell[data-logo='AWS'] .logo-farm__logo :global(path) {
    fill: currentColor;
  }

  /* Neo4j's lowercase wordmark with a descender reads small at the shared height. */
  .logo-farm__cell[data-logo='Neo4j'] :global(svg) {
    height: 31px;
  }

  /* The Bits mascot is taller than the wordmark, so the lockup needs more height to match. */
  .logo-farm__cell[data-logo='Datadog'] :global(svg) {
    height: 34px;
  }

  /* The small "NTT" above the wordmark takes up part of the height. */
  .logo-farm__cell[data-logo='NTT Docomo'] :global(svg) {
    height: 29px;
  }

  /* The "TROWE" line under "MRH" takes up part of the height. */
  .logo-farm__cell[data-logo='MRH Trowe'] :global(svg) {
    height: 31px;
  }

  @media (max-width: 1023px) {
    .logo-farm__row {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .logo-farm__inner {
      gap: 10px;
    }

    .logo-farm__label {
      gap: 10px;
      font-size: 9px;
    }

    .logo-farm__row {
      display: flex;
      justify-content: flex-start;
      flex-wrap: nowrap;
      gap: 18px;
      margin-inline: calc(-1 * var(--home-gutter));
      padding-inline: var(--home-gutter);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: thin;
    }

    .logo-farm__cell {
      flex: 0 0 auto;
      min-width: 88px;
      min-height: 44px;
    }

    .logo-farm__logo :global(svg) {
      height: 17px;
    }

    .logo-farm__cell[data-logo='AWS'] .logo-farm__logo :global(svg) {
      height: 20px;
    }

    .logo-farm__cell[data-logo='Neo4j'] :global(svg) {
      height: 22px;
    }

    .logo-farm__cell[data-logo='Datadog'] :global(svg) {
      height: 24px;
    }

    .logo-farm__cell[data-logo='NTT Docomo'] :global(svg) {
      height: 19px;
    }

    .logo-farm__cell[data-logo='MRH Trowe'] :global(svg) {
      height: 22px;
    }

  }
</style>
