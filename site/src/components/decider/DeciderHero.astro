---
import arrow from '../../assets/banner/arrow.svg?raw'
import halftone from '../../assets/banner/halftone.svg?url'
import github from '../../assets/nav/github.svg?raw'
import {
  DECIDER_HERO_DESCRIPTION,
  DECIDER_HERO_META,
  DECIDER_HERO_TITLE,
  DECIDER_INSTALL_COMMAND,
  DECIDER_LINKS,
  DECIDER_REPOSITORY_URL,
} from '../../config/decider-landing'
import { pathWithBase } from '../../util/links'
import CommandPill from '../CommandPill.astro'
---

<section class="decider-hero" aria-labelledby="decider-hero-title">
  <div class="decider-hero__inner">
    <div class="decider-hero__halftone" aria-hidden="true">
      <div
        class="decider-hero__halftone-mask"
        style={`--decider-halftone-mask: url("${halftone}")`}
      />
    </div>
    <div class="decider-hero__gradient" aria-hidden="true"></div>

    <div class="decider-hero__content">
      <p class="decider-hero__product">/decider</p>
      <h1 id="decider-hero-title" class="decider-hero__title">{DECIDER_HERO_TITLE}</h1>
      <p class="decider-hero__subtitle">{DECIDER_HERO_DESCRIPTION}</p>
      <div class="decider-hero__actions">
        <CommandPill
          command={DECIDER_INSTALL_COMMAND}
          label="Copy the Decider install command"
          surface="install:decider"
        />

        <div class="decider-hero__links">
          <a href={pathWithBase(DECIDER_LINKS.quickstart)} class="decider-hero__link">
            Run Decider
            <span class="decider-hero__arrow" set:html={arrow} />
          </a>
          <a
            href={DECIDER_REPOSITORY_URL}
            class="decider-hero__link decider-hero__link--github"
            aria-label="View Strands Decider on GitHub"
            target="_blank"
            rel="noopener"
          >
            <span class="decider-hero__github-icon" set:html={github} />
            <span class="decider-hero__github-label">GitHub</span>
          </a>
        </div>

        <p class="decider-hero__meta">
          {
            DECIDER_HERO_META.map((item, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <span>{item}</span>
              </>
            ))
          }
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .decider-hero {
    --decider-red: var(--card-accent-red);
    --decider-button-fg: var(--strands-white);

    width: 100%;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
  }

  :global([data-theme='dark']) .decider-hero {
    --decider-button-fg: var(--strands-black);
  }

  .decider-hero__inner {
    position: relative;
    display: flex;
    min-height: 324px;
    align-items: center;
    overflow: hidden;
  }

  .decider-hero__halftone {
    position: absolute;
    inset: 24px 0 0;
    display: flex;
    height: auto;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 0.2;
    pointer-events: none;
  }

  .decider-hero__halftone-mask {
    display: block;
    width: 100%;
    min-width: 1332px;
    height: auto;
    aspect-ratio: 1332 / 750;
    flex: none;
    transform: rotate(180deg);
    background-color: var(--decider-red);
    -webkit-mask-image: var(--decider-halftone-mask);
    mask-image: var(--decider-halftone-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    mask-mode: alpha;
  }

  .decider-hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, var(--bg) 100%);
    pointer-events: none;
  }

  .decider-hero__content {
    position: relative;
    display: flex;
    width: 100%;
    max-width: 1332px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    padding: 69px clamp(24px, 5vw, 96px) 48px;
    text-align: center;
  }

  .decider-hero__product {
    margin: 0 0 14px;
    color: var(--decider-red);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .decider-hero__title {
    max-width: 1040px;
    margin: 0;
    color: var(--fg);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(30px, 3.25vw, 52px);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .decider-hero__subtitle {
    max-width: 760px;
    margin: 22px 0 0;
    color: var(--use-case-muted);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.5;
  }

  .decider-hero__actions {
    display: flex;
    width: min(820px, 100%);
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }

  .decider-hero__links {
    display: flex;
    width: min(405px, 100%);
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .decider-hero__link {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 15px;
    border: 1px solid var(--use-case-muted);
    border-radius: 999px;
    background: var(--toggle-bg);
    color: var(--fg);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
  }

  .decider-hero__link:hover {
    border-color: var(--fg);
  }

  .decider-hero__link--github {
    gap: 8px;
  }

  .decider-hero__github-icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
  }

  .decider-hero__github-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .decider-hero__github-label {
    font-size: 15px;
    opacity: 0.88;
  }

  .decider-hero__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .decider-hero__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .decider-hero :global(.command-pill) {
    box-sizing: border-box;
    width: fit-content;
    min-width: min(405px, 100%);
    max-width: 100%;
    background: var(--toggle-bg);
  }

  .decider-hero :global(.command-pill__prompt) {
    color: var(--decider-red);
  }

  .decider-hero :global(.command-pill__copy) {
    border-color: transparent;
    background: var(--decider-red);
    color: var(--decider-button-fg);
    font-weight: 600;
  }

  .decider-hero :global(.command-pill__copy:hover) {
    color: var(--decider-button-fg);
    box-shadow: inset 0 0 0 2px var(--decider-button-fg);
  }

  .decider-hero :global(.command-pill__copy.is-copied) {
    border-color: transparent;
    background: var(--decider-red);
    color: var(--decider-button-fg);
  }

  .decider-hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 10px;
    margin: 0;
    color: var(--use-case-muted);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    line-height: 1.45;
  }

  @media (max-width: 767px) {
    .decider-hero__inner {
      min-height: 0;
      padding: 36px 12px 24px;
    }

    .decider-hero__halftone {
      top: 12px;
      bottom: 0;
      height: auto;
      opacity: 0.16;
    }

    .decider-hero__content {
      padding: 0;
    }

    .decider-hero__product {
      margin-bottom: 10px;
      font-size: 12px;
    }

    .decider-hero__title {
      font-size: clamp(23px, 7.4vw, 38px);
      font-weight: 600;
      letter-spacing: 0.02em;
      line-height: 1.15;
    }

    .decider-hero__subtitle {
      max-width: 420px;
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.45;
    }

    .decider-hero__actions {
      width: 100%;
      gap: 12px;
      margin-top: 22px;
    }

    .decider-hero__links {
      width: 100%;
    }

    .decider-hero :global(.command-pill) {
      width: 100%;
      min-width: 0;
    }

    .decider-hero__link {
      font-size: 14px;
    }

    .decider-hero__meta {
      max-width: 340px;
    }
  }
</style>
