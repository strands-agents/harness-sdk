---
import arrow from '../assets/banner/arrow.svg?raw'
import { pathWithBase } from '../util/links'

const modules = [
  {
    slug: '/box',
    label: 'Strands Box',
    badge: 'Open source',
    accent: 'var(--card-accent-purple)',
    title: 'Contain the agent.',
    description:
      'Isolate the agent and set policy for files, programs, network requests, and MCP calls.',
    href: pathWithBase('/docs/user-guide/box/quickstart/'),
    cta: 'Explore Box',
  },
  {
    slug: '/decider',
    label: 'Strands Decider',
    badge: 'Labs',
    accent: 'var(--card-accent-blue)',
    title: 'Make faster decisions.',
    description:
      'Answer typed yes/no, choice, and score questions with calibrated confidence.',
    href: pathWithBase('/docs/labs/strands-decider/inference/'),
    cta: 'Explore Decider',
  },
  {
    slug: '/evals',
    label: 'Strands Evals',
    badge: 'Python',
    accent: 'var(--card-accent-pink)',
    title: 'Validate before deployment.',
    description:
      'Score outputs and trajectories, diagnose failures, and simulate users and tools.',
    href: pathWithBase('/docs/user-guide/evals-sdk/'),
    cta: 'Explore Evals',
  },
]
---

<section id="tools" class="toolkit" aria-labelledby="tools-title">
  <div class="toolkit__inner">
    <header class="toolkit__header">
      <p class="toolkit__eyebrow">Focused tools</p>
      <h2 id="tools-title" class="toolkit__title">Add only what you need.</h2>
    </header>

    <div class="toolkit__modules" role="list" aria-label="Focused Strands tools">
      {
        modules.map((module) => (
          <article class="module-card" role="listitem" style={`--accent: ${module.accent};`}>
            <div class="module-card__topline">
              <p class="module-card__slug">{module.slug}</p>
              <span class="module-card__badge">{module.badge}</span>
            </div>

            <h3 class="module-card__title">{module.title}</h3>
            <p class="module-card__description">{module.description}</p>

            <a
              class="module-card__cta"
              href={module.href}
              aria-label={`${module.cta}: ${module.label}`}
            >
              {module.cta}
              <span class="module-card__arrow" set:html={arrow} />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .toolkit {
    padding: 56px 55px 88px;
    background: var(--bg);
    color: var(--fg);
    scroll-margin-top: var(--sl-nav-height, 84px);
  }

  .toolkit__inner {
    max-width: 1332px;
    margin: 0 auto;
  }

  .toolkit__header {
    margin-bottom: 26px;
  }

  .toolkit__eyebrow {
    margin: 0 0 10px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .toolkit__title {
    margin: 0;
    max-width: 760px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 500;
    line-height: 1.06;
    color: var(--fg);
    letter-spacing: -0.04em;
  }

  .module-card__slug {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
  }

  .module-card__badge {
    display: inline-flex;
    min-height: 24px;
    padding: 3px 8px;
    align-items: center;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .module-card__cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .module-card__cta:hover {
    opacity: 0.78;
  }

  .module-card__cta:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .module-card__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .module-card__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .toolkit__modules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 14px;
  }

  .module-card {
    position: relative;
    display: flex;
    min-height: 205px;
    overflow: hidden;
    padding: 16px 17px 17px 20px;
    flex-direction: column;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--accent) 6%, transparent),
        transparent 42%
      ),
      var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
  }

  .module-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
  }

  .module-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .module-card__slug {
    font-size: 14px;
    line-height: 1.3;
    color: var(--accent);
  }

  .module-card__badge {
    border-color: var(--accent);
  }

  .module-card__title {
    margin: 18px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.12;
    color: var(--fg);
    letter-spacing: -0.025em;
  }

  .module-card__description {
    margin: 8px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.42;
    color: var(--fg);
  }

  .module-card__cta {
    margin-top: auto;
    padding-top: 15px;
    font-size: 12px;
    color: var(--fg);
  }

  @media (max-width: 767px) {
    .toolkit {
      padding: 46px 19px 64px;
    }

    .toolkit__header {
      margin-bottom: 22px;
    }

    .toolkit__eyebrow {
      margin-bottom: 12px;
      font-size: 10px;
    }

    .toolkit__title {
      font-size: clamp(31px, 9vw, 40px);
    }

    .toolkit__modules {
      grid-template-columns: 1fr;
    }

    .module-card {
      min-height: 210px;
      padding: 16px 16px 17px 20px;
    }

    .module-card__title {
      margin-top: 18px;
      font-size: 22px;
    }
  }

</style>
