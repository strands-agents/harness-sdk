<script>
  function setToggleState(card: HTMLElement, isOpen: boolean) {
    const toggle = card.querySelector<HTMLButtonElement>('[data-toggle]');
    const slug = `/${card.dataset.toolkitProduct}`;
    toggle?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    toggle?.setAttribute('aria-label', `${isOpen ? 'Hide' : 'Show'} ${slug} code example`);
  }

  // Expandable toolkit cards toggle `.is-open` and swap the code icon for a
  // `−` via CSS.
  function setCardOpen(card: HTMLElement, willOpen: boolean) {
    // Accordion: only one card open at a time, so the widened grid track
    // never has to accommodate two expanded cards.
    if (willOpen) {
      card.closest<HTMLElement>('.toolkit')?.querySelectorAll<HTMLElement>('.toolkit__card.is-open').forEach((open) => {
        if (open === card) return;
        open.classList.remove('is-open');
        setToggleState(open, false);
      });
    }
    card.classList.toggle('is-open', willOpen);
    setToggleState(card, willOpen);
  }

  document.querySelectorAll<HTMLElement>('.toolkit__card[data-expandable]').forEach((card) => {
    // The code button is the primary, keyboard-accessible control.
    card.querySelector<HTMLButtonElement>('[data-toggle]')?.addEventListener('click', () => {
      setCardOpen(card, !card.classList.contains('is-open'));
    });

    // The whole compact tile is also a click target. Links and buttons handle
    // their own clicks, so reading docs does not expand the card.
    card.querySelector<HTMLElement>('.toolkit__card-compact')?.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a, button')) return;
      setCardOpen(card, true);
    });
  });
</script>
