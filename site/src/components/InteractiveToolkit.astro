---
import {
  createShikiHighlighter,
  type CreateShikiHighlighterOptions,
} from '@astrojs/markdown-remark/shiki'

import arrow from '../assets/banner/arrow.svg?raw'
import plus from '../assets/toolkit/plus.svg?raw'
import { products } from '../config/navbar'

function getProduct(label: string) {
  const product = products.find((candidate) => candidate.label === label)
  if (!product) throw new Error(`Missing homepage product: ${label}`)
  return product
}

const dogwoodLanguage: NonNullable<CreateShikiHighlighterOptions['langs']>[number] = {
  name: 'dogwood',
  scopeName: 'source.dogwood',
  patterns: [
    {
      name: 'comment.line.double-slash.dogwood',
      begin: '//',
      end: '$',
    },
    {
      name: 'meta.annotation.dogwood',
      match: '@[A-Za-z_][A-Za-z0-9_]*',
    },
    {
      name: 'keyword.control.dogwood',
      match: '\\b(?:permit|forbid|when)\\b',
    },
    {
      name: 'support.type.dogwood',
      match: '\\bBox(?=::)',
    },
    {
      name: 'string.quoted.double.dogwood',
      begin: '"',
      end: '"',
      patterns: [
        {
          name: 'constant.character.escape.dogwood',
          match: '\\\\.',
        },
      ],
    },
  ],
}

const highlighter = await createShikiHighlighter({
  langs: [dogwoodLanguage],
  themes: {
    light: 'github-light-high-contrast',
    dark: 'github-dark-high-contrast',
  },
})

const moduleDefinitions = [
  {
    product: getProduct('Box'),
    category: 'Agent sandbox',
    title: 'Contain the agent.',
    description:
      'Isolate the agent and set policies for files, programs, network requests, and MCP tool calls.',
    cta: 'Explore Box',
    exampleLabel: 'Policy',
    syntax: 'dogwood',
    code: `@id("no_env")
@description("The .env file holds credentials the agent must not read.")
forbid (
  principal,
  action == Box::Action::"fs:read",
  resource
)
when {
  context.input.path == "~/project/.env"
};`,
  },
  {
    product: getProduct('Decider'),
    category: 'Decision model',
    title: 'Make focused decisions.',
    description:
      'Classify and route work with yes/no, choice, and score answers plus calibrated confidence.',
    cta: 'Explore Decider',
    exampleLabel: 'CLI',
    syntax: 'shellscript',
    code: String.raw`strands-decider ask \
  StrandsAgents/strands-decider-2B-qwen3.5-v1-2610 \
  --state "Help! My payouts have been failing for 3 days." \
  --choice "Which team should handle this?=billing,technical,sales"`,
  },
  {
    product: getProduct('Evals'),
    category: 'Evaluation toolkit',
    title: 'Find failures before deployment.',
    description:
      'Evaluate outputs and trajectories, diagnose failures, and simulate users and tools.',
    cta: 'Explore Evals',
    exampleLabel: 'Python',
    syntax: 'python',
    code: `from strands import Agent
from strands_evals import Case, Experiment, eval_task
from strands_evals.evaluators import OutputEvaluator

@eval_task()
def get_response():
    return Agent(callback_handler=None)

cases = [
    Case(
        name="capital",
        input="Capital of France?",
        expected_output="Paris",
    )
]
evaluator = OutputEvaluator(rubric="Score 1.0 if correct, else 0.0.")
report = Experiment(
    cases=cases,
    evaluators=[evaluator],
).run_evaluations(get_response)
report.display()`,
  },
]

const modules = await Promise.all(
  moduleDefinitions.map(async (module) => ({
    ...module,
    highlightedCode: await highlighter.codeToHtml(module.code, module.syntax, {
      defaultColor: false,
      attributes: { class: 'code-terminal__highlighted-code' },
    }),
  })),
)
---

<section id="tools" class="toolkit" aria-labelledby="tools-title">
  <div class="toolkit__inner">
    <header class="toolkit__header">
      <p class="section-eyebrow">Extend your agent</p>
      <h2 id="tools-title" class="toolkit__title">Add focused tools when you need them.</h2>
    </header>

    <div class="toolkit__modules" role="list" aria-label="Focused Strands tools">
      {
        modules.map((module) => {
          const exampleId = `${module.product.slug.slice(1)}-code-example`
          const accent = `var(--card-accent-${module.product.accent})`

          return (
            <article
              class="module-card"
              role="listitem"
              style={`--accent: ${accent};`}
              data-product-name={module.product.name}
              data-example-closed-label="View code"
              data-example-card
            >
              <div class="module-card__topline">
                <p class="module-card__slug">{module.product.slug}</p>
                <span class="product-category">{module.category}</span>
              </div>

              <h3 class="module-card__title">{module.title}</h3>
              <p class="module-card__description">{module.description}</p>

              <div class="card-actions card-actions--module">
                <a
                  class="card-action card-action--text"
                  href={module.product.href}
                  aria-label={`${module.cta}: ${module.product.name}`}
                >
                  {module.cta}
                  <span class="card-action__arrow" set:html={arrow} />
                </a>
                <button
                  type="button"
                  class="example-toggle example-toggle--compact"
                  aria-expanded="false"
                  aria-controls={exampleId}
                  aria-label={`View code example for ${module.product.name}`}
                  data-example-toggle
                >
                  <span data-example-toggle-label>View code</span>
                  <span class="example-toggle__icon" aria-hidden="true" set:html={plus} />
                </button>
              </div>

              <div id={exampleId} class="code-drawer" data-example-panel hidden>
                <div class="code-terminal" data-code-terminal>
                  <header class="code-terminal__header">
                    <span class="code-terminal__language">{module.exampleLabel}</span>
                    <button
                      type="button"
                      class="code-terminal__copy"
                      aria-label={`Copy ${module.product.name} code example`}
                      data-code-copy
                    >
                      <span role="status" aria-live="polite" data-code-copy-label>copy</span>
                    </button>
                  </header>
                  <div class="code-terminal__source" data-code-value={module.code}>
                    <Fragment set:html={module.highlightedCode} />
                  </div>
                </div>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  .toolkit {
    background: var(--bg);
    color: var(--fg);
  }

  .toolkit__inner {
    max-width: 1332px;
    margin: 0 auto;
  }

  .section-eyebrow {
    margin: 0 0 10px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .module-card {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--accent) 6%, transparent),
        transparent 42%
      ),
      var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
  }

  .module-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
  }

  .module-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .module-card__slug {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
  }

  .product-category {
    display: inline-flex;
    min-height: 24px;
    padding: 3px 9px;
    align-items: center;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid var(--accent);
    border-radius: 999px;
    white-space: nowrap;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .card-actions--module {
    margin-top: auto;
    padding-top: 16px;
    justify-content: space-between;
  }

  .card-action,
  .example-toggle {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
    line-height: 1.3;
  }

  .card-action {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    text-decoration: none;
  }

  .card-action:hover,
  .example-toggle:hover {
    opacity: 0.78;
  }

  .card-action:focus-visible,
  .example-toggle:focus-visible,
  .code-terminal__copy:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .card-action--text {
    font-size: 12px;
  }

  .card-action__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .card-action__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .example-toggle {
    display: inline-flex;
    min-height: 38px;
    padding: 8px 0;
    align-items: center;
    gap: 9px;
    background: transparent;
    border: 0;
    color: var(--fg);
    font-size: 12px;
    cursor: pointer;
  }

  .example-toggle--compact {
    min-height: 32px;
    padding: 5px 0;
    font-size: 11px;
  }

  .example-toggle__icon {
    position: relative;
    display: inline-flex;
    width: 13px;
    height: 13px;
    color: var(--accent);
  }

  .example-toggle__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .is-open .example-toggle__icon :global(svg) {
    display: none;
  }

  .is-open .example-toggle__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 13px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transform: translateY(-50%);
  }

  .code-drawer {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid color-mix(in srgb, var(--card-border) 70%, transparent);
    animation: reveal-code 0.2s ease both;
  }

  .code-drawer[hidden] {
    display: none;
  }

  @keyframes reveal-code {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .code-terminal {
    min-width: 0;
    overflow: hidden;
    background: var(--terminal-bg);
    border: 1px solid var(--toggle-inactive-border);
    border-radius: 8px;
  }

  .code-terminal__header {
    display: flex;
    min-height: 36px;
    padding: 8px 10px 8px 13px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--toggle-inactive-border);
  }

  .code-terminal__language,
  .code-terminal__copy {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }

  .code-terminal__language {
    color: var(--toggle-inactive-fg);
    text-transform: uppercase;
  }

  .code-terminal__copy {
    margin-left: auto;
    padding: 4px 7px;
    background: transparent;
    border: 0;
    color: var(--toggle-inactive-fg);
    cursor: pointer;
  }

  .code-terminal__copy.is-copied {
    color: var(--strands-green);
  }

  .code-terminal__source {
    margin: 0;
    min-width: 0;
    background: transparent;
  }

  .code-terminal__source :global(.astro-code) {
    margin: 0;
    padding: 15px 17px 17px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    line-height: 1.55;
    background: transparent;
    white-space: pre;
    tab-size: 2;
    color: var(--shiki-light);
  }

  .code-terminal__source :global(.astro-code span) {
    color: var(--shiki-light);
  }

  :global([data-theme='dark']) .code-terminal__source :global(.astro-code),
  :global([data-theme='dark']) .code-terminal__source :global(.astro-code span) {
    color: var(--shiki-dark);
  }

  .toolkit {
    padding: 84px 55px 88px;
    scroll-margin-top: var(--sl-nav-height, 84px);
  }

  .toolkit__header {
    margin-bottom: 24px;
  }

  .toolkit__title {
    width: 100%;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 500;
    line-height: 1.06;
    color: var(--fg);
    letter-spacing: -0.04em;
  }

  .toolkit__modules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 14px;
    transition: grid-template-columns 0.25s ease;
  }

  .module-card {
    display: flex;
    min-width: 0;
    min-height: 215px;
    padding: 16px 17px 16px 20px;
    flex-direction: column;
  }

  @media (min-width: 1120px) {
    .toolkit__modules:has(.module-card:nth-child(1).is-open) {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .toolkit__modules:has(.module-card:nth-child(2).is-open) {
      grid-template-columns: 1fr 2fr 1fr;
    }

    .toolkit__modules:has(.module-card:nth-child(3).is-open) {
      grid-template-columns: 1fr 1fr 2fr;
    }
  }

  .module-card__slug {
    font-size: 14px;
  }

  .module-card__title {
    margin: 16px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.12;
    color: var(--fg);
    letter-spacing: -0.025em;
  }

  .module-card__description {
    margin: 8px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.42;
    color: var(--fg);
  }

  @media (max-width: 1023px) {
    .toolkit__modules {
      grid-template-columns: 1fr;
    }

    .module-card {
      min-height: 0;
    }
  }

  @media (max-width: 767px) {
    .section-eyebrow {
      margin-bottom: 12px;
      font-size: 10px;
    }

    .card-actions--module {
      align-items: center;
      gap: 12px;
    }

    .code-terminal__source :global(.astro-code) {
      padding: 13px 14px 15px;
      font-size: 11px;
    }

    .toolkit {
      padding: 58px 19px 64px;
    }

    .toolkit__header {
      margin-bottom: 22px;
    }

    .toolkit__title {
      font-size: clamp(28px, 8vw, 36px);
    }

    .module-card {
      padding: 15px 15px 15px 19px;
    }

    .module-card__title {
      margin-top: 15px;
      font-size: 21px;
    }

    .product-category {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toolkit__modules {
      transition: none;
    }

    .code-drawer {
      animation: none;
    }
  }
</style>

<script>
  import { attachCopyButton } from '../util/clipboard'

  const toolkit = document.querySelector<HTMLElement>('.toolkit')

  function setExampleOpen(card: HTMLElement, willOpen: boolean) {
    card.classList.toggle('is-open', willOpen)

    const toggle = card.querySelector<HTMLButtonElement>('[data-example-toggle]')
    const panel = card.querySelector<HTMLElement>('[data-example-panel]')
    const label = toggle?.querySelector<HTMLElement>('[data-example-toggle-label]')

    toggle?.setAttribute('aria-expanded', willOpen ? 'true' : 'false')
    if (toggle) {
      const productName = card.dataset.productName ?? 'this product'
      toggle.setAttribute(
        'aria-label',
        `${willOpen ? 'Hide' : 'View'} code example for ${productName}`,
      )
    }
    if (panel) panel.hidden = !willOpen
    if (label) {
      label.textContent = willOpen
        ? 'Hide code'
        : (card.dataset.exampleClosedLabel ?? 'View code')
    }
  }

  toolkit?.querySelectorAll<HTMLElement>('[data-example-card]').forEach((card) => {
    card.querySelector<HTMLButtonElement>('[data-example-toggle]')?.addEventListener('click', () => {
      const willOpen = !card.classList.contains('is-open')
      if (willOpen) {
        toolkit.querySelectorAll<HTMLElement>('[data-example-card].is-open').forEach((openCard) => {
          if (openCard !== card) setExampleOpen(openCard, false)
        })
      }
      setExampleOpen(card, willOpen)
    })
  })

  toolkit?.querySelectorAll<HTMLElement>('[data-code-terminal]').forEach((terminal) => {
    const button = terminal.querySelector<HTMLButtonElement>('[data-code-copy]')
    if (!button) return

    attachCopyButton(button, {
      label: button.querySelector<HTMLElement>('[data-code-copy-label]'),
      getText: () => terminal.querySelector<HTMLElement>('[data-code-value]')?.dataset.codeValue ?? '',
      track: {
        surface: 'code:homepage',
        detail: () =>
          terminal.querySelector<HTMLElement>('.code-terminal__language')?.textContent?.trim(),
      },
    })
  })
</script>
