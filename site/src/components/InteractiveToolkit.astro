<script>
  import { attachCopyButton } from '../util/clipboard'
  import { LANGUAGE_STORAGE_KEY, DEFAULT_LANGUAGE_LABEL } from '../util/language-preference'

  // Expandable toolkit cards toggle `.is-open` and swap the `+` icon for a
  // `−` via CSS.
  function setCardOpen(card: HTMLElement, willOpen: boolean) {
    // Accordion: only one card open at a time, so the widened grid track
    // never has to accommodate two expanded cards.
    if (willOpen) {
      document.querySelectorAll<HTMLElement>('.toolkit__card.is-open').forEach((open) => {
        if (open === card) return;
        open.classList.remove('is-open');
        open
          .querySelector<HTMLButtonElement>('[data-toggle]')
          ?.setAttribute('aria-expanded', 'false');
      });
    }
    card.classList.toggle('is-open', willOpen);
    card
      .querySelector<HTMLButtonElement>('[data-toggle]')
      ?.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
  }

  document.querySelectorAll<HTMLElement>('.toolkit__card[data-expandable]').forEach((card) => {
    // The `+` button is the primary, keyboard-accessible control (it toggles).
    card.querySelector<HTMLButtonElement>('[data-toggle]')?.addEventListener('click', () => {
      setCardOpen(card, !card.classList.contains('is-open'));
    });

    // The `+` alone is easy to miss, so the whole compact tile is a click
    // target too. Links and buttons handle their own clicks, so reading docs
    // or copying an install command does not expand the card.
    card.querySelector<HTMLElement>('.toolkit__card-compact')?.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a, button')) return;
      setCardOpen(card, true);
    });
  });

  // Copy the expanded card's *visible* code panel.
  document
    .querySelectorAll<HTMLButtonElement>('.toolkit__card-terminal-copy')
    .forEach((btn) => {
      attachCopyButton(btn, {
        label: btn.querySelector<HTMLElement>('.toolkit__card-terminal-copy-label'),
        getText: () => {
          const code = btn
            .closest<HTMLElement>('.toolkit__card-terminal')
            ?.querySelector<HTMLElement>('.toolkit__card-terminal-code:not([hidden]) code');
          if (!code) return '';
          return Array.from(code.querySelectorAll<HTMLElement>('.toolkit__card-terminal-line'))
            .map((line) => line.textContent ?? '')
            .join('\n');
        },
        track: {
          surface: 'code:toolkit',
          detail: () =>
            btn
              .closest<HTMLElement>('.toolkit__card-terminal')
              ?.querySelector<HTMLElement>('.toolkit__card-terminal-code:not([hidden])')
              ?.dataset.langCode,
        },
      });
    });

  // Language switching: keep every toolkit card's terminal in sync with the
  // site-wide Python/TypeScript selector. Cards without a TS variant (only
  // /evals) show their Python panel plus a "Python-only" note when TS is
  // selected.

  function applyToolkitLang(lang: string) {
    const isPython = lang === 'Python';
    document
      .querySelectorAll<HTMLElement>('.toolkit__card-terminal')
      .forEach((term) => {
        const ts = term.querySelector<HTMLElement>('[data-lang-code="typescript"]');
        const py = term.querySelector<HTMLElement>('[data-lang-code="python"]');
        const note = term.querySelector<HTMLElement>('[data-python-only-note]');
        if (isPython) {
          if (ts) ts.hidden = true;
          if (py) py.hidden = false;
          if (note) note.hidden = true;
        } else if (ts) {
          // Card has a real TS variant.
          ts.hidden = false;
          if (py) py.hidden = true;
          if (note) note.hidden = true;
        } else {
          // Python-only card (e.g. /evals): keep Python visible, show note.
          if (py) py.hidden = false;
          if (note) note.hidden = false;
        }
      });
  }

  function currentLang() {
    try {
      return localStorage.getItem(LANGUAGE_STORAGE_KEY) === 'Python' ? 'Python' : DEFAULT_LANGUAGE_LABEL;
    } catch {
      return 'TypeScript';
    }
  }

  applyToolkitLang(currentLang());
  window.addEventListener('lang-change', (e: Event) => {
    applyToolkitLang((e as CustomEvent).detail);
  });
</script>
