---
import arrow from '../assets/banner/arrow.svg?raw'
import CodeExample from './CodeExample.astro'
import { homepageProductGroups } from '../config/navbar'
import { highlightHomepageCode } from '../util/homepage-highlighter'

const moduleContent: Record<
  string,
  {
    category: string
    title: string
    description: string
    cta: string
    exampleLabel: string
    syntax: string
    code: string
  }
> = {
  Box: {
    category: 'Agent sandbox',
    title: 'Contain the agent.',
    description:
      'Isolate the agent and set policies for files, programs, network requests, and MCP tool calls.',
    cta: 'Explore Box',
    exampleLabel: 'Policy',
    syntax: 'dogwood',
    code: `@id("no_env")
@description("The .env file holds credentials the agent must not read.")
forbid (
  principal,
  action == Box::Action::"fs:read",
  resource
)
when {
  context.input.path == "~/project/.env"
};`,
  },
  Decider: {
    category: 'Decision model',
    title: 'Make focused decisions.',
    description:
      'Classify and route work with yes/no, choice, and score answers plus calibrated confidence.',
    cta: 'Explore Decider',
    exampleLabel: 'CLI',
    syntax: 'shellscript',
    code: String.raw`strands-decider ask \
  StrandsAgents/strands-decider-2B-qwen3.5-v1-2610 \
  --state "Help! My payouts have been failing for 3 days." \
  --choice "Which team should handle this?=billing,technical,sales"`,
  },
  Evals: {
    category: 'Evaluation toolkit',
    title: 'Find failures before deployment.',
    description:
      'Evaluate outputs and trajectories, diagnose failures, and simulate users and tools.',
    cta: 'Explore Evals',
    exampleLabel: 'Python',
    syntax: 'python',
    code: `from strands import Agent
from strands_evals import Case, Experiment, eval_task
from strands_evals.evaluators import OutputEvaluator

@eval_task()
def get_response():
    return Agent(callback_handler=None)

cases = [
    Case(
        name="capital",
        input="Capital of France?",
        expected_output="Paris",
    )
]
evaluator = OutputEvaluator(rubric="Score 1.0 if correct, else 0.0.")
report = Experiment(
    cases=cases,
    evaluators=[evaluator],
).run_evaluations(get_response)
report.display()`,
  },
}

const modules = await Promise.all(
  homepageProductGroups.tools.map(async (product) => {
    const module = moduleContent[product.label]
    if (!module) throw new Error(`Missing homepage module content: ${product.label}`)
    return {
      ...module,
      product,
      highlightedCode: await highlightHomepageCode(module.code, module.syntax),
    }
  }),
)
---

<section id="tools" class="toolkit" aria-labelledby="tools-title">
  <div class="toolkit__inner">
    <header class="toolkit__header">
      <h2 id="tools-title" class="toolkit__title">Extend your agent.</h2>
    </header>

    <div class="toolkit__modules" role="list" aria-label="Focused Strands tools">
      {
        modules.map((module) => {
          const exampleId = `${module.product.slug.slice(1)}-code-example`
          const accent = `var(--card-accent-${module.product.accent})`

          return (
            <article
              class="module-card"
              role="listitem"
              style={`--accent: ${accent};`}
              data-example-container
            >
              <div class="module-card__topline">
                <p class="module-card__slug">{module.product.slug}</p>
                <span class="product-category">{module.category}</span>
              </div>

              <h3 class="module-card__title">{module.title}</h3>
              <p class="module-card__description">{module.description}</p>

              <CodeExample
                id={exampleId}
                productName={module.product.name}
                panes={[
                  {
                    code: module.code,
                    highlightedCode: module.highlightedCode,
                  },
                ]}
                terminalLabel={module.exampleLabel}
                copyLabel={`Copy ${module.product.name} code example`}
                closedLabel="View code"
                accordionGroup="homepage-tools"
              >
                <a
                  slot="action"
                  class="card-action card-action--text"
                  href={module.product.href}
                  aria-label={`${module.cta}: ${module.product.name}`}
                >
                  {module.cta}
                  <span class="card-action__arrow" set:html={arrow} />
                </a>
              </CodeExample>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  .toolkit {
    background: var(--bg);
    color: var(--fg);
  }

  .toolkit__inner {
    max-width: 1332px;
    margin: 0 auto;
  }

  .module-card {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--accent) 6%, transparent),
        transparent 42%
      ),
      var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
  }

  .module-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
  }

  .module-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .module-card__slug {
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
  }

  .product-category {
    display: inline-flex;
    min-height: 24px;
    padding: 3px 9px;
    align-items: center;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid var(--accent);
    border-radius: 999px;
    white-space: nowrap;
  }

  .card-action {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    text-decoration: none;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
    line-height: 1.3;
  }

  .card-action:hover {
    opacity: 0.78;
  }

  .card-action:focus-visible {
    outline: 3px solid var(--accent-green);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .card-action--text {
    font-size: 12px;
  }

  .card-action__arrow {
    display: inline-flex;
    width: 11px;
    height: 9px;
  }

  .card-action__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  .toolkit {
    padding: 84px 55px 88px;
    scroll-margin-top: var(--sl-nav-height, 84px);
  }

  .toolkit__header {
    margin-bottom: 24px;
  }

  .toolkit__title {
    width: 100%;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 500;
    line-height: 1.06;
    color: var(--fg);
    letter-spacing: -0.04em;
  }

  .toolkit__modules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 14px;
    transition: grid-template-columns 0.25s ease;
  }

  .module-card {
    display: flex;
    min-width: 0;
    min-height: 215px;
    padding: 16px 17px 16px 20px;
    flex-direction: column;
  }

  @media (min-width: 1120px) {
    .toolkit__modules:has(.module-card:nth-child(1).is-open) {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .toolkit__modules:has(.module-card:nth-child(2).is-open) {
      grid-template-columns: 1fr 2fr 1fr;
    }

    .toolkit__modules:has(.module-card:nth-child(3).is-open) {
      grid-template-columns: 1fr 1fr 2fr;
    }
  }

  .module-card__slug {
    font-size: 14px;
  }

  .module-card__title {
    margin: 16px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.12;
    color: var(--fg);
    letter-spacing: -0.025em;
  }

  .module-card__description {
    margin: 8px 0 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.42;
    color: var(--fg);
  }

  @media (max-width: 1119px) {
    .toolkit__modules {
      grid-template-columns: 1fr;
    }

    .module-card {
      min-height: 0;
    }
  }

  @media (max-width: 767px) {
    .toolkit {
      padding: 58px 19px 64px;
    }

    .toolkit__header {
      margin-bottom: 22px;
    }

    .toolkit__title {
      font-size: clamp(28px, 8vw, 36px);
    }

    .module-card {
      padding: 15px 15px 15px 19px;
    }

    .module-card__title {
      margin-top: 15px;
      font-size: 21px;
    }

    .product-category {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toolkit__modules {
      transition: none;
    }
  }
</style>
