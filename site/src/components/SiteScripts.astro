---
/**
 * Web font loading, AWS Shortbread cookie consent, and Analytics WebSDK initialization.
 * Included by Head.astro (docs, blog, and changelog pages).
 */
---

<!-- Web fonts: preconnect + a direct stylesheet link, rather than a CSS @import in
     custom.css, which would chain the fetch (the font CSS request couldn't start until
     the bundled stylesheet was parsed). Render-blocking deliberately, to avoid FOUT. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap"
/>

<link rel="preconnect" href="https://prod.assets.shortbread.aws.dev" crossorigin />
<link rel="stylesheet" href="https://prod.assets.shortbread.aws.dev/shortbread.css" />
<script is:inline defer src="https://prod.assets.shortbread.aws.dev/shortbread.js"></script>
<script is:inline>
  /**
   * Shortbread Cookie Consent and AWS Analytics WebSDK Initialization
   * CRITICAL: Site must operate even if Shortbread is unavailable.
   */
  ;(function () {
    'use strict'

    function initShortbread() {
      // The /integrations drawer embeds pages with `?embed`. Consent is handled
      // by the top-level page, so skip the banner inside the iframe — otherwise
      // it renders over the drawer's content.
      if (new URLSearchParams(window.location.search).has('embed')) return

      const hostname = window.location.hostname
      const isLocal = hostname === 'localhost' || hostname === '127.0.0.1'
      const isCloudFrontPreview = hostname === 'd3ehv1nix5p99z.cloudfront.net'
      const isProduction = hostname.endsWith('.strandsagents.com') || hostname === 'strandsagents.com'

      const domain = isLocal || isCloudFrontPreview ? hostname : '.strandsagents.com'

      let webSdkStage, webSdkDomain
      if (isProduction) {
        webSdkStage = 'prod'
        webSdkDomain = 'https://d0.m.awsstatic.com'
      } else if (isLocal) {
        webSdkStage = 'alpha'
        webSdkDomain = 'https://da0.m.awsstatic.com'
      } else {
        webSdkStage = 'gamma'
        webSdkDomain = 'https://dg0.m.awsstatic.com'
      }

      if (typeof AWSCShortbread === 'undefined') {
        console.warn('Shortbread unavailable. Using essential cookies only.')
        return
      }

      try {
        const existingShortbreadEl = document.getElementById('awsccc-sb-ux-c')
        if (existingShortbreadEl) existingShortbreadEl.remove()

        const shortbread = AWSCShortbread({
          domain,
          registry: {
            GitHubRepoCache: { category: 'essential' },
          },
          language: AWSCShortbread.Locale?.getLocaleIdShortbread(
            AWSCShortbread.Locale.getCurrentLocale()
          ),
        })

        shortbread.checkForCookieConsent()
        window.strandsShortbread = shortbread

        document.addEventListener('click', function (e) {
          if (e.target.id === 'cookie-preferences') {
            e.preventDefault()
            shortbread.customizeCookies()
          }
        })

        loadWebSDK(webSdkStage, webSdkDomain)
      } catch (error) {
        console.error('Shortbread error:', error)
      }
    }

    function loadWebSDK(stage, sdkDomain) {
      try {
        const script = document.createElement('script')
        script.type = 'module'
        script.id = 'awsm-csa'
        script.src = sdkDomain + '/awsm-acslibs/1.0.0/bundle/slim/wsdk.js'
        script.setAttribute('data-awsm-csa-meta', JSON.stringify({ env: { stage } }))
        document.head.appendChild(script)
      } catch (error) {
        console.error('WebSDK loading error:', error)
      }
    }

    // shortbread.js loads with `defer`, so AWSCShortbread is not defined at parse time.
    // Deferred scripts are guaranteed to execute before DOMContentLoaded fires.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShortbread)
    } else {
      initShortbread()
    }
  })()
</script>

<!--
  Restyle the AWS Shortbread cookie consent UI to match the Strands site.
  Content, layout, and button behavior stay Shortbread's — these rules only
  change color, font, border, and radius so the banner and its Customize modal
  don't read as stock AWS console chrome.

  The selectors are intentionally broad (every `.awsccc-u-btn`, the shared
  `#awsccc-cb-c` container, the modal) so the same styling also covers the
  confirmation banner Shortbread shows after Accept/Decline and the Customize
  save flow — all of which reuse these same elements.

  Site tokens are theme-aware, so the banner follows the site's light/dark
  toggle. `!important` + the full ID chain are required to win over
  Shortbread's own stylesheet, which ships its own OS-preference dark mode.
-->
<style is:global>
  /* Banner surface (initial prompt + post-choice confirmation) */
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c #awsccc-cb-content,
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c.dark-mode-enabled #awsccc-cb-content {
    background: var(--nav-bg) !important;
    border-top: 1px solid var(--accent-green) !important;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.25) !important;
  }

  /* Title */
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c #awsccc-cb-title {
    color: var(--nav-fg) !important;
    font-family: 'JetBrains Mono', ui-monospace, monospace !important;
    letter-spacing: 0.5px;
  }

  /* Body copy */
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c #awsccc-cb-text,
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c #awsccc-cb-text span {
    color: color-mix(in srgb, var(--nav-fg) 78%, transparent) !important;
    font-family: 'Space Grotesk', system-ui, sans-serif !important;
  }

  /* Links (banner + modal) → brand green, was AWS blue */
  #awsccc-sb-ux-c #awsccc-sb-a a,
  #awsccc-sb-ux-c #awsccc-sb-a a > span,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-link,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-link span,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled a,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled a > span {
    color: var(--accent-green) !important;
  }

  /* Buttons — shared shape */
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn {
    font-family: 'JetBrains Mono', ui-monospace, monospace !important;
    border-radius: 6px !important;
  }

  /* Secondary / default buttons (Decline, Customize): outlined on the site bg */
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn-secondary,
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c.dark-mode-enabled .awsccc-u-btn-secondary {
    background-color: transparent !important;
    border: 1px solid var(--border) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn span,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn-secondary span {
    color: var(--nav-fg) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn:hover,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn-secondary:hover {
    background-color: color-mix(in srgb, var(--nav-fg) 10%, transparent) !important;
    border-color: var(--accent-green) !important;
  }

  /* Primary button (Accept): filled brand green, text = page bg for contrast */
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn.awsccc-u-btn-primary,
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c.dark-mode-enabled .awsccc-u-btn-primary {
    background-color: var(--accent-green) !important;
    border: 1px solid var(--accent-green) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn.awsccc-u-btn-primary span,
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cb-c.dark-mode-enabled .awsccc-u-btn-primary span {
    color: var(--nav-bg) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn.awsccc-u-btn-primary:hover {
    background-color: color-mix(in srgb, var(--accent-green) 85%, #000) !important;
    border-color: color-mix(in srgb, var(--accent-green) 85%, #000) !important;
  }

  /* Focus ring → brand green (was AWS cyan) */
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-btn:focus:before,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-cb-focused:before {
    box-shadow: 0 0 0 2px var(--accent-green) !important;
  }

  /* ---- Customize modal ---- */
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-modal,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled .awsccc-u-modal {
    background-color: var(--nav-bg) !important;
    border: 1px solid var(--border) !important;
    border-radius: 8px !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-modal-header,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled .awsccc-u-modal-header {
    background-color: transparent !important;
    border-bottom: 1px solid var(--border) !important;
    color: var(--nav-fg) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-modal-header h2 {
    color: var(--nav-fg) !important;
    font-family: 'JetBrains Mono', ui-monospace, monospace !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-modal-content,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled .awsccc-u-modal-content {
    color: var(--nav-fg) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-modal-footer,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled .awsccc-u-modal-footer {
    border-top: 1px solid var(--border) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-modal-backdrop,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled .awsccc-u-modal-backdrop {
    background-color: rgba(0, 0, 0, 0.6) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-cs-sec-container .awsccc-cs-s-title,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-cs-s-paragraph,
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-cb-text,
  #awsccc-sb-ux-c #awsccc-sb-a #awsccc-cs-info-container span,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled #awsccc-cs-l-container span {
    color: var(--nav-fg) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-cs-s-paragraph {
    font-family: 'Space Grotesk', system-ui, sans-serif !important;
  }
  /* Form controls → brand green active state (was AWS blue) */
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-cb-checkbox-active .awscc-u-cb-checkbox-rect {
    fill: var(--accent-green) !important;
    stroke: var(--accent-green) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-rg input:checked + .awsccc-u-rg-radio,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled input:checked + .awsccc-u-rg-radio {
    background-color: var(--accent-green) !important;
    border-color: var(--accent-green) !important;
  }
  #awsccc-sb-ux-c #awsccc-sb-a .awsccc-u-cl-c,
  #awsccc-sb-ux-c #awsccc-sb-a .dark-mode-enabled .awsccc-u-cl-c {
    border-color: var(--border) !important;
  }
</style>
