{
  "name": "@strands-agents/harness",
  "version": "0.0.1-development",
  "description": "Strands harness: a batteries-included agent in one call, built on the Strands Harness SDK",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./internal": {
      "types": "./dist/src/internal.d.ts",
      "default": "./dist/src/internal.js"
    }
  },
  "scripts": {
    "build": "tsc --project src/tsconfig.json",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean:dist && npm run build",
    "clean": "rm -rf dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integ": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "type-check": "tsc --noEmit --project src/tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run type-check && npm run test:coverage"
  },
  "keywords": [
    "agents",
    "ai",
    "typescript",
    "sdk",
    "strands",
    "harness"
  ],
  "author": "AWS",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strands-agents/harness-sdk.git",
    "directory": "harness-ts"
  },
  "bugs": {
    "url": "https://github.com/strands-agents/harness-sdk/issues"
  },
  "homepage": "https://github.com/strands-agents/harness-sdk#readme",
  "dependencies": {
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@pydantic/monty": "0.0.23",
    "@strands-agents/sdk": "^1.17.0",
    "cjs-module-lexer": "^2.2.1",
    "esbuild": "^0.28.2",
    "import-meta-resolve": "^4.2.0",
    "tsx": "^4.23.13",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@aws/bedrock-token-generator": "^1.1.0",
    "@google/genai": "^2.6.0",
    "openai": "^6.45.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@aws/bedrock-token-generator": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@aws/bedrock-token-generator": "^1.1.0",
    "@cedar-policy/cedar-wasm": "4.11.2",
    "@cedar-policy/mcp-schema-generator-wasm": "0.6.0",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.6.0",
    "@types/node": "^25.9.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "openai": "^6.45.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
