{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scenarios/**/*.ts", "benchmarks/**/*.ts"]
}
