    "actions": [
      "confirm the order number before anything else",
      "apologize once and move straight to the fix",
      "offer the two fastest options and let the customer choose",
      "check the account notes for earlier contacts",
      "state the policy in one sentence and link the full text",
      "escalate to a supervisor if the amount is above the limit",
      "summarize what was agreed at the end of the reply",
      "avoid promising a date that the carrier has not confirmed",
      "ask for a photo when the issue is visible damage",
      "keep the reply under five sentences unless asked for detail",
      "record the outcome in the case log",
      "thank the customer for their patience without repeating it",
      "explain what happens next and when",
      "use the customer's own words for the problem",
      "never ask for a full card number",
      "offer a callback if the fix takes more than a day",
      "confirm the delivery address in full",
      "mention the reference number in the first line",
      "check stock before suggesting a replacement",
      "close the case only after the customer confirms"
    ]
