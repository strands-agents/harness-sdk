{
  "$comment": "Model conformance: the cases every SDK runs against live models, and the provider and model pairs they run on. Edit here; each SDK's integration tests read this file (see shared/README.md).",
  "cases": {
    "tool-use": {
      "tools": true,
      "passes": "An agent turn that asks for a tool calls it and ends the turn normally."
    },
    "context-window": {
      "passes": "The model id resolves to a model info entry, and the model config reports that entry's context window."
    },
    "structured-output": {
      "tools": true,
      "passes": "An agent asked for structured output returns an object that matches the schema."
    },
    "max-output-tokens": {
      "requires": "limits.maxOutputTokens",
      "passes": "A turn that sets no output token limit is accepted, so the default taken from the model info is within the model's ceiling."
    },
    "forced-tool-choice": {
      "tools": true,
      "requires": "capabilities.forcedToolChoice",
      "equals": true,
      "passes": "A model call with a tool choice that forces a tool returns a tool use."
    },
    "forced-tool-choice-refused": {
      "tools": true,
      "requires": "capabilities.forcedToolChoice",
      "equals": false,
      "passes": "A model call with a tool choice that forces a tool is refused by the provider, with an error the SDK recognizes as forced tool choice not being supported."
    },
    "native-structured-output": {
      "requires": "capabilities.nativeStructuredOutput",
      "equals": true,
      "passes": "A model call that asks for native structured output, with no tool forced, returns text that is one JSON object matching the schema."
    },
    "prompt-caching": {
      "requires": "capabilities.promptCaching",
      "equals": "cachePoints",
      "passes": "With automatic caching on and a long system prompt, a later turn of a conversation reads input tokens that an earlier turn cached."
    },
    "server-side-summary": {
      "requires": "capabilities.serverSideSummary",
      "equals": true,
      "passes": "Summarizing a conversation returns a summary produced by the provider, and a later turn that replays it can answer from the summarized history."
    },
    "temporary-messages": {
      "requires": "capabilities.temporaryMessages",
      "equals": true,
      "passes": "Text injected into a turn as a temporary message is accepted by the provider and used in the answer."
    }
  },
