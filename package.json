{
  "name": "strands",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "bin": {
    "strands-dev": "strands-cli/bin/strands.js"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "node-gyp": "^12.4.0",
    "prettier": "^3.9.4"
  },
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --prefix strands-ts",
    "setup": "node strands-cli/scripts/setup-source.js",
    "test": "npm run test --prefix strands-ts",
    "test:coverage": "npm run test:coverage --prefix strands-ts",
    "test:all": "npm run test:all --prefix strands-ts",
    "test:all:coverage": "npm run test:all:coverage --prefix strands-ts",
    "test:integ": "npm run test:integ --prefix strands-ts",
    "test:integ:all": "npm run test:integ:all --prefix strands-ts",
    "test:integ:selective": "bash ./test-infra/scripts/run-selective-ts.sh",
    "test:browser:install": "npm run test:browser:install --prefix strands-ts",
    "test:package": "npm run test:package --prefix strands-ts",
    "lint": "npm run lint --prefix strands-ts",
    "lint:py": "sh .husky/lint-python.sh",
    "format": "npm run format --prefix strands-ts",
    "format:check": "npm run format:check --prefix strands-ts",
    "type-check": "npm run type-check --prefix strands-ts",
    "check": "npm run check --prefix strands-ts",
    "check:browser-bundle": "npm run check:browser-bundle --prefix strands-ts",
    "complexity": "node .github/scripts/pr-metrics/run-analysis.mjs",
    "complexity:setup": "npm ci --ignore-scripts --prefix .github/scripts/pr-metrics/tools && pip install -r .github/scripts/pr-metrics/tools/requirements.txt",
    "test:pr-metrics": "node --test .github/scripts/pr-metrics/pr-metrics.test.mjs"
  }
}
